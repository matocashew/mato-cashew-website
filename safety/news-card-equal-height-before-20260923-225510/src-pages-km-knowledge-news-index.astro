---
import PageLayout from "@layouts/PageLayout.astro";
import { newsService } from "@services/newsService";

const articles = await newsService.getAll("km");
---

<PageLayout
  title="ព័ត៌មាន និងព្រឹត្តិការណ៍ | Mato Cashew"
  description="ព័ត៌មានឧស្សាហកម្មស្វាយចន្ទីកម្ពុជា សិក្ខាសាលា ការបណ្តុះបណ្តាល និងព្រឹត្តិការណ៍ថ្មីៗ។"
  canonical="https://matocashew.com/km/knowledge/news"
  lang="km"
  hasKhmerAlternate={true}
  breadcrumbs={[
    { name: "ទំព័រដើម", url: "/km" },
    { name: "មជ្ឈមណ្ឌលចំណេះដឹង", url: "/km/knowledge" },
    { name: "ព័ត៌មាន និងព្រឹត្តិការណ៍", url: "/km/knowledge/news" },
  ]}
>
  <main class="container news-index" lang="km">
    <header class="news-index__header">
      <p class="news-index__eyebrow">មជ្ឈមណ្ឌលចំណេះដឹង</p>
      <h1>ព័ត៌មាន និងព្រឹត្តិការណ៍</h1>
      <p>
        ស្វែងយល់ពីព័ត៌មានឧស្សាហកម្មស្វាយចន្ទីកម្ពុជា
        សិក្ខាសាលា ការបណ្តុះបណ្តាល និងព្រឹត្តិការណ៍ថ្មីៗ។
      </p>
    </header>

    {
      articles.length === 0 ? (
        <p class="news-index__empty">
          ព័ត៌មាន និងព្រឹត្តិការណ៍នឹងមានផ្សាយក្នុងពេលឆាប់ៗនេះ។
        </p>
      ) : (
        <div class="news-index__grid">
          {articles.map((article) => (
            <article class="news-index__card">
              {article.data.heroImage && (
                <img
                  src={article.data.heroImage}
                  alt=""
                  loading="lazy"
                />
              )}
              <div class="news-index__card-body">
                <p class="news-index__category">
                  {article.data.category}
                </p>
                <h2>
                  <a href={`/km/knowledge/news/${article.slug}`}>
                    {article.data.title}
                  </a>
                </h2>
                <p>{article.data.excerpt}</p>
                <p class="news-index__source">
                  ប្រភព៖ {article.data.sourceName}
                </p>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </main>
</PageLayout>

<style>
  .news-index { padding-block: 7rem 5rem; }
  .news-index__header { max-width: 760px; margin-bottom: 2.5rem; }
  .news-index__eyebrow,
  .news-index__category { color: #467548; font-weight: 700; }
  .news-index__header h1 { margin-block: .5rem 1rem; }
  .news-index__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }
  .news-index__card {
    overflow: hidden;
    border: 1px solid #e2e8df;
    border-radius: 16px;
    background: #fff;
  }
  .news-index__card img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    background: #fff;
  }
  .news-index__card-body { padding: 1.5rem; }
  .news-index__card h2 { font-size: 1.3rem; }
  .news-index__card h2 a { color: inherit; }
  .news-index__source { font-size: .9rem; opacity: .75; }
  .news-index__empty { padding-block: 2rem; }
</style>