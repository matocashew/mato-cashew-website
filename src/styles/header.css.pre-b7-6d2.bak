/* =========================================================
   MATO CASHEW — HEADER
   ========================================================= */

/* =========================================================
   MATO CASHEW — HEADER
   ========================================================= */

.header {
    position: fixed;
    top: 0;
    left: 0;

    width: 100%;

    z-index: 1000;

    /*
       Transparent enough for Hero image to remain visible
       behind the header.
    */
    background: rgba(255, 255, 255, 0.78);

    /*
       Soft glass effect.
    */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    border-bottom: 1px solid rgba(255, 255, 255, 0.25);

    transition:
        background var(--duration-normal) var(--ease-default),
        box-shadow var(--duration-normal) var(--ease-default),
        border-color var(--duration-normal) var(--ease-default);
}


.header-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;

    height: 88px;
    min-height: 88px;

    transition:
        height var(--duration-normal) var(--ease-default),
        min-height var(--duration-normal) var(--ease-default);
}


/* =========================================================
   Mato Cashew Brand Lockup
   ========================================================= */

.logo {
    display: inline-flex;
    align-items: center;

    gap: 14px;

    flex-shrink: 0;

    text-decoration: none;
}


/* Brand Symbol */

.brand-symbol {
    display: block;

    width: auto;
    height: 72px;

    object-fit: contain;

    flex-shrink: 0;

    transition:
        height var(--duration-normal) var(--ease-default),
        transform var(--duration-normal) var(--ease-default);
}


.logo:hover .brand-symbol {
    transform: translateY(-1px) scale(1.02);
}


/* =========================================================
   Brand Signature
   ========================================================= */

.brand-signature {
    display: flex;
    flex-direction: column;
    align-items: center;

    width: max-content;

    line-height: 1;
}


/* Khmer Brand */

.brand-khmer {
    display: block;

    font-family: var(--font-kh);

    font-size: 28px;
    font-weight: 700;

    line-height: 1.25;

    color: var(--primary);

    white-space: nowrap;
}


/* Gold Divider
   Width automatically follows Khmer text
*/

.brand-divider {
    display: block;

    width: 100%;
    height: 2px;

    margin: 3px 0 5px;

    background: var(--secondary);

    border-radius: var(--radius-full);

    opacity: .95;
}


/* English Brand */

.brand-english {
    display: block;

    font-family: "Playfair Display", Georgia, serif;

    font-size: 15px;
    font-weight: 700;

    line-height: 1;

    letter-spacing: .18em;

    color: var(--primary);

    white-space: nowrap;
}


/* =========================================================
   Navigation
   ========================================================= */

.nav-menu {
    display: flex;
    align-items: center;

    gap: 32px;
}


.nav-menu a {
    position: relative;

    display: inline-flex;
    align-items: center;

    padding: 8px 0;

    font-size: 15px;
    font-weight: 600;

    line-height: 1.2;

    transition:
        color var(--duration-normal) var(--ease-default),
        transform var(--duration-normal) var(--ease-default);
}


.nav-menu a:hover {
    color: var(--primary);

    transform: translateY(-2px);
}


.nav-menu a.active {
    color: var(--primary);
}


/* Navigation underline */

.nav-menu a::after {
    content: "";

    position: absolute;

    left: 50%;
    bottom: 0;

    width: 0;
    height: 2px;

    background: var(--secondary);

    border-radius: var(--radius-full);

    transform: translateX(-50%);

    transition:
        width var(--duration-normal) var(--ease-default);
}


.nav-menu a:hover::after,
.nav-menu a.active::after {
    width: 60%;
}


/* =========================================================
   Mobile Menu Button
   ========================================================= */

.menu-toggle {
    display: none;

    padding: 4px;

    background: transparent;

    border: none;

    font-family: inherit;
    font-size: 30px;

    line-height: 1;

    color: var(--primary);

    cursor: pointer;
}


/* =========================================================
   Language Switcher
   ========================================================= */

.language-switcher {
    position: relative;

    margin-left: var(--space-4);

    padding: 0;

    min-height: auto;

    flex-shrink: 0;
}


.language-current {
    display: flex;
    align-items: center;

    gap: var(--space-2);

    min-width: 142px;
    min-height: 44px;

    padding: 9px 12px;

    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: var(--radius-sm);

    color: var(--text);

    font: inherit;

    cursor: pointer;

    transition:
        border-color var(--duration-fast) var(--ease-default),
        box-shadow var(--duration-fast) var(--ease-default),
        background var(--duration-fast) var(--ease-default);
}


.language-current:hover {
    border-color: var(--primary);

    box-shadow: 0 5px 16px rgba(13, 92, 58, .10);
}


.language-current img {
    width: 24px;
    height: 18px;

    object-fit: cover;

    border-radius: 2px;

    flex-shrink: 0;
}


.language-current span:first-of-type {
    flex: 1;

    text-align: left;

    font-weight: 600;
}


.arrow {
    font-size: .8rem;

    transition:
        transform var(--duration-fast) var(--ease-default);
}


.language-current[aria-expanded="true"] .arrow {
    transform: rotate(180deg);
}


/* =========================================================
   Language Dropdown
   ========================================================= */

.language-dropdown {
    position: absolute;

    top: calc(100% + 8px);
    right: 0;

    width: 180px;

    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: var(--radius-md);

    overflow: hidden;

    box-shadow: var(--shadow-md);

    display: none;

    z-index: 1001;

    transform-origin: top right;
}


.language-dropdown.open {
    display: block;

    animation: dropdown .18s ease;
}


.language-option {
    position: relative;

    width: 100%;

    display: flex;
    align-items: center;

    gap: .9rem;

    padding: .85rem 1rem;

    border: none;

    background: transparent;

    color: var(--text);

    cursor: pointer;

    font: inherit;

    transition:
        background var(--duration-fast) var(--ease-default),
        color var(--duration-fast) var(--ease-default);
}


.language-option img {
    width: 24px;
    height: 18px;

    object-fit: cover;

    border-radius: 2px;
}


.language-option:hover {
    background: rgba(13, 92, 58, .05);
}


.language-option.active {
    background: rgba(13, 92, 58, .08);

    color: var(--primary);

    font-weight: 700;
}


.check {
    margin-left: auto;

    color: var(--primary);

    font-size: .95rem;

    font-weight: 700;
}


/* =========================================================
   Scrolled Header
   ========================================================= */

.header.scrolled {
    background: rgba(255, 255, 255, .97);

    border-bottom-color: var(--border);

    box-shadow: var(--shadow-sm);
}


.header.scrolled .header-wrapper {
    height: 76px;
    min-height: 76px;
}


/* Scrolled Brand */

.header.scrolled .brand-symbol {
    height: 60px;
}


.header.scrolled .brand-khmer {
    font-size: 24px;
}


.header.scrolled .brand-divider {
    height: 2px;

    margin: 3px 0 4px;
}


.header.scrolled .brand-english {
    font-size: 13px;

    letter-spacing: .16em;
}


/* =========================================================
   Dropdown Animation
   ========================================================= */

@keyframes dropdown {

    from {
        opacity: 0;

        transform:
            scale(.96)
            translateY(-6px);
    }

    to {
        opacity: 1;

        transform:
            scale(1)
            translateY(0);
    }

}


/* =========================================================
   Tablet / Mobile
   ========================================================= */

@media (max-width: 768px) {

    .header {
        position: fixed;
        top: 0;
        left: 0;

        width: 100%;

        z-index: 1000;

        /* Let the About Hero image show softly behind header */
        background: rgba(255, 255, 255, 0.80);

        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);

        border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    }

    .header-wrapper {
        min-height: 78px;
    }

    /* Keep scrolled header clearer */
    .header.scrolled {
        background: rgba(255, 255, 255, 0.96);

        border-bottom-color: var(--border);
        box-shadow: var(--shadow-sm);
    }


    /* -----------------------------------------
       Mobile Brand
       ----------------------------------------- */

    .logo {
        gap: 10px;
    }


    .brand-symbol {
        height: 58px;
    }


    .brand-khmer {
        font-size: 20px;
    }


    .brand-divider {
        height: 2px;

        margin: 2px 0 4px;
    }


    .brand-english {
        font-size: 11px;

        letter-spacing: .14em;
    }


    /* -----------------------------------------
       Scrolled Mobile Brand
       ----------------------------------------- */

    .header.scrolled .header-wrapper {
        min-height: 72px;
    }


    .header.scrolled .brand-symbol {
        height: 52px;
    }


    .header.scrolled .brand-khmer {
        font-size: 18px;
    }


    .header.scrolled .brand-english {
        font-size: 10px;

        letter-spacing: .12em;
    }


    /* -----------------------------------------
       Mobile Navigation
       ----------------------------------------- */

    .menu-toggle {
        display: block;

        position: relative;

        z-index: 1002;
    }


    .nav-menu {
        position: absolute;

        top: 100%;
        left: 0;

        width: 100%;

        display: flex;
        flex-direction: column;
        align-items: center;

        gap: var(--space-6);

        padding: var(--space-7) 0;

        /* Glass menu instead of solid white */
        background: rgba(255, 255, 255, 0.78);

        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        border-top: 1px solid rgba(255, 255, 255, 0.30);
        border-bottom: 1px solid rgba(255, 255, 255, 0.28);

        box-shadow:
            0 12px 30px rgba(20, 39, 30, 0.10);

        opacity: 0;
        visibility: hidden;

        transform: translateY(-15px);

        transition:
            opacity var(--duration-normal) var(--ease-default),
            transform var(--duration-normal) var(--ease-default),
            visibility var(--duration-normal) var(--ease-default),
            background var(--duration-normal) var(--ease-default);
    }


    .nav-menu.open {
        opacity: 1;
        visibility: visible;

        transform: translateY(0);
    }


    .nav-menu a {
        font-size: 17px;
        color: var(--text);
        font-weight: 600;
    }

    .nav-menu a:hover,
    .nav-menu a.active {
        color: var(--primary);
    }


    /* -----------------------------------------
       Mobile Language
       ----------------------------------------- */

    .language-switcher {
        margin-left: auto;
    }


    .language-current {
        min-width: auto;

        padding: .6rem .75rem;
    }


    .language-dropdown {
        width: 170px;
    }

}


/* =========================================================
   Small Mobile
   ========================================================= */

@media (max-width: 576px) {

    .logo {
        gap: 8px;
    }


    .brand-symbol {
        height: 52px;
    }


    .brand-khmer {
        font-size: 18px;
    }


    .brand-english {
        font-size: 10px;

        letter-spacing: .12em;
    }


    .language-current {
        padding: 8px 10px;
    }

}


/* =========================================================
   Very Small Mobile
   ========================================================= */

@media (max-width: 420px) {

    .header-wrapper {
        min-height: 72px;
    }


    .brand-symbol {
        height: 46px;
    }


    .brand-khmer {
        font-size: 16px;
    }


    .brand-divider {
        margin: 2px 0 3px;
    }


    .brand-english {
        font-size: 9px;

        letter-spacing: .10em;
    }


    .language-current {
        min-height: 40px;

        padding: 7px 9px;
    }


    .language-current img {
        width: 21px;
        height: 16px;
    }

}


/* =========================================================
   Reduced Motion
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    .header,
    .header-wrapper,
    .brand-symbol,
    .nav-menu,
    .nav-menu a,
    .nav-menu a::after,
    .language-current,
    .arrow {
        transition: none;
    }


    .language-dropdown.open {
        animation: none;
    }

}

/* =========================================================
   PHASE 1 — HEADER FINAL RESPONSIVE POLISH
   ========================================================= */


/* ---------------------------------------------------------
   Tablet / Mobile
   --------------------------------------------------------- */

@media (max-width: 768px) {

    .header-wrapper {
        min-height: 74px;
        gap: 8px;
    }

    /* Brand lockup */

    .logo {
        gap: 8px;
        min-width: 0;
    }

    .brand-symbol {
        height: 52px;
    }

    .brand-signature {
        flex-shrink: 0;
    }

    .brand-khmer {
        font-size: 19px;
        line-height: 1.18;
    }

    .brand-divider {
        height: 2px;
        margin: 2px 0 3px;
    }

    .brand-english {
        font-size: 10px;
        line-height: 1;
        letter-spacing: .13em;
    }


    /* Mobile menu button */

    .menu-toggle {
        padding: 2px;
        font-size: 27px;
        flex-shrink: 0;
    }


    /* Language selector */

    .language-switcher {
        margin-left: auto;
    }

    .language-current {
        min-width: 112px;
        min-height: 40px;

        padding: 7px 9px;

        gap: 7px;

        border-radius: 10px;
    }

    .language-current img {
        width: 22px;
        height: 16px;
    }

    .language-current span:first-of-type {
        font-size: 14px;
    }


    /* Scrolled state */

    .header.scrolled .header-wrapper {
        min-height: 68px;
    }

    .header.scrolled .brand-symbol {
        height: 47px;
    }

    .header.scrolled .brand-khmer {
        font-size: 17px;
    }

    .header.scrolled .brand-english {
        font-size: 9px;
        letter-spacing: .11em;
    }
}


/* ---------------------------------------------------------
   Standard Mobile
   --------------------------------------------------------- */

@media (max-width: 576px) {

    .header-wrapper {
        min-height: 72px;
    }

    .logo {
        gap: 7px;
    }

    .brand-symbol {
        height: 50px;
    }

    .brand-khmer {
        font-size: 18px;
    }

    .brand-english {
        font-size: 9.5px;
        letter-spacing: .11em;
    }

    .language-current {
        min-width: 105px;
        min-height: 40px;

        padding: 7px 9px;
    }

    .language-current span:first-of-type {
        font-size: 13px;
    }

    .menu-toggle {
        font-size: 26px;
    }
}


/* ---------------------------------------------------------
   Small Mobile
   --------------------------------------------------------- */

@media (max-width: 420px) {

    .header-wrapper {
        min-height: 68px;
        gap: 5px;
    }

    .logo {
        gap: 5px;
    }

    .brand-symbol {
        height: 44px;
    }

    .brand-khmer {
        font-size: 16px;
    }

    .brand-divider {
        height: 1.5px;
        margin: 1px 0 2px;
    }

    .brand-english {
        font-size: 8px;
        letter-spacing: .09em;
    }

    .menu-toggle {
        font-size: 24px;
    }

    .language-current {
        min-width: auto;
        min-height: 38px;

        padding: 6px 8px;

        gap: 5px;
    }

    .language-current img {
        width: 20px;
        height: 15px;
    }

    .language-current span:first-of-type {
        font-size: 12px;
    }

    .arrow {
        font-size: .7rem;
    }
}

/* =========================================================
   MOBILE HEADER — HERO GLASS EFFECT
   ========================================================= */

@media (max-width: 768px) {

  .header {
    position: fixed;
    top: 0;
    left: 0;

    width: 100%;

    z-index: 1000;

    /* Let the About Hero image show softly behind header */
    background: rgba(255, 255, 255, 0.80);

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
  }

  .header-wrapper {
    min-height: 74px;
  }

  /* Keep scrolled header clearer */
  .header.scrolled {
    background: rgba(255, 255, 255, 0.96);

    border-bottom-color: var(--border);
    box-shadow: var(--shadow-sm);
  }

}
/* =========================================================
   ABOUT HERO — MOBILE GLASS HEADER FINAL OVERRIDE
   IMPORTANT: KEEP THIS AT THE VERY END OF Header.css
   ========================================================= */

@media (max-width: 768px) {

  .header {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;

    width: 100%;

    z-index: 1000;

    background: rgba(255, 255, 255, 0.62) !important;

    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);

    border-bottom: 1px solid rgba(255, 255, 255, 0.20);
  }

  .header-wrapper {
    height: 74px;
    min-height: 74px;
  }

  /* After scrolling, make header more solid */
  .header.scrolled {
    background: rgba(255, 255, 255, 0.92) !important;

    border-bottom-color: rgba(20, 39, 30, 0.08);
  }
}


@media (max-width: 420px) {

  .header-wrapper {
    height: 68px;
    min-height: 68px;
  }

}
/* =========================================================
   MATO CASHEW V2 — MOBILE PREMIUM GLASS ACCORDION
   Step 4C.3
   ========================================================= */

@media (max-width: 768px) {

  /*
   * Navigation container
   */

  .nav-menu {
    overflow-y: auto;
    overscroll-behavior: contain;
  }


  /*
   * Top-level navigation item
   */

  .nav-item {
    position: relative;
    width: 100%;
  }


  /*
   * Parent navigation row
   *
   * The main link remains clickable.
   * The chevron button controls only
   * the accordion submenu.
   */

  .has-submenu {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      auto;
    align-items: center;
  }

  .has-submenu > .nav-link {
    min-width: 0;
    width: 100%;
  }


  /*
   * Accordion toggle
   */

  .submenu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 42px;
    height: 42px;

    margin-right: 0.35rem;

    padding: 0;

    border:
      1px solid
      rgba(13, 92, 58, 0.10);

    border-radius: 13px;

    background:
      rgba(255, 255, 255, 0.48);

    color:
      var(--primary-dark);

    cursor: pointer;

    -webkit-tap-highlight-color:
      transparent;

    transition:
      background 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .submenu-toggle:hover,
  .submenu-toggle:focus-visible {
    background:
      rgba(255, 255, 255, 0.76);

    border-color:
      rgba(13, 92, 58, 0.18);

    box-shadow:
      0 7px 18px
      rgba(13, 92, 58, 0.08);

    outline: none;
  }


  /*
   * Chevron
   */

  .submenu-toggle
  .nav-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    font-size: 0.78rem;
    line-height: 1;

    opacity: 0.72;

    transform:
      rotate(0deg);

    transition:
      transform 220ms ease,
      opacity 180ms ease;
  }

  .has-submenu.submenu-open
  > .submenu-toggle
  .nav-chevron {
    opacity: 1;

    transform:
      rotate(180deg);
  }


  /*
   * Accordion panel
   *
   * Overrides the earlier mobile
   * display:none rule.
   */

  .has-submenu
  > .submenu-panel {
    display: block;

    grid-column:
      1 / -1;

    position: static;

    width: auto;

    max-height: 0;

    margin:
      0 0.35rem;

    padding:
      0;

    overflow: hidden;

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    border:
      1px solid
      transparent;

    border-radius:
      18px;

    background:
      transparent;

    box-shadow:
      none;

    transform:
      translateY(-4px);

    transition:
      max-height 320ms ease,
      margin 220ms ease,
      padding 220ms ease,
      opacity 180ms ease,
      visibility 180ms ease,
      transform 220ms ease,
      background 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }


  /*
   * Open state
   */

  .has-submenu.submenu-open
  > .submenu-panel {
    max-height:
      900px;

    margin:
      0.3rem 0.35rem
      0.65rem;

    padding:
      0.45rem;

    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    border-color:
      rgba(255, 255, 255, 0.78);

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.78),
        rgba(248, 246, 238, 0.64)
      );

    -webkit-backdrop-filter:
      blur(18px)
      saturate(145%);

    backdrop-filter:
      blur(18px)
      saturate(145%);

    box-shadow:
      0 14px 34px
      rgba(8, 69, 44, 0.10),
      inset 0 1px 0
      rgba(255, 255, 255, 0.72);

    transform:
      translateY(0);
  }


  /*
   * Remove desktop hover bridge
   * from mobile accordion.
   */

  .submenu-panel::before,
  .submenu-panel::after {
    display: none;
  }


  /*
   * Mega menu becomes a simple
   * mobile accordion surface.
   */

  .mega-menu,
  html[lang="km"] .mega-menu {
    width: auto;
  }

  .mega-menu-inner,
  html[lang="km"]
  .mega-menu-inner {
    padding: 0;
  }


  /*
   * Mega menu introduction
   */

  .mega-menu-intro {
    padding:
      0.55rem 0.65rem
      0.75rem;

    margin:
      0 0 0.35rem;

    border-bottom:
      1px solid
      rgba(13, 92, 58, 0.09);
  }

  .mega-menu-intro::after {
    display: none;
  }

  .mega-menu-eyebrow {
    margin-bottom:
      0.2rem;

    font-size:
      0.76rem;

    letter-spacing:
      0.06em;
  }

  .mega-menu-description {
    margin: 0;

    font-size:
      0.78rem;

    line-height:
      1.55;
  }


  /*
   * Mega menu child links
   */

  .mega-menu-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr);

    gap:
      0.3rem;
  }

  .mega-menu-link {
    min-height: auto;

    padding:
      0.72rem 0.8rem;

    border:
      1px solid
      rgba(13, 92, 58, 0.07);

    border-radius:
      13px;

    background:
      rgba(255, 255, 255, 0.48);

    box-shadow:
      none;

    transform:
      none;
  }

  .mega-menu-link:hover,
  .mega-menu-link.active {
    background:
      rgba(255, 255, 255, 0.82);

    border-color:
      rgba(13, 92, 58, 0.15);

    box-shadow:
      0 7px 18px
      rgba(13, 92, 58, 0.07);

    transform:
      none;
  }

  .mega-menu-link-title {
    padding-right:
      1.25rem;

    font-size:
      0.88rem;

    line-height:
      1.45;
  }

  .mega-menu-link-description {
    padding-right:
      1.25rem;

    font-size:
      0.75rem;

    line-height:
      1.5;
  }


  /*
   * Featured destination
   */

  .mega-menu-link.featured {
    background:
      linear-gradient(
        135deg,
        rgba(17, 108, 72, 0.96),
        rgba(7, 88, 58, 0.95)
      );

    border-color:
      rgba(206, 165, 70, 0.34);

    box-shadow:
      0 9px 22px
      rgba(8, 69, 44, 0.13);
  }


  /*
   * Compact dropdown
   */

  .dropdown-menu {
    width: auto;

    padding:
      0.4rem;
  }

  .dropdown-menu-list {
    display: grid;

    gap:
      0.25rem;
  }

  .dropdown-menu-link {
    min-height:
      42px;

    padding:
      0.65rem 0.75rem;

    border-radius:
      12px;
  }


  /*
   * Khmer mobile readability
   */

  html[lang="km"]
  .mega-menu-eyebrow {
    letter-spacing: 0;

    text-transform: none;

    font-size:
      0.84rem;
  }

  html[lang="km"]
  .mega-menu-description {
    font-size:
      0.82rem;

    line-height:
      1.8;
  }

  html[lang="km"]
  .mega-menu-link-title {
    font-size:
      0.86rem;

    line-height:
      1.75;
  }

  html[lang="km"]
  .mega-menu-link-description {
    font-size:
      0.76rem;

    line-height:
      1.8;
  }

  html[lang="km"]
  .dropdown-menu-link {
    line-height:
      1.7;
  }
}


/* =========================================================
   Very Small Mobile Refinement
   ========================================================= */

@media (max-width: 420px) {

  .submenu-toggle {
    width: 38px;
    height: 38px;

    margin-right:
      0.2rem;

    border-radius:
      11px;
  }

  .has-submenu
  > .submenu-panel {
    margin-left:
      0.2rem;

    margin-right:
      0.2rem;
  }

  .has-submenu.submenu-open
  > .submenu-panel {
    margin-left:
      0.2rem;

    margin-right:
      0.2rem;
  }

  .mega-menu-link {
    padding:
      0.65rem 0.7rem;
  }
}


/* =========================================================
   Mobile Accordion — Reduced Motion
   ========================================================= */

@media (
  max-width: 768px
) and (
  prefers-reduced-motion: reduce
) {

  .submenu-toggle,
  .submenu-toggle .nav-chevron,
  .submenu-panel,
  .mega-menu-link,
  .dropdown-menu-link {
    transition: none;
  }
}

/* =========================================================
   MATO MOBILE HEADER ? FINAL NORMALIZATION
   Single authoritative mobile sizing layer.
   Keep after earlier mobile header rules.
   ========================================================= */

@media (max-width: 768px) {

  .header-wrapper {
    height: auto;
    min-height: 76px;

    gap: 10px;
  }

  .logo {
    gap: 8px;
    min-width: 0;
  }

  .brand-symbol {
    height: 54px;
    width: auto;

    flex-shrink: 0;
  }

  .brand-signature {
    flex-shrink: 1;
    min-width: 0;
  }

  .brand-khmer {
    font-size: 19px;
    line-height: 1.15;

    white-space: nowrap;
  }

  .brand-divider {
    height: 2px;
    margin: 2px 0 3px;
  }

  .brand-english {
    font-size: 10px;
    line-height: 1;

    letter-spacing: .12em;
    white-space: nowrap;
  }

  .menu-toggle {
    flex: 0 0 auto;

    padding: 5px;

    font-size: 27px;
    line-height: 1;
  }

  .language-switcher {
    flex: 0 0 auto;
    margin-left: auto;
  }

  .language-current {
    min-width: 108px;
    min-height: 40px;

    padding: 7px 9px;

    gap: 6px;
  }

  .language-current img {
    width: 21px;
    height: auto;
  }

  .language-current span:first-of-type {
    font-size: 13px;
  }

  .nav-menu {
    width: 100%;

    align-items: stretch;

    gap: 0;

    padding:
      10px
      max(14px, env(safe-area-inset-right))
      18px
      max(14px, env(safe-area-inset-left));
  }

  .header.scrolled .header-wrapper {
    min-height: 70px;
  }

  .header.scrolled .brand-symbol {
    height: 49px;
  }

  .header.scrolled .brand-khmer {
    font-size: 17px;
  }

  .header.scrolled .brand-english {
    font-size: 9px;
  }
}


@media (max-width: 576px) {

  .header-wrapper {
    min-height: 72px;

    gap: 7px;
  }

  .brand-symbol {
    height: 49px;
  }

  .brand-khmer {
    font-size: 17px;
  }

  .brand-english {
    font-size: 9px;

    letter-spacing: .1em;
  }

  .language-current {
    min-width: 100px;

    padding: 6px 8px;
  }

  .language-current span:first-of-type {
    font-size: 12px;
  }

  .menu-toggle {
    font-size: 25px;
  }
}


@media (max-width: 420px) {

  .header-wrapper {
    height: auto;
    min-height: 68px;

    gap: 5px;
  }

  .logo {
    gap: 5px;
  }

  .brand-symbol {
    height: 44px;
  }

  .brand-khmer {
    font-size: 15px;
  }

  .brand-english {
    font-size: 7.5px;

    letter-spacing: .08em;
  }

  .language-current {
    min-width: auto;
    min-height: 36px;

    padding: 5px 7px;

    gap: 4px;
  }

  .language-current img {
    width: 19px;
  }

  .language-current span:first-of-type {
    font-size: 11px;
  }

  .menu-toggle {
    padding: 4px;

    font-size: 23px;
  }
}


@media (max-width: 360px) {

  .brand-signature {
    display: none;
  }

  .brand-symbol {
    height: 46px;
  }

  .language-current {
    min-width: auto;
  }
}

/* =========================================================
   MATO NAVIGATION V2 — DESKTOP INLINE SUBMENU TOGGLE
   Keep desktop parent label + chevron on one row.
   Mobile accordion styles remain unchanged.
   ========================================================= */

@media (min-width: 769px) {

  /* Parent link + submenu trigger share one row */
  .nav-link-row {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.18rem;

    min-height: 44px;

    white-space: nowrap;
  }


  /* Parent link no longer needs extra right spacing */
  .nav-link-row > .nav-link {
    display: inline-flex;
    align-items: center;

    min-height: 44px;

    padding-right: 0.15rem;
  }


  /* Desktop chevron behaves like a subtle inline control */
  .nav-link-row > .submenu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    width: 20px;
    height: 28px;

    margin: 0;
    padding: 0;

    border: 0;
    border-radius: 8px;

    background: transparent;

    color: currentColor;

    cursor: pointer;

    box-shadow: none;

    appearance: none;
    -webkit-appearance: none;

    transition:
      background 160ms ease,
      color 160ms ease;
  }


  .nav-link-row > .submenu-toggle:hover,
  .nav-link-row > .submenu-toggle:focus-visible {
    background:
      rgba(13, 92, 58, 0.07);

    color:
      var(--primary);

    outline: none;

    box-shadow: none;
  }


  /* Small premium chevron */
  .nav-link-row
  > .submenu-toggle
  .nav-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    font-size: 0.68rem;
    line-height: 1;

    opacity: 0.62;

    transform:
      translateY(-1px)
      rotate(0deg);

    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }


  /* Rotate when parent menu is active by hover/focus */
  .has-submenu:hover
  > .nav-link-row
  > .submenu-toggle
  .nav-chevron,

  .has-submenu:focus-within
  > .nav-link-row
  > .submenu-toggle
  .nav-chevron {
    opacity: 1;

    transform:
      translateY(-1px)
      rotate(180deg);
  }


  /* Keep active / hover styling across the whole parent row */
  .has-submenu:hover
  > .nav-link-row
  > .nav-link,

  .has-submenu:focus-within
  > .nav-link-row
  > .nav-link {
    color:
      var(--primary);
  }


  /* Khmer needs slightly more breathing room */
  html[lang="km"]
  .nav-link-row {
    gap: 0.12rem;
  }

  html[lang="km"]
  .nav-link-row
  > .submenu-toggle {
    width: 19px;
  }

}
/* =========================================================
   MATO CASHEW NAVIGATION V2
   FINAL DESKTOP PREMIUM MEGA MENU
   ========================================================= */

@media (min-width: 769px) {

  /* ---------------------------------------------------------
     TOP LEVEL NAVIGATION
     --------------------------------------------------------- */

  .nav-menu {
    display: flex;
    align-items: center;

    gap: 0.8rem;

    overflow: visible;
  }

  .nav-item {
    position: relative;

    display: flex;
    align-items: center;
  }

  .nav-link-row {
    display: inline-flex;
    align-items: center;

    gap: 0.22rem;

    min-height: 46px;

    white-space: nowrap;
  }


  /* ---------------------------------------------------------
     MAIN NAV LINK
     --------------------------------------------------------- */

  .nav-link-row > .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 44px;

    padding:
      0.6rem 0.2rem;

    border: 0;

    background: transparent;

    color: var(--text);

    text-decoration: none;

    box-shadow: none;

    font-weight: 700;

    transition:
      color 180ms ease;
  }

  .nav-link-row > .nav-link:hover,
  .nav-link-row > .nav-link.active,
  .nav-link-row > .nav-link:focus-visible {
    color:
      var(--primary);

    background: transparent;

    border: 0;

    box-shadow: none;

    text-decoration: none;

    outline: none;
  }


  /* Kill every legacy underline */
  .nav-link::before,
  .nav-link::after,
  .nav-item > a::before,
  .nav-item > a::after,
  .nav-link-row > a::before,
  .nav-link-row > a::after {
    content: none !important;
    display: none !important;
  }


  /* ---------------------------------------------------------
     INLINE CHEVRON
     --------------------------------------------------------- */

  .nav-link-row > .submenu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    width: 18px;
    height: 28px;

    margin: 0;
    padding: 0;

    border: 0;

    border-radius: 8px;

    background: transparent;

    color:
      rgba(22, 35, 29, 0.62);

    box-shadow: none;

    appearance: none;
    -webkit-appearance: none;

    cursor: pointer;

    transition:
      color 180ms ease,
      background 180ms ease;
  }

  .nav-link-row
  > .submenu-toggle
  .nav-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    font-size: 0.64rem;
    line-height: 1;

    opacity: 0.72;

    transform:
      translateY(-1px);

    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .has-submenu:hover
  > .nav-link-row
  > .submenu-toggle
  .nav-chevron,

  .has-submenu:focus-within
  > .nav-link-row
  > .submenu-toggle
  .nav-chevron {
    opacity: 1;

    transform:
      translateY(-1px)
      rotate(180deg);
  }


  /* ---------------------------------------------------------
     MEGA MENU PANEL
     --------------------------------------------------------- */

  .submenu-panel {
    position: absolute;

    top:
      calc(100% + 10px);

    z-index: 1500;

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transform:
      translateY(8px)
      scale(0.99);

    transform-origin:
      top center;

    border:
      1px solid
      rgba(255, 255, 255, 0.88);

    border-radius:
      24px;

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.97),
        rgba(249, 246, 239, 0.95)
      );

    backdrop-filter:
      blur(28px)
      saturate(145%);

    -webkit-backdrop-filter:
      blur(28px)
      saturate(145%);

    box-shadow:
      0 28px 70px
        rgba(8, 69, 44, 0.16),
      0 8px 24px
        rgba(15, 28, 21, 0.06);

    transition:
      opacity 180ms ease,
      visibility 180ms ease,
      transform 180ms ease;
  }

  .has-submenu:hover
  > .submenu-panel,

  .has-submenu:focus-within
  > .submenu-panel {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    transform:
      translateY(0)
      scale(1);
  }


  /* ---------------------------------------------------------
     MEGA MENU POSITION
     --------------------------------------------------------- */

  .mega-menu {
    left: 50%;

    width:
      min(
        680px,
        calc(100vw - 64px)
      );

    transform:
      translateX(-50%)
      translateY(8px)
      scale(0.99);
  }

  .has-submenu:hover
  > .mega-menu,

  .has-submenu:focus-within
  > .mega-menu {
    transform:
      translateX(-50%)
      translateY(0)
      scale(1);
  }

  .mega-menu-inner {
    padding:
      1.3rem;
  }


  /* ---------------------------------------------------------
     MEGA MENU HEADER
     --------------------------------------------------------- */

  .mega-menu-intro {
    padding:
      0.15rem 0.2rem
      1rem;

    margin-bottom:
      0.7rem;

    border-bottom:
      1px solid
      rgba(13, 92, 58, 0.10);
  }

  .mega-menu-eyebrow {
    display: block;

    margin-bottom:
      0.35rem;

    color:
      #07583a;

    font-size:
      0.83rem;

    font-weight:
      800;

    letter-spacing:
      0.05em;
  }

  .mega-menu-description {
    margin: 0;

    color:
      rgba(32, 43, 38, 0.68);

    font-size:
      0.88rem;

    line-height:
      1.6;
  }


  /* ---------------------------------------------------------
     MEGA MENU GRID
     --------------------------------------------------------- */

  .mega-menu-grid {
    display: grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      0.65rem;
  }


  /* ---------------------------------------------------------
     SUBMENU CARD
     --------------------------------------------------------- */

  .mega-menu-link {
    position: relative;

    display: flex;
    flex-direction: column;

    justify-content: center;

    min-height:
      82px;

color:
      inherit;

    text-decoration: none !important;

transform:
      none;

    transition:
      background 170ms ease,
      border-color 170ms ease,
      box-shadow 170ms ease,
      transform 170ms ease;
  }


  /* Remove every inherited line / pseudo line */
  .mega-menu-link::before {
    content: none !important;
    display: none !important;
  }

  .mega-menu-link::after {
    content: "›";

    position: absolute;

    right:
      0.9rem;

    top:
      50%;

    color:
      var(--primary);

    font-size:
      1.15rem;

    opacity: 0;

    transform:
      translate(
        -4px,
        -50%
      );

    transition:
      opacity 170ms ease,
      transform 170ms ease;
  }


  /* ---------------------------------------------------------
     SUBMENU TEXT — NO UNDERLINE
     --------------------------------------------------------- */

  .mega-menu-link-title,
  .mega-menu-link-description,
  .mega-menu-link-title::before,
  .mega-menu-link-title::after,
  .mega-menu-link-description::before,
  .mega-menu-link-description::after {
    text-decoration: none !important;

    border-bottom: 0 !important;

    box-shadow: none !important;
  }

  .mega-menu-link-title {
    padding-right:
      1.4rem;

    color:
      #07583a;

    font-size:
      0.93rem;

    font-weight:
      750;

    line-height:
      1.4;
  }

  .mega-menu-link-description {
    padding-right:
      1.4rem;

    color:
      rgba(40, 51, 46, 0.66);

    font-size:
      0.78rem;

    line-height:
      1.55;
  }


  /* ---------------------------------------------------------
     CARD HOVER
     --------------------------------------------------------- */

  .mega-menu-link:hover,
  .mega-menu-link:focus-visible,
  .mega-menu-link.active {
text-decoration: none !important;

    transform:
      translateY(-2px);

    outline: none;
  }

  .mega-menu-link:hover::after,
  .mega-menu-link:focus-visible::after,
  .mega-menu-link.active::after {
    opacity: 1;

    transform:
      translate(
        0,
        -50%
      );
  }


  /* ---------------------------------------------------------
     FEATURED CARD
     --------------------------------------------------------- */



  .mega-menu-link.featured
  .mega-menu-link-title {
    color:
      #ffffff;
  }

  .mega-menu-link.featured
  .mega-menu-link-description {
    color:
      rgba(255, 255, 255, 0.76);
  }

  .mega-menu-link.featured::after {
    color:
      #ffffff;
  }


  /* ---------------------------------------------------------
     COMPACT DROPDOWN
     --------------------------------------------------------- */

  .dropdown-menu {
    right: 0;

    width:
      260px;

    padding:
      0.55rem;

    border-radius:
      20px;
  }

  .dropdown-menu-list {
    display: grid;

    gap:
      0.22rem;

    margin: 0;

    padding: 0;

    list-style: none;
  }

  .dropdown-menu-link {
    display: flex;
    align-items: center;

    min-height:
      44px;

    padding:
      0.7rem 0.85rem;

    border:
      0;

    border-radius:
      12px;

    background:
      transparent;

    color:
      var(--primary-dark);

    text-decoration:
      none !important;

    box-shadow:
      none;

    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .dropdown-menu-link::before,
  .dropdown-menu-link::after {
    content:
      none !important;

    display:
      none !important;
  }

  .dropdown-menu-link:hover,
  .dropdown-menu-link:focus-visible,
  .dropdown-menu-link.active {
    background:
      rgba(13, 92, 58, 0.08);

    color:
      var(--primary);

    text-decoration:
      none !important;

    outline:
      none;
  }


  /* ---------------------------------------------------------
     GLOBAL SUBMENU UNDERLINE RESET
     --------------------------------------------------------- */

  .submenu-panel a,
  .submenu-panel a:hover,
  .submenu-panel a:focus,
  .submenu-panel a:focus-visible,
  .submenu-panel span {
    text-decoration:
      none !important;
  }


  /* ---------------------------------------------------------
     KHMER
     --------------------------------------------------------- */

  html[lang="km"]
  .mega-menu {
    width:
      min(
        760px,
        calc(100vw - 48px)
      );
  }

  html[lang="km"]
  .mega-menu-eyebrow {
    letter-spacing: 0;

    text-transform: none;

    font-size:
      0.9rem;
  }

  html[lang="km"]
  .mega-menu-description {
    line-height:
      1.85;
  }

  html[lang="km"]
  .mega-menu-link-title {
    font-size:
      0.9rem;

    line-height:
      1.75;
  }

  html[lang="km"]
  .mega-menu-link-description {
    font-size:
      0.78rem;

    line-height:
      1.85;
  }


  /* ---------------------------------------------------------
     CONSOLIDATED NO-PSEUDO + CARD SPACING
     Final protection against legacy lines / flicker.
     --------------------------------------------------------- */

  .mega-menu-link::before,
  .mega-menu-link::after,
  .mega-menu-link:hover::before,
  .mega-menu-link:hover::after,
  .mega-menu-link:focus::before,
  .mega-menu-link:focus::after,
  .mega-menu-link:focus-visible::before,
  .mega-menu-link:focus-visible::after,
  .mega-menu-link.active::before,
  .mega-menu-link.active::after,
  .mega-menu-link.featured::before,
  .mega-menu-link.featured::after {
    content: none !important;

    display: none !important;

    position: static !important;

    width: 0 !important;
    height: 0 !important;

    margin: 0 !important;
    padding: 0 !important;

    border: 0 !important;

    background: none !important;
    background-image: none !important;

    box-shadow: none !important;

    opacity: 0 !important;

    transform: none !important;

    transition: none !important;
    animation: none !important;

    pointer-events: none !important;
  }


  .mega-menu-link-title,
  .mega-menu-link-description,
  .mega-menu-link:hover
  .mega-menu-link-title,
  .mega-menu-link:hover
  .mega-menu-link-description,
  .mega-menu-link:focus-visible
  .mega-menu-link-title,
  .mega-menu-link:focus-visible
  .mega-menu-link-description {
    text-decoration: none !important;

    border: 0 !important;
    border-bottom: 0 !important;

    background-image: none !important;

    box-shadow: none !important;
  }


  .mega-menu-link:hover,
  .mega-menu-link:focus-visible {
    transform:
      translateY(-2px);

}


  /*
   * Legacy spacing preserved here so
   * visual output remains unchanged.
   * Final Balanced Glass V2 can still
   * override these values later.
   */

  .mega-menu-link {
    padding:
      0.95rem
      1.25rem !important;

    box-sizing:
      border-box;
  }

  .mega-menu-link-title {
    margin:
      0 0 0.35rem 0;

    padding:
      0 !important;

    line-height:
      1.25;
  }

  .mega-menu-link-description {
    margin:
      0;

    padding:
      0 !important;

    line-height:
      1.45;
  }

}
/* =========================================================
   MATO NAVIGATION V2 — UNIFIED SUBMENU VISUAL SYSTEM
   Mega menu + compact dropdown share one premium language
   ========================================================= */

/* =========================================================
   MATO MEGA MENU — LOCAL GLASS OCCLUSION
   Hide hero foreground ONLY behind the open glass panel.
   Background image remains untouched.
   ========================================================= */

@media (min-width: 769px) {

  .hero-content,
  .hero-trust,
  .home-stat-content {
    -webkit-mask-image: none;
    mask-image: none;
  }

  body.mega-menu-occlusion-active
  .hero-content,

  body.mega-menu-occlusion-active
  .hero-trust,

  body.mega-menu-occlusion-active
  .home-stat-content {

    /*
     * Layer 1:
     * keep the whole hero foreground visible.
     */
    -webkit-mask-image:
      linear-gradient(
        #000 0 0
      ),
      linear-gradient(
        #000 0 0
      );

    mask-image:
      linear-gradient(
        #000 0 0
      ),
      linear-gradient(
        #000 0 0
      );

    /*
     * First layer = complete element.
     * Second layer = exact Mega Menu rectangle.
     */
    -webkit-mask-size:
      100% 100%,
      calc(
        var(--menu-hole-right) -
        var(--menu-hole-left)
      )
      calc(
        var(--menu-hole-bottom) -
        var(--menu-hole-top)
      );

    mask-size:
      100% 100%,
      calc(
        var(--menu-hole-right) -
        var(--menu-hole-left)
      )
      calc(
        var(--menu-hole-bottom) -
        var(--menu-hole-top)
      );

    -webkit-mask-position:
      0 0,
      var(--menu-hole-left)
      var(--menu-hole-top);

    mask-position:
      0 0,
      var(--menu-hole-left)
      var(--menu-hole-top);

    -webkit-mask-repeat:
      no-repeat,
      no-repeat;

    mask-repeat:
      no-repeat,
      no-repeat;

    /*
     * Full element MINUS Mega Menu rectangle.
     */
    -webkit-mask-composite:
      xor;

    mask-composite:
      exclude;
  }
}
/* =========================================================
   MATO NAVIGATION V2 — FINAL BALANCED GLASS V2
   Clear text + stronger backdrop blur + light glass depth
   ========================================================= */

@media (min-width: 769px) {

  /* -------------------------------------------------------
     MAIN GLASS SURFACE
     This is where the real background blur should happen.
     ------------------------------------------------------- */

  .submenu-panel,
  .mega-menu {
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.20) 0%,
        rgba(248, 251, 249, 0.15) 48%,
        rgba(238, 246, 241, 0.18) 100%
      ) !important;

    border:
      1px solid
      rgba(255, 255, 255, 0.52) !important;

    -webkit-backdrop-filter:
      blur(54px)
      saturate(126%)
      brightness(1.025);

    backdrop-filter:
      blur(54px)
      saturate(126%)
      brightness(1.025);

    box-shadow:
      0 28px 66px
      rgba(15, 64, 43, 0.11),

      inset 0 1px 0
      rgba(255, 255, 255, 0.64),

      inset 0 -1px 0
      rgba(12, 68, 46, 0.05) !important;

    padding-bottom:
      24px !important;

    isolation: isolate;

    padding:
      18px 20px 20px !important;
  }


  /* -------------------------------------------------------
     INTERNAL GLASS CARDS
     Do not depend on a huge nested blur.
     Use a controlled translucent surface instead.
     ------------------------------------------------------- */

  .mega-menu-link,
  .mega-menu-link.featured {
    padding:
      19px 22px !important;

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.78) 0%,
        rgba(250, 253, 251, 0.66) 100%
      ) !important;

    border:
      1px solid
      rgba(255, 255, 255, 0.82) !important;

    -webkit-backdrop-filter:
      blur(14px)
      saturate(112%);

    backdrop-filter:
      blur(14px)
      saturate(112%);

    box-shadow:
      inset 0 1px 0
      rgba(255, 255, 255, 0.72),

      0 7px 18px
      rgba(10, 58, 38, 0.055) !important;

    border-radius:
      17px !important;
  }


  /* -------------------------------------------------------
     HEADER / INTRO TEXT
     ------------------------------------------------------- */

  .mega-menu-eyebrow {
    color:
      #075f3d !important;

    font-weight:
      800 !important;

    text-shadow:
      none !important;
  }

  .mega-menu-description {
    color:
      #354b40 !important;

    font-weight:
      540 !important;

    line-height:
      1.55 !important;

    text-shadow:
      none !important;
  }


  /* -------------------------------------------------------
     CARD TEXT
     ------------------------------------------------------- */

  .mega-menu-link-title {
    color:
      #05603d !important;

    font-weight:
      780 !important;

    line-height:
      1.4 !important;

    text-shadow:
      none !important;
  }

  .mega-menu-link-description {
    color:
      #263c32 !important;

    font-weight:
      560 !important;

    line-height:
      1.58 !important;

    text-shadow:
      none !important;
  }


  /* -------------------------------------------------------
     KHMER TYPOGRAPHY
     ------------------------------------------------------- */

  html[lang="km"]
  .mega-menu-link {
    padding:
      20px 23px !important;
  }

  html[lang="km"]
  .mega-menu-link-title {
    line-height:
      1.62 !important;
  }

  html[lang="km"]
  .mega-menu-link-description {
    line-height:
      1.76 !important;
  }

  html[lang="km"]
  .mega-menu-description {
    line-height:
      1.72 !important;
  }


  /* -------------------------------------------------------
     GRID
     ------------------------------------------------------- */

  .mega-menu-grid {
    gap:
      12px !important;
  }

  .mega-menu-grid
  > .mega-menu-link:last-child:nth-child(odd) {
    grid-column:
      1 / -1;
  }


  /* -------------------------------------------------------
     HOVER / FOCUS / ACTIVE
     Still glass — not a solid green block.
     ------------------------------------------------------- */

  .mega-menu-link:hover,
  .mega-menu-link:focus-visible,
  .mega-menu-link.active {
    background:
      linear-gradient(
        135deg,
        rgba(14, 108, 70, 0.64),
        rgba(6, 84, 54, 0.57)
      ) !important;

    border-color:
      rgba(255, 255, 255, 0.48) !important;

    -webkit-backdrop-filter:
      blur(12px)
      saturate(140%);

    backdrop-filter:
      blur(12px)
      saturate(140%);

    box-shadow:
      inset 0 1px 0
      rgba(255, 255, 255, 0.27),

      0 11px 25px
      rgba(5, 70, 46, 0.14) !important;
  }

  .mega-menu-link:hover
  .mega-menu-link-title,
  .mega-menu-link:focus-visible
  .mega-menu-link-title,
  .mega-menu-link.active
  .mega-menu-link-title {
    color:
      #ffffff !important;
  }

  .mega-menu-link:hover
  .mega-menu-link-description,
  .mega-menu-link:focus-visible
  .mega-menu-link-description,
  .mega-menu-link.active
  .mega-menu-link-description {
    color:
      rgba(255, 255, 255, 0.95) !important;
  }
}