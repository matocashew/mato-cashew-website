---
import { render } from "astro:content";

import "../../styles/page.css";
import "../../styles/resources.css";
import "../../styles/resource-detail.css";

import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ResourceMeta from "../../components/resources/ResourceMeta.astro";
import ResourcePageSchema from "../../components/seo/ResourcePageSchema.astro";

import {
  getResources,
} from "../../services/resourceService";

export async function getStaticPaths() {

  const resources =
    await getResources("en");

  return resources.map((resource) => ({

    params: {
      slug: resource.data.slug
    },

    props: {
      resource
    }

  }));

}

const {
  resource
} = Astro.props;

const {
  Content
} = await render(resource);

const canonical =
  `https://matocashew.com/resources/${resource.data.slug}`;

const khmerResources =
  await getResources("km");

const khmerTranslation =
  khmerResources.find(
    (candidate) =>
      candidate.data.translationKey ===
      resource.data.translationKey
  );

const englishLanguagePath =
  `/resources/${resource.data.slug}`;

const khmerLanguagePath =
  khmerTranslation
    ? `/km/resources/${khmerTranslation.data.slug}`
    : "/km/resources";
---

<ResourcePageSchema
  resource={resource}
  canonical={canonical}
  lang="en"
/>

<PageLayout
  title={`${resource.data.title} | Mato Cashew`}
  description={resource.data.description}
  canonical={canonical}
  ogType="article"
  breadcrumbs={[
    {
      name: "Home",
      url: "https://matocashew.com/"
    },
    {
      name: "Resources",
      url: "https://matocashew.com/resources"
    },
    {
      name: resource.data.title,
      url: canonical
    }
  ]}
>

  <div
  id="language-route-context"
  data-language-en={englishLanguagePath}
  data-language-km={khmerLanguagePath}
  hidden
></div>
<PageHero
    title={resource.data.title}
    description={resource.data.description}
  />

  <ResourceMeta
    category={resource.data.category}
    author={resource.data.author}
    publishDate={resource.data.publishDate}
    readingTime={resource.data.readingTime}
    tags={resource.data.tags}
    lang="en"
  />

  <section class="container">

    <article class="resource-content">

      <Content />

    </article>

  </section>

</PageLayout>
