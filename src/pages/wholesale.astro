---
import "../styles/page.css";
import "../styles/wholesale.css";

import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import Wholesale from "../components/Wholesale.astro";

import { getCurrentLanguage } from "../i18n/getCurrentLanguage";

const t = getCurrentLanguage(Astro.url.pathname);
---

<PageLayout
  title="Wholesale | Mato Cashew"
  description="Contact Mato Cashew to discuss Cambodian cashew products, quantities, packaging requirements, and available business options."
  canonical="https://matocashew.com/wholesale/"
  breadcrumbs={[
    {
      name: "Home",
      url: "https://matocashew.com/"
    },
    {
      name: "Wholesale",
      url: "https://matocashew.com/wholesale/"
    }
  ]}
>

  <PageHero
    title={t.nav.wholesale}
    description={t.wholesaleHome.description}
  />

  <Wholesale />

</PageLayout>