  canonical="https://matocashew.com/weather"
  englishAlternateUrl="https://matocashew.com/weather"
  khmerAlternateUrl="https://matocashew.com/km/weather"
  breadcrumbs={[
    {
      name: "Home",
      url: "https://matocashew.com/"
    },
    {
      name: "Cashew Weather",
      url: "https://matocashew.com/weather"
    }
  ]}
>

  <WeatherPage language="en" />

</PageLayout>
