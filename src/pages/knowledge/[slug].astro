---
import PageLayout from "@layouts/PageLayout.astro";
import knowledgeService from "@services/knowledgeService";

import KnowledgeHero from "@components/knowledge/KnowledgeHero.astro";
import KnowledgeMeta from "@components/knowledge/KnowledgeMeta.astro";
import KnowledgeTOC from "@components/knowledge/KnowledgeTOC.astro";
import KnowledgeNavigation from "@components/knowledge/KnowledgeNavigation.astro";
import ReadingProgress from "@components/knowledge/ReadingProgress.astro";
import RelatedArticles from "@components/knowledge/RelatedArticles.astro";
import TagGroup from "@components/ui/TagGroup.astro";
import ArticleSchema from "@components/seo/ArticleSchema.astro";

import { render } from "astro:content";

import "@styles/components/knowledge-content.css";
import "@styles/components/knowledge-toc.css";
import "@styles/components/related-articles.css";
import "@styles/components/info-box.css";
import "@styles/components/faq.css";
import "@styles/components/comparison-table.css";
import "@styles/components/article-link.css";
import "@styles/components/external-link.css";
import "@styles/components/related-topics.css";
import "@styles/components/knowledge-system.css";
import "@styles/components/quick-facts.css";


/* =========================================================
   STATIC PATHS
   ========================================================= */

export async function getStaticPaths() {
  const articles =
    await knowledgeService.getAll("en");

  const paths = await Promise.all(
    articles.map(async (article) => {
      const entry =
        await knowledgeService.getEntryBySlug(
        article.slug,
        "en"
      );

      return {
        params: {
          slug: article.slug,
        },

        props: {
          entry,
        },
      };
    })
  );

  return paths;
}


/* =========================================================
   PROPS
   ========================================================= */

interface Props {
  entry: Awaited<
    ReturnType<typeof knowledgeService.getEntryBySlug>
  >;
}

const { entry } = Astro.props as Props;


/* =========================================================
   CONTENT
   ========================================================= */

const { Content, headings } =
  await render(entry);

const articles =
  await knowledgeService.getAll("en");

/* =========================================================
   CURRENT ARTICLE
   ========================================================= */

const currentSlug =
  Astro.params.slug;

if (!currentSlug) {
  throw new Error(
    "Missing English Knowledge article slug."
  );
}

const translationKey =
  entry.data.translationKey;

/* =========================================================
   LANGUAGE PAIR ROUTES
   ========================================================= */

const khmerTranslation =
  await knowledgeService.getTranslation(
    translationKey,
    "km"
  );

const englishLanguagePath =
  `/knowledge/${currentSlug}/`;

const khmerLanguagePath =
  khmerTranslation
    ? `/km/knowledge/${khmerTranslation.slug}/`
    : "/km/knowledge/";


/* =========================================================
   SEO
   ========================================================= */

const canonical =
  `https://matocashew.com/knowledge/${currentSlug}/`;

const englishAlternateUrl =
  canonical;

const khmerAlternateUrl =
  khmerTranslation
    ? `https://matocashew.com/km/knowledge/${khmerTranslation.slug}/`
    : undefined;


/* =========================================================
   RELATED ARTICLES
   ========================================================= */

const relatedArticles = (() => {

  const related = articles.filter(
    (article) =>
      article.slug !== currentSlug &&
      (
        article.category === entry.data.category ||
        article.tags.some((tag) =>
          entry.data.tags.includes(tag)
        )
      )
  );

  if (related.length >= 2) {
    return related.slice(0, 2);
  }

  const fallback = articles.filter(
    (article) =>
      article.slug !== currentSlug &&
      !related.some(
        (item) =>
          item.slug === article.slug
      )
  );

  return [
    ...related,
    ...fallback,
  ].slice(0, 2);

})();


/* =========================================================
   PREVIOUS / NEXT
   ========================================================= */

const currentIndex =
  articles.findIndex(
    (article) =>
      article.slug === currentSlug
  );

const previous =
  currentIndex > 0
    ? articles[currentIndex - 1]
    : undefined;

const next =
  currentIndex < articles.length - 1
    ? articles[currentIndex + 1]
    : undefined;
---

<PageLayout
  title={`${entry.data.title} | Mato Cashew`}
  description={entry.data.description}
  canonical={canonical}
  lang="en"
  ogType="article"
  hasKhmerAlternate={Boolean(khmerTranslation)}
  englishAlternateUrl={englishAlternateUrl}
  khmerAlternateUrl={khmerAlternateUrl}
  breadcrumbs={[
    {
      name: "Home",
      url: "https://matocashew.com/"
    },
    {
      name: "Knowledge Center",
      url: "https://matocashew.com/knowledge/"
    },
    {
      name: entry.data.title,
      url: canonical
    }
  ]}
>

  <!-- =====================================================
       ARTICLE STRUCTURED DATA
       ===================================================== -->

  <ArticleSchema
    headline={entry.data.title}
    description={entry.data.description}
    image={entry.data.heroImage}
    datePublished={entry.data.publishedAt}
    author={entry.data.author}
    canonical={canonical}
  />


  <!-- =====================================================
       READING PROGRESS
       ===================================================== -->
  <div
    id="language-route-context"
    data-language-en={englishLanguagePath}
    data-language-km={khmerLanguagePath}
  hidden
  ></div>

  <ReadingProgress />


  <!-- =====================================================
       ARTICLE PAGE
       ===================================================== -->

  <div class="container knowledge-article-page">

    <!-- ARTICLE HERO -->

    <KnowledgeHero
      category={entry.data.category}
      title={entry.data.title}
      description={entry.data.description}
      heroImage={entry.data.heroImage}
    />


    <!-- ARTICLE META -->

    <KnowledgeMeta
      author={entry.data.author}
      publishedAt={entry.data.publishedAt}
      readingTime={entry.data.readingTime}
      lang="en"
    />


    <!-- TAGS -->

    <TagGroup
      tags={entry.data.tags}
      lang="en"
    />

    <hr />


    <!-- ===================================================
         ARTICLE CONTENT + TABLE OF CONTENTS
         =================================================== -->

    <article class="knowledge-layout">

      <aside>

        <KnowledgeTOC
          headings={headings}
          lang="en"
        />

      </aside>


      <div
        id="knowledge-content"
        class="knowledge-content"
        data-knowledge-content
      >

        <Content />

      </div>

    </article>


    <!-- ===================================================
         PREVIOUS / NEXT
         =================================================== -->

    <KnowledgeNavigation
      previous={previous}
      next={next}
      lang="en"
    />


    <!-- ===================================================
         RELATED ARTICLES
         =================================================== -->

    <RelatedArticles
      articles={relatedArticles}
      lang="en"
    />

  </div>

</PageLayout>