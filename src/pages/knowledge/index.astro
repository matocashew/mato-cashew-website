---
import PageLayout from "@layouts/PageLayout.astro";
import KnowledgeGrid from "@components/knowledge/KnowledgeGrid.astro";
import FeaturedKnowledgeCard from "@components/knowledge/FeaturedKnowledgeCard.astro";
import { knowledgeService } from "@services/knowledgeService";
import KnowledgeIndexHero from "@components/knowledge/KnowledgeIndexHero.astro";
import KnowledgeCategories from "@components/knowledge/KnowledgeCategories.astro";
import KnowledgeStats from "@components/knowledge/KnowledgeStats.astro";
import KnowledgeToolbar from "@components/knowledge/KnowledgeToolbar.astro";

import "@styles/components/knowledge-stats.css";
import "@styles/components/featured-knowledge-card.css";
import "@styles/components/knowledge-categories.css";
import "@styles/components/knowledge-index-hero.css";
import "@styles/components/knowledge-article-card.css";
import "@styles/components/knowledge-system.css";

const articles = await knowledgeService.getAll();

const featuredArticle =
  articles.find(article => article.featured);

const latestArticles =
  articles.filter(article => !article.featured);

const totalArticles = articles.length;

const totalCategories =
  new Set(
    articles.map(article => article.category)
  ).size;

const totalTags =
  new Set(
    articles.flatMap(article => article.tags)
  ).size;

const categories = [
  ...new Set(
    articles.map(article => article.category)
  )
];
const tags = [
  ...new Set(
    articles.flatMap(article => article.tags)
  )
].sort();
---

<PageLayout
  title="Knowledge | Mato Cashew"
  description="Explore practical knowledge about Cambodian cashews, including processing, grading, quality, food safety, packaging, storage, and export preparation."
  canonical="https://matocashew.com/knowledge/"
  lang="en"
  hasKhmerAlternate={false}
  breadcrumbs={[
    {
      name: "Home",
      url: "/"
    },
    {
      name: "Knowledge",
      url: "/knowledge/"
    }
  ]}
>
  <div class="container knowledge-index-page">
    <KnowledgeIndexHero />
    <KnowledgeToolbar totalArticles={latestArticles.length} />
    <KnowledgeStats
      articles={totalArticles}
      categories={totalCategories}
      tags={totalTags}
    />
    <KnowledgeCategories categories={categories} />

    <section class="knowledge-tags-filter">
      <h2>Browse by Tags</h2>

      <div
        id="knowledge-tag-filter"
        class="tag-filter-chips"
      >
        <button
          type="button"
          class="tag-filter-chip active"
          data-tag=""
          aria-pressed="true"
        >
          All
        </button>

        {
          tags.map((tag, index) => (
            <button
              type="button"
              class:list={[
                "tag-filter-chip",
                index >= 8 && "tag-filter-chip--extra"
              ]}
              data-tag={tag.toLowerCase()}
              aria-pressed="false"
            >
              #{tag}
            </button>
          ))
        }
      </div>

      <button
        id="knowledge-tags-toggle"
        class="knowledge-tags-toggle"
        type="button"
        aria-expanded="false"
      >
        Show More Tags
      </button>
    </section>

    <section id="featured-article-section">
      <h2 class="section-title">
        Featured Article
      </h2>

      {
        featuredArticle && (
          <FeaturedKnowledgeCard
            title={featuredArticle.title}
            description={featuredArticle.description}
            image={featuredArticle.heroImage}
            category={featuredArticle.category}
            tags={featuredArticle.tags}
            slug={featuredArticle.slug}
          />
        )
      }
    </section>

    <section class="knowledge-latest-section">
      <h2 class="section-title">
        Latest Articles
      </h2>

      <KnowledgeGrid
        articles={latestArticles}
      />
    </section>

    <!-- tags / featured / latest sections ដដែល -->
  </div>

  <script>
  import initKnowledge from "../../scripts/knowledge";

  document.addEventListener(
    "astro:page-load",
    initKnowledge
  );
</script>

</PageLayout>
