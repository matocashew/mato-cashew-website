---
import { render } from "astro:content";

import "../../../styles/page.css";
import "../../../styles/product-detail.css";
import "../../../styles/related-products.css";

import PageLayout from "../../../layouts/PageLayout.astro";
import PageHero from "../../../components/PageHero.astro";

import ProductDetails from "../../../components/products/ProductDetails.astro";
import ProductSpecificationsList from "../../../components/products/ProductSpecificationsList.astro";
import ProductApplications from "../../../components/products/ProductApplications.astro";
import RelatedProducts from "../../../components/products/RelatedProducts.astro";

import {
  getProducts,
  getRelatedProducts,
} from "../../../services/productService";


/* =========================================================
   STATIC PATHS
   ========================================================= */

export async function getStaticPaths() {

  const products = await getProducts();

  return products.map((product) => ({

    params: {
      slug: product.data.slug,
    },

    props: {
      product,
    },

  }));

}


/* =========================================================
   PRODUCT
   ========================================================= */

const { product } = Astro.props;

const { Content } = await render(product);


/* =========================================================
   KHMER DATA
   Khmer → fallback to English
   ========================================================= */

const productTitle =
  product.data.titleKm ??
  product.data.title;


const productDescription =
  product.data.descriptionKm ??
  product.data.description;


const productSpecifications =
  product.data.specificationsKm ??
  product.data.specifications;


const productApplications =
  product.data.applicationsKm ??
  product.data.applications;


/* =========================================================
   SEO
   ========================================================= */

const canonical =
  `https://matocashew.com/km/products/${product.data.slug}/`;


/* =========================================================
   RELATED PRODUCTS
   ========================================================= */

const relatedProducts =
  await getRelatedProducts(
    product.data.slug,
    3
  );
---

<PageLayout
  lang="km"

  title={`${productTitle} | ចន្ទីមាតុភូមិ`}

  description={productDescription}

  canonical={canonical}

  ogType="product"

  ogImage={
    product.data.image.startsWith("http")
      ? product.data.image
      : `https://matocashew.com${product.data.image}`
  }

  breadcrumbs={[
    {
      name: "ទំព័រដើម",
      url: "https://matocashew.com/km/"
    },
    {
      name: "ផលិតផល",
      url: "https://matocashew.com/km/products/"
    },
    {
      name: productTitle,
      url: canonical
    }
  ]}
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <PageHero
    title={productTitle}
    description={productDescription}
  />


  <!-- =====================================================
       PRODUCT DETAILS
       ===================================================== -->

  <ProductDetails
    product={product}
  />


  <!-- =====================================================
       SPECIFICATIONS
       ===================================================== -->

  <ProductSpecificationsList
    specifications={productSpecifications}
  />


  <!-- =====================================================
       APPLICATIONS
       ===================================================== -->

  <ProductApplications
    applications={productApplications}
  />


  <!-- =====================================================
       PRODUCT BODY CONTENT
       ===================================================== -->

  <section class="container">

    <article class="product-content">

      <Content />

    </article>

  </section>


  <!-- =====================================================
       RELATED PRODUCTS
       ===================================================== -->

  <RelatedProducts
    products={relatedProducts}
    lang="km"
  />

</PageLayout>