---
import PageLayout from "@layouts/PageLayout.astro";
import knowledgeService from "@services/knowledgeService";

import KnowledgeHero from "@components/knowledge/KnowledgeHero.astro";
import KnowledgeMeta from "@components/knowledge/KnowledgeMeta.astro";
import KnowledgeTOC from "@components/knowledge/KnowledgeTOC.astro";
import KnowledgeNavigation from "@components/knowledge/KnowledgeNavigation.astro";
import ReadingProgress from "@components/knowledge/ReadingProgress.astro";
import RelatedArticles from "@components/knowledge/RelatedArticles.astro";
import TagGroup from "@components/ui/TagGroup.astro";
import ArticleSchema from "@components/seo/ArticleSchema.astro";

import { render } from "astro:content";

import "@styles/components/knowledge-content.css";
import "@styles/components/knowledge-toc.css";
import "@styles/components/related-articles.css";
import "@styles/components/info-box.css";
import "@styles/components/faq.css";
import "@styles/components/comparison-table.css";
import "@styles/components/article-link.css";
import "@styles/components/external-link.css";
import "@styles/components/related-topics.css";
import "@styles/components/knowledge-system.css";
import "@styles/components/quick-facts.css";


/* =========================================================
   LANGUAGE
   ========================================================= */

const lang = "km";


/* =========================================================
   STATIC PATHS
   ========================================================= */

export async function getStaticPaths() {

  const articles =
    await knowledgeService.getAll("km");

  const paths =
    await Promise.all(

      articles.map(
        async (article) => {

          const entry =
            await knowledgeService
              .getEntryBySlug(
                article.slug,
                "km"
              );

          return {

            params: {
              slug: article.slug,
            },

            props: {
              entry,
            },

          };

        }
      )

    );

  return paths;
}


/* =========================================================
   PROPS
   ========================================================= */

interface Props {
  entry: Awaited<
    ReturnType<
      typeof knowledgeService.getEntryBySlug
    >
  >;
}

const {
  entry,
} = Astro.props as Props;


/* =========================================================
   CURRENT ARTICLE SLUG
   ========================================================= */

/* =========================================================
   CURRENT ARTICLE
   ========================================================= */

const currentSlug =
  Astro.params.slug;

if (!currentSlug) {
  throw new Error(
    "Missing Khmer Knowledge article slug."
  );
}

const translationKey =
  entry.data.translationKey;

/* =========================================================
   CONTENT
   ========================================================= */

const { Content, headings } =
  await render(entry);


/* =========================================================
   LANGUAGE PAIR ROUTES
   ========================================================= */

const englishTranslation =
  await knowledgeService.getTranslation(
    translationKey,
    "en"
  );

const englishLanguagePath =
  englishTranslation
    ? `/knowledge/${currentSlug}/`
    : "/knowledge/";

const khmerLanguagePath =
  `/km/knowledge/${currentSlug}/`;

/* =========================================================
   KHMER ARTICLES ONLY
   ========================================================= */

const articles =
  await knowledgeService.getAll("km");


/* =========================================================
   SEO
   ========================================================= */

const canonical =
  `https://matocashew.com/km/knowledge/${currentSlug}/`;


/* =========================================================
   RELATED ARTICLES
   ========================================================= */

const relatedArticles = (() => {

  const related =
    articles.filter(
      (article) =>
        article.slug !== currentSlug &&
        (
          article.category ===
            entry.data.category ||

          article.tags.some(
            (tag) =>
              entry.data.tags.includes(tag)
          )
        )
    );

  if (related.length >= 2) {
    return related.slice(0, 2);
  }

  const fallback =
    articles.filter(
      (article) =>
        article.slug !== currentSlug &&
        !related.some(
          (item) =>
            item.slug === article.slug
        )
    );

  return [
    ...related,
    ...fallback,
  ].slice(0, 2);

})();


/* =========================================================
   PREVIOUS / NEXT
   ========================================================= */

const currentIndex =
  articles.findIndex(
    (article) =>
      article.slug === currentSlug
  );

const previous =
  currentIndex > 0
    ? articles[currentIndex - 1]
    : undefined;

const next =
  currentIndex >= 0 &&
  currentIndex < articles.length - 1
    ? articles[currentIndex + 1]
    : undefined;
---

<PageLayout
  title={`${entry.data.title} | Mato Cashew`}
  description={entry.data.description}
  canonical={canonical}
  lang={lang}
  ogType="article"
  hasKhmerAlternate={true}
  breadcrumbs={[
    {
      name: "ទំព័រដើម",
      url: "https://matocashew.com/km/"
    },
    {
      name: "មជ្ឈមណ្ឌលចំណេះដឹង",
      url: "https://matocashew.com/km/knowledge/"
    },
    {
      name: entry.data.title,
      url: canonical
    }
  ]}
>

  <!-- =====================================================
       ARTICLE STRUCTURED DATA
       ===================================================== -->

  <ArticleSchema
    headline={entry.data.title}
    description={entry.data.description}
    image={entry.data.heroImage}
    datePublished={entry.data.publishedAt}
    author={entry.data.author}
    canonical={canonical}
  />


  <!-- =====================================================
       READING PROGRESS
       ===================================================== -->
  <div
    id="language-route-context"
    data-language-en={englishLanguagePath}
    data-language-km={khmerLanguagePath}
    hidden
    ></div>
    
  <ReadingProgress />


  <!-- =====================================================
       ARTICLE PAGE
       ===================================================== -->

  <div
    class="container knowledge-article-page"
    lang={lang}
  >

    <!-- ===================================================
         ARTICLE HERO
         =================================================== -->

    <KnowledgeHero
      category={entry.data.category}
      title={entry.data.title}
      description={entry.data.description}
      heroImage={entry.data.heroImage}
    />


    <!-- ===================================================
         ARTICLE META
         =================================================== -->

    <KnowledgeMeta
        author={entry.data.author}
        publishedAt={entry.data.publishedAt}
        readingTime={entry.data.readingTime}
        lang={lang}
    />


    <!-- ===================================================
         TAGS
         =================================================== -->

    <TagGroup
      tags={entry.data.tags}
      lang={lang}
    />

    <hr />


    <!-- ===================================================
         ARTICLE CONTENT + TOC
         =================================================== -->

    <article class="knowledge-layout">

      <aside>

        <KnowledgeTOC
            headings={headings}
            lang={lang}
        />

      </aside>


      <div
        id="knowledge-content"
        class="knowledge-content"
        data-knowledge-content
      >

        <Content />

      </div>

    </article>


    <!-- ===================================================
         PREVIOUS / NEXT
         =================================================== -->

    <KnowledgeNavigation
        previous={previous}
        next={next}
        lang={lang}
    />


    <!-- ===================================================
         RELATED ARTICLES
         =================================================== -->

    <RelatedArticles
      articles={relatedArticles}
      lang={lang}
    />

  </div>

</PageLayout>