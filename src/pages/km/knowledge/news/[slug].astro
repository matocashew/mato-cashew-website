---
import PageLayout from "@layouts/PageLayout.astro";
import { render } from "astro:content";
import { newsService } from "@services/newsService";

export async function getStaticPaths() {
  const articles = await newsService.getAll("km");

  return articles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type NewsEntry = Awaited<
  ReturnType<typeof newsService.getAll>
>[number];

interface Props {
  entry: NewsEntry;
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);

const englishArticles = await newsService.getAll("en");
const englishTranslation = englishArticles.find(
  (article) =>
    article.data.translationKey === entry.data.translationKey
);

const slug = entry.slug;
const canonical =
  `https://matocashew.com/km/knowledge/news/${slug}`;

const englishLanguagePath = englishTranslation
  ? `/knowledge/news/${englishTranslation.slug}`
  : "/knowledge/news";
---

<PageLayout
  title={`${entry.data.title} | Mato Cashew`}
  description={entry.data.description}
  canonical={canonical}
  lang="km"
  hasKhmerAlternate={Boolean(englishTranslation)}
  breadcrumbs={[
    { name: "ទំព័រដើម", url: "/km" },
    {
      name: "មជ្ឈមណ្ឌលចំណេះដឹង",
      url: "/km/knowledge",
    },
    {
      name: "ព័ត៌មាន និងព្រឹត្តិការណ៍",
      url: "/km/knowledge/news",
    },
    {
      name: entry.data.title,
      url: `/km/knowledge/news/${slug}`,
    },
  ]}
>
  <article class="container news-article" lang="km">
    <p class="news-article__category">
      {entry.data.category}
    </p>

    <h1>{entry.data.title}</h1>

    <p class="news-article__meta">
      <time datetime={entry.data.publishedAt.toISOString()}>
        {entry.data.publishedAt.toLocaleDateString(
          "en-GB",
          {
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: "UTC",
          }
        )}
      </time>
      · ប្រភព៖ {entry.data.sourceName}
    </p>

    {
      entry.data.heroImage && (
        <img
          class="news-article__image"
          src={entry.data.heroImage}
          alt={entry.data.title}
        />
      )
    }

    <div class="news-article__content">
      <Content />
    </div>

    <div class="news-article__source">
      <p>ប្រភពដើម៖ {entry.data.sourceName}</p>
      <a
        href={entry.data.sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        អានអត្ថបទដើម ↗
      </a>
    </div>

    <nav class="news-article__navigation">
      <a href="/km/knowledge/news" data-astro-reload>
        ← ព័ត៌មាន និងព្រឹត្តិការណ៍ទាំងអស់
      </a>
      {
        englishTranslation && (
          <a href={englishLanguagePath}>
            Read in English →
          </a>
        )
      }
    </nav>
  </article>
</PageLayout>

<style>
  .news-article {
    max-width: 900px;
    padding-block: 7rem 5rem;
  }
  .news-article__category {
    color: #467548;
    font-weight: 700;
  }
  .news-article h1 {
    font-size: clamp(1.85rem, 3vw, 2.75rem);
    line-height: 1.55;
    letter-spacing: 0;
    overflow-wrap: anywhere;
    margin-block: 1rem 1.5rem;
  }
  .news-article__meta {
    opacity: .75;
    margin-bottom: 2rem;
  }
  .news-article__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    margin-bottom: 2rem;
  }
  .news-article__content {
    line-height: 1.9;
  }

  .news-article__content :global(p) {
    margin-block: 0 1.4rem;
  }

  .news-article__content :global(h2) {
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    line-height: 1.6;
    margin-block: 2.5rem 1rem;
  }

  .news-article__content :global(h3) {
    font-size: 1.2rem;
    line-height: 1.6;
    margin-block: 2rem .75rem;
  }
  .news-article__source {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid #e2e8df;
    border-radius: 12px;
  }
  .news-article__source a {
    color: #326b37;
    font-weight: 700;
  }
  .news-article__navigation {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* =========================================================
     R66C - NEWS ARTICLE FOREGROUND
     Keep News Detail content above the global atmosphere.
     Do not modify weather-atmosphere / mist / fog / clouds.
     ========================================================= */

  .news-article {
    position: relative;
    z-index: 2;
    opacity: 1;
    filter: none;
    isolation: isolate;
  }

  /*
   * K83Q20P2 - APPROVED NEWS DETAIL READABILITY
   *
   * Approved browser prototypes:
   * K83Q15T1 - Detail hero contrast
   * K83Q16T1 - Article reading surface
   * K83Q17T1 - Original source contrast
   * K83Q19T1 - Exact bottom navigation contrast
   *
   * Scenic background and article image stay unchanged.
   */

  /* HERO */

  .news-article__category {
    color: #245b2b !important;
    font-weight: 800 !important;
    opacity: 1 !important;
    text-shadow:
      0 1px 2px rgba(255,255,255,.98),
      0 0 10px rgba(255,255,255,.72);
  }

  .news-article > h1 {
    color: #0b1f38 !important;
    font-weight: 800 !important;
    opacity: 1 !important;
    text-shadow:
      0 1px 2px rgba(255,255,255,.98),
      0 2px 12px rgba(255,255,255,.62);
  }

  .news-article__meta {
    color: #34465a !important;
    opacity: 1 !important;
    font-weight: 600 !important;
    text-shadow:
      0 1px 2px rgba(255,255,255,.98),
      0 1px 8px rgba(255,255,255,.78);
  }

  /* ARTICLE READING SURFACE */

  .news-article__content {
    position: relative;
    margin-top: 0;
    padding: 1.6rem 1.75rem;
    border-radius: 16px;

    background:
      rgba(255,252,245,.90);

    border:
      1px solid rgba(255,255,255,.60);

    box-shadow:
      0 10px 30px rgba(18,38,30,.08);

    backdrop-filter:
      blur(5px);

    -webkit-backdrop-filter:
      blur(5px);

    color: #263548 !important;
  }

  .news-article__content :is(
    p,
    li,
    blockquote
  ) {
    color: #344256 !important;
    opacity: 1 !important;
  }

  .news-article__content :is(
    h2,
    h3,
    h4
  ) {
    color: #10243a !important;
    opacity: 1 !important;
    font-weight: 800 !important;
  }

  .news-article__content :is(
    strong,
    b
  ) {
    color: #172c40 !important;
    font-weight: 800 !important;
  }

  .news-article__content a {
    color: #23652f !important;
    font-weight: 700 !important;
  }

  /* ORIGINAL SOURCE */

  .news-article__source {
    background:
      rgba(255,252,245,.90) !important;

    border:
      1px solid rgba(255,255,255,.72) !important;

    box-shadow:
      0 8px 24px rgba(18,38,30,.10);

    backdrop-filter:
      blur(5px);

    -webkit-backdrop-filter:
      blur(5px);
  }

  .news-article__source,
  .news-article__source p {
    color: #344256 !important;
    opacity: 1 !important;
    font-weight: 500;
  }

  .news-article__source a {
    color: #245b2b !important;
    opacity: 1 !important;
    font-weight: 800 !important;

    text-shadow:
      0 1px 2px rgba(255,255,255,.85);
  }

  /* EXACT BOTTOM NAVIGATION */

  .news-article__navigation {
    padding: .85rem 1rem !important;
    border-radius: 12px !important;

    background:
      rgba(255,252,245,.78) !important;

    border:
      1px solid rgba(255,255,255,.60) !important;

    backdrop-filter:
      blur(4px);

    -webkit-backdrop-filter:
      blur(4px);

    box-shadow:
      0 6px 20px rgba(18,38,30,.08);
  }

  .news-article__navigation,
  .news-article__navigation a {
    color: #0b1f38 !important;
    opacity: 1 !important;
  }

  .news-article__navigation a {
    font-weight: 800 !important;

    text-shadow:
      0 1px 2px rgba(255,255,255,1),
      0 0 6px rgba(255,255,255,1),
      0 2px 14px rgba(255,255,255,.95);
  }

  /* EVENING */

  .weather-atmosphere[data-weather-phase="evening"]
    ~ main
    .news-article__category {
    color: #f3ffe9 !important;
    text-shadow:
      0 1px 2px rgba(0,0,0,.95),
      0 2px 10px rgba(0,0,0,.78);
  }

  .weather-atmosphere[data-weather-phase="evening"]
    ~ main
    .news-article > h1 {
    color: #ffffff !important;
    text-shadow:
      0 2px 3px rgba(0,0,0,.98),
      0 3px 14px rgba(0,0,0,.82);
  }

  .weather-atmosphere[data-weather-phase="evening"]
    ~ main
    .news-article__meta {
    color: #f4f7fb !important;
    opacity: 1 !important;
    text-shadow:
      0 1px 2px rgba(0,0,0,.98),
      0 2px 10px rgba(0,0,0,.86);
  }

  .weather-atmosphere[data-weather-phase="evening"]
    ~ main
    .news-article__content,
  .weather-atmosphere[data-weather-phase="night"]
    ~ main
    .news-article__content {
    background:
      rgba(250,248,241,.94);

    border-color:
      rgba(255,255,255,.72);

    box-shadow:
      0 12px 34px rgba(0,0,0,.16);
  }

  .weather-atmosphere[data-weather-phase="evening"]
    ~ main
    .news-article__source,
  .weather-atmosphere[data-weather-phase="night"]
    ~ main
    .news-article__source {
    background:
      rgba(250,248,241,.94) !important;

    border-color:
      rgba(255,255,255,.78) !important;

    box-shadow:
      0 10px 28px rgba(0,0,0,.18);
  }

  .weather-atmosphere[data-weather-phase="evening"]
    ~ main
    .news-article__navigation {
    background:
      rgba(10,25,38,.64) !important;

    border-color:
      rgba(255,255,255,.24) !important;
  }

  .weather-atmosphere[data-weather-phase="evening"]
    ~ main
    .news-article__navigation a {
    color: #ffffff !important;
    text-shadow:
      0 1px 2px rgba(0,0,0,1),
      0 2px 10px rgba(0,0,0,.95);
  }

  /* NIGHT */

  .weather-atmosphere[data-weather-phase="night"]
    ~ main
    .news-article__category {
    color: #dff6d7 !important;
    text-shadow:
      0 1px 2px rgba(0,0,0,1),
      0 2px 12px rgba(0,0,0,.95);
  }

  .weather-atmosphere[data-weather-phase="night"]
    ~ main
    .news-article > h1 {
    color: #ffffff !important;
    text-shadow:
      0 2px 3px rgba(0,0,0,1),
      0 3px 16px rgba(0,0,0,.98);
  }

  .weather-atmosphere[data-weather-phase="night"]
    ~ main
    .news-article__meta {
    color: #f5f7fa !important;
    opacity: 1 !important;
    font-weight: 600 !important;
    text-shadow:
      0 1px 2px rgba(0,0,0,1),
      0 2px 12px rgba(0,0,0,.98);
  }

  .weather-atmosphere[data-weather-phase="night"]
    ~ main
    .news-article__navigation {
    background:
      rgba(6,18,30,.72) !important;

    border-color:
      rgba(255,255,255,.26) !important;
  }

  .weather-atmosphere[data-weather-phase="night"]
    ~ main
    .news-article__navigation a {
    color: #ffffff !important;
    opacity: 1 !important;
    font-weight: 800 !important;
    text-shadow:
      0 1px 2px rgba(0,0,0,1),
      0 2px 12px rgba(0,0,0,1);
  }

  /* MOBILE */

  @media (max-width: 768px) {
    .news-article__content {
      padding: 1.25rem 1.1rem;
      border-radius: 14px;
    }

    .news-article__navigation {
      padding: .8rem .85rem !important;
    }
  }

  /*
   * K83Q21P1 - APPROVED ARTICLE IMAGE SEPARATION
   *
   * Approved browser prototype:
   * K83Q21T1
   *
   * Separate the article featured image visually from
   * the scenic atmosphere without changing either image.
   */

  .news-article__image {
    position: relative;
    z-index: 2;

    border:
      2px solid rgba(255,255,255,.82) !important;

    border-radius:
      16px !important;

    box-shadow:
      0 4px 10px rgba(10,31,24,.14),
      0 16px 38px rgba(10,31,24,.22),
      0 0 0 1px rgba(20,55,40,.08) !important;

    outline:
      1px solid rgba(255,255,255,.28);

    outline-offset:
      -4px;
  }

  .weather-atmosphere[data-weather-phase="evening"]
    ~ main
    .news-article__image {
    border-color:
      rgba(255,255,255,.88) !important;

    box-shadow:
      0 5px 12px rgba(0,0,0,.24),
      0 18px 42px rgba(0,0,0,.34),
      0 0 0 1px rgba(255,255,255,.16) !important;
  }

  .weather-atmosphere[data-weather-phase="night"]
    ~ main
    .news-article__image {
    border-color:
      rgba(255,255,255,.92) !important;

    box-shadow:
      0 5px 14px rgba(0,0,0,.42),
      0 20px 46px rgba(0,0,0,.52),
      0 0 0 1px rgba(255,255,255,.20) !important;
  }

  @media (max-width: 768px) {
    .news-article__image {
      border-radius:
        14px !important;

      box-shadow:
        0 4px 10px rgba(10,31,24,.16),
        0 12px 28px rgba(10,31,24,.20) !important;
    }
  }
</style>
