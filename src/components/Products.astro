---
import ProductGrid from "./products/ProductGrid.astro";

import { getLanguage } from "../i18n/getLanguage";
import { getLocalizedPath } from "../i18n/getLocalizedPath";

import type { Language } from "../i18n/config";

import { getFeaturedProducts } from "../services/productService";

/* Home product showcase styles */
import "../styles/products-home.css";


const language: Language =
  Astro.url.pathname.startsWith("/km")
    ? "km"
    : "en";

const t = getLanguage(language);

const productsPath =
  getLocalizedPath(
    language,
    "/products"
  );

const featuredProducts = (
  await getFeaturedProducts()
).slice(0, 3);
---

<section
  id="products"
  class="products products-showcase"
>

  <div class="container">

    <div class="products-showcase-grid">

      <!-- =========================================
           INTRO
           ========================================= -->

      <div class="products-showcase-intro">

        <span class="products-showcase-tag">
          {t.productsHome.tag}
        </span>

        <h2>
          {t.productsHome.title}
        </h2>

        <p>
          {t.productsHome.description}
        </p>

        <a
          href={productsPath}
          class="btn btn-primary products-showcase-cta"
        >
          {t.productsHome.viewAll}

          <span aria-hidden="true">
            →
          </span>
        </a>

      </div>


      <!-- =========================================
           PRODUCTS
           ========================================= -->

      <div class="products-showcase-products">

        <ProductGrid
          products={featuredProducts}
          language={language}
        />

      </div>

    </div>

  </div>

</section>
