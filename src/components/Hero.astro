---
import { getCurrentLanguage } from "../i18n/getCurrentLanguage";
import { getLocalizedPath } from "../i18n/getLocalizedPath";
import type { Language } from "../i18n/config";

const t = getCurrentLanguage(
  Astro.url.pathname
);

const language: Language =
  Astro.url.pathname.startsWith("/km")
    ? "km"
    : "en";

const productsPath =
  getLocalizedPath(language, "/products");

const contactPath =
  getLocalizedPath(language, "/contact");
---

<section class="hero">

  <div class="container hero-grid">

    <div class="hero-content">

      <span class="hero-tag">
        {t.hero.tag}
      </span>

      <h1>{t.hero.title}</h1>

      <p>
        {t.hero.description}
      </p>

      <div class="hero-buttons">

        <a
          href={productsPath}
          class="btn btn-primary"
        >
          {t.common.viewProducts}
        </a>

        <a
          href={contactPath}
          class="btn btn-outline"
        >
          {t.common.contactUs}
        </a>

      </div>

    </div>

    <div class="hero-image">

      <picture>

        <source
          srcset="/images/products/package.webp"
          type="image/webp"
        />

        <img
          src="/images/products/package.png"
          alt="Premium Cambodian cashew kernels by Mato Cashew"
          width="600"
          height="700"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

      </picture>

    </div>

  </div>

</section>