  "badge-check":
    '<path d="M12 3l2.1 1.4 2.5-.2.9 2.3 2.1 1.4-.7 2.4.7 2.4-2.1 1.4-.9 2.3-2.5-.2L12 21l-2.1-1.4-2.5.2-.9-2.3-2.1-1.4.7-2.4-.7-2.4 2.1-1.4.9-2.3 2.5.2z"/><path d="m9 12 2 2 4-4"/>',

  "layers":
    '<path d="m12 2 9 5-9 5-9-5z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',

  "shield-check":
    '<path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z"/><path d="m9 12 2 2 4-4"/>',

  "droplets":
    '<path d="M7 16a4 4 0 0 1-4-4c0-2.5 4-7 4-7s4 4.5 4 7a4 4 0 0 1-4 4z"/><path d="M17 22a4 4 0 0 1-4-4c0-2.5 4-7 4-7s4 4.5 4 7a4 4 0 0 1-4 4z"/>',

  "archive":
    '<path d="M3 5h18v4H3z"/><path d="M5 9v11h14V9"/><path d="M9 13h6"/>',

  "package":
    '<path d="m12 2 9 5-9 5-9-5z"/><path d="m3 7 9 5 9-5"/><path d="M3 7v10l9 5 9-5V7"/><path d="M12 12v10"/>',

  "clock":
    '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',

  "sprout":
    '<path d="M12 22V12"/><path d="M12 16c-5 0-7-3-7-7 5 0 7 3 7 7z"/><path d="M12 12c0-5 3-7 7-7 0 5-3 7-7 7z"/>',

  "factory":
    '<path d="M3 21V10l6 3V9l6 4V6h6v15z"/><path d="M7 17h2"/><path d="M13 17h2"/><path d="M18 10h3"/>',

  "ship":
    '<path d="M3 18c2 0 2 1 4 1s2-1 4-1 2 1 4 1 2-1 4-1 2 1 3 1"/><path d="m5 15 2-7h10l2 7"/><path d="M12 8V3"/><path d="M9 5h6"/>',

  "briefcase":
    '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/><path d="M10 12v2h4v-2"/>',

  "image":
    '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/>',

  "mail":
    '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',

  "circle":
    '<circle cx="12" cy="12" r="8"/>'
};

const icon =
  paths[name] ?? paths.circle;
---

<span
  class="mega-menu-icon"
  aria-hidden="true"
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    focusable="false"
  >
    <Fragment set:html={icon} />
  </svg>
</span>
