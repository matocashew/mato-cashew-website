---
import type { Language } from "../i18n/config";

const language: Language =
  Astro.url.pathname.startsWith("/km")
    ? "km"
    : "en";

const items =
  language === "km"
    ? [
        {
          icon: "sprout",
          title: "ដាំដុះក្នុងស្រុក",
          text: "នៅប្រទេសកម្ពុជា",
        },
        {
          icon: "leaf",
          title: "កែច្នៃដោយយកចិត្តទុកដាក់",
          text: "ដើម្បីគុណភាពល្អបំផុត",
        },
        {
          icon: "package",
          title: "វេចខ្ចប់ប្រកបដោយអនាម័យ",
          text: "ដើម្បីរក្សាភាពស្រស់",
        },
        {
          icon: "globe",
          title: "ស្តង់ដារអន្តរជាតិ",
          text: "ដែលអ្នកអាចទុកចិត្តបាន",
        },
      ]
    : [
        {
          icon: "sprout",
          title: "Locally Grown",
          text: "In Cambodia",
        },
        {
          icon: "leaf",
          title: "Carefully Processed",
          text: "for Best Quality",
        },
        {
          icon: "package",
          title: "Hygienic Packaging",
          text: "for Freshness",
        },
        {
          icon: "globe",
          title: "Global Standards",
          text: "You Can Trust",
        },
      ];

const iconPaths: Record<string, string> = {
  sprout:
    "M7 20h10M12 20v-7M12 13C12 8 9 5 5 5c0 4 2 7 7 8ZM12 13c0-5 3-8 7-8 0 4-2 7-7 8Z",

  leaf:
    "M11 20A7 7 0 0 1 9 6c4-2 8-2 11-2 0 7-3 13-9 16Zm0 0c1-5 4-9 9-12",

  package:
    "M21 8 12 3 3 8l9 5 9-5ZM3 8v8l9 5 9-5V8M12 13v8",

  globe:
    "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Zm0-20c2.5 2.7 4 6.1 4 10s-1.5 7.3-4 10c-2.5-2.7-4-6.1-4-10s1.5-7.3 4-10ZM2 12h20",
};
---

<section class="trust-bar" aria-label="Mato Cashew quality benefits">
  <div class="trust-bar__inner">
    {
      items.map((item) => (
        <div class="trust-item">
          <div class="trust-item__icon" aria-hidden="true">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                    d={iconPaths[item.icon]}
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    />
                </svg>
            </div>

          <div class="trust-item__content">
            <strong>{item.title}</strong>
            <span>{item.text}</span>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust-bar {
    position: relative;
    z-index: 5;

    width: 100%;
    padding: 0 24px;

    margin-top: 24px;
    margin-bottom: 30px;
  }

  .trust-bar__inner {
    width: min(1400px, 100%);
    min-height: 108px;

    margin: 0 auto;
    padding: 20px 30px;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    background: rgba(255, 253, 248, 0.97);

    border: 1px solid rgba(12, 98, 67, 0.08);
    border-radius: 18px;

    box-shadow:
      0 12px 35px rgba(27, 55, 40, 0.08);

    backdrop-filter: blur(10px);
  }

  .trust-item {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 14px;
    padding: 10px 24px;
  }

  /* divider */

  .trust-item:not(:last-child)::after {
    content: "";

    position: absolute;
    right: 0;
    top: 20%;

    width: 1px;
    height: 60%;

    background: rgba(19, 83, 60, 0.15);
  }

  .trust-item__icon {
    flex: 0 0 48px;

    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #edf5ef;
    color: #0b6847;

    font-size: 20px;
  }

  .trust-item__icon svg {
    width: 22px;
    height: 22px;
    display: block;
    flex-shrink: 0;
    }

  .trust-item__content {
    display: flex;
    flex-direction: column;

    line-height: 1.35;
  }

  .trust-item__content strong {
    color: #17251f;

    font-size: 15px;
    font-weight: 700;
  }

  .trust-item__content span {
    margin-top: 3px;

    color: #66716b;

    font-size: 13px;
    font-weight: 500;
  }

  /* =========================
     TABLET
     ========================= */

  @media (max-width: 1000px) {

    .trust-bar__inner {
      grid-template-columns: repeat(2, 1fr);
      padding: 16px;
    }

    .trust-item {
      justify-content: flex-start;
      padding: 16px;
    }

    .trust-item::after {
      display: none;
    }
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 600px) {

    .trust-bar {
      padding: 0 14px;

      margin-top: 16px;
      margin-bottom: 24px;
    }

    .trust-bar__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 8px;

      padding: 10px;

      border-radius: 14px;
    }

    .trust-item {
      gap: 9px;

      padding: 10px 6px;

      justify-content: flex-start;
    }

    .trust-item__icon {
      flex-basis: 34px;

      width: 34px;
      height: 34px;

      font-size: 15px;
    }

    .trust-item__icon svg {
        width: 17px;
        height: 17px;
    }

    .trust-item__content strong {
      font-size: 11px;
    }

    .trust-item__content span {
      font-size: 10px;
    }
  }
</style>