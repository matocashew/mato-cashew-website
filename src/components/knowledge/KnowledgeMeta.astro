---
import type { Language } from "../../i18n/config";

import {
  formatKnowledgeText,
  getKnowledgeTranslations,
} from "../../i18n/knowledge";

interface Props {
  author: string;
  publishedAt: Date;
  readingTime: number;
  lang?: Language;
}

const {
  author,
  publishedAt,
  readingTime,
  lang = "en",
} = Astro.props;

const t =
  getKnowledgeTranslations(lang);

const locale =
  lang === "km"
    ? "km-KH"
    : "en-US";

const formattedDate =
  publishedAt.toLocaleDateString(
    locale,
    {
      year: "numeric",
      month: "long",
      day: "numeric",
    }
  );
---

<div
  class="knowledge-meta"
  lang={lang}
>
  <span>
    {t.author}: {author}
  </span>

  <span>
    {t.published}: {formattedDate}
  </span>

  <span>
    {
      formatKnowledgeText(
        t.minuteRead,
        {
          count: readingTime,
        }
      )
    }
  </span>
</div>