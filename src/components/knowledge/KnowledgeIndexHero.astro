---
import type { Language } from "../../i18n/config";

import {
  getKnowledgeTranslations,
} from "../../i18n/knowledge";

interface Props {
  lang?: Language;
}

const {
  lang = "en",
} = Astro.props;

const t =
  getKnowledgeTranslations(lang);
---

<section
  class="knowledge-index-hero"
  lang={lang}
>
  <div class="knowledge-index-hero__inner">

    <p class="eyebrow">
      {t.eyebrow}
    </p>

    <h1>
      {t.titlePrimary}

      <span>
        {t.titleSecondary}
      </span>
    </h1>

    <p class="description">
      {t.description}
    </p>

    <div
      class="knowledge-index-hero__topics"
      aria-label={
        lang === "km"
          ? "ប្រធានបទចំណេះដឹង"
          : "Knowledge topics"
      }
    >
      <span>
        <svg class="k89-topic-icon"
             viewBox="0 0 24 24"
             width="16"
             height="16"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true"
             focusable="false">
          <path d="M2 4.5A2.5 2.5 0 0 1 4.5 2H10v16H4.5A2.5 2.5 0 0 0 2 20.5z"/><path d="M22 4.5A2.5 2.5 0 0 0 19.5 2H14v16h5.5a2.5 2.5 0 0 1 2.5 2.5z"/>
        </svg>
        {t.topics.knowledge}
      </span>

      <span>
        <svg class="k89-topic-icon"
             viewBox="0 0 24 24"
             width="16"
             height="16"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true"
             focusable="false">
          <path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z"/><path d="m9 12 2 2 4-4"/>
        </svg>
        {t.topics.quality}
      </span>

      <span>
        <svg class="k89-topic-icon"
             viewBox="0 0 24 24"
             width="16"
             height="16"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true"
             focusable="false">
          <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l-1.86 1.86A1.7 1.7 0 0 0 16 18.4l-1.4.8-.6 2.3h-4l-.6-2.3-1.4-.8a1.7 1.7 0 0 0-1.88.34l-1.86-1.86A1.7 1.7 0 0 0 4.6 15l-.8-1.4-2.3-.6v-2l2.3-.6.8-1.4a1.7 1.7 0 0 0-.34-1.88l1.86-1.86A1.7 1.7 0 0 0 8 5.6l1.4-.8.6-2.3h4l.6 2.3 1.4.8a1.7 1.7 0 0 0 1.88-.34l1.86 1.86A1.7 1.7 0 0 0 19.4 9l.8 1.4 2.3.6v2l-2.3.6z"/>
        </svg>
        {t.topics.processing}
      </span>

      <span>
        <svg class="k89-topic-icon"
             viewBox="0 0 24 24"
             width="16"
             height="16"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true"
             focusable="false">
          <path d="M3 17l6-6 4 4 8-9"/><path d="M15 6h6v6"/><path d="M3 21V3"/>
        </svg>
        {t.topics.business}
      </span>
    </div>

  </div>
</section>