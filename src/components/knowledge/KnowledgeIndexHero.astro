---
import type { Language } from "../../i18n/config";

import {
  getKnowledgeTranslations,
} from "../../i18n/knowledge";

interface Props {
  lang?: Language;
}

const {
  lang = "en",
} = Astro.props;

const t =
  getKnowledgeTranslations(lang);
---

<section
  class="knowledge-index-hero"
  lang={lang}
>
  <div class="knowledge-index-hero__inner">

    <p class="eyebrow">
      {t.eyebrow}
    </p>

    <h1>
      {t.titlePrimary}

      <span>
        {t.titleSecondary}
      </span>
    </h1>

    <p class="description">
      {t.description}
    </p>

    <div
      class="knowledge-index-hero__topics"
      aria-label={
        lang === "km"
          ? "ប្រធានបទចំណេះដឹង"
          : "Knowledge topics"
      }
    >
      <span>
        {t.topics.knowledge}
      </span>

      <span>
        {t.topics.quality}
      </span>

      <span>
        {t.topics.processing}
      </span>

      <span>
        {t.topics.business}
      </span>
    </div>

  </div>
</section>