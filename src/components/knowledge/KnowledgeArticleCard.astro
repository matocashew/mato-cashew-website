---
import type { Knowledge } from "@models/Knowledge";
import type { Language } from "../../i18n/config";

import {
  formatKnowledgeText,
  getKnowledgeCategoryLabel,
  getKnowledgeTranslations,
} from "../../i18n/knowledge";

interface Props {
  article: Knowledge;
  lang?: Language;
}

const {
  article,
  lang = "en",
} = Astro.props as Props;

const t =
  getKnowledgeTranslations(lang);

const articlePath =
  lang === "km"
    ? `/km/knowledge/${article.slug}/`
    : `/knowledge/${article.slug}/`;
---

<a
  href={articlePath}
  class="knowledge-article-card"
  data-title={article.title.toLowerCase()}
  data-description={article.description.toLowerCase()}
  data-category={article.category.toLowerCase()}
  data-tags={article.tags.join(" ").toLowerCase()}
>

  <img
    src={article.heroImage}
    alt={article.title}
  />

  <div class="card-content">

    <span class="category">
      {
        getKnowledgeCategoryLabel(
          article.category,
          lang
        )
      }
    </span>

    <h3>{article.title}</h3>

    <p>{article.description}</p>

    {
      article.tags.length > 0 && (
        <div class="card-tags">
          {
            article.tags.slice(0, 3).map(
              (tag) => (
                <span
                  class="card-tag"
                  data-tag={tag.toLowerCase()}
                >
                  #{tag}
                </span>
              )
            )
          }
        </div>
      )
    }

    <div class="card-footer">

      <span>
        {
          formatKnowledgeText(
            t.minuteRead,
            {
              count: article.readingTime,
            }
          )
        }
      </span>

      <span class="read-more">
        {t.readMore} &rarr;
      </span>

    </div>

  </div>

</a>