---
import type { Language } from "../../i18n/config";

import {
  getKnowledgeCategoryLabel,
  getKnowledgeTranslations,
} from "../../i18n/knowledge";

interface Props {
  title: string;
  description: string;
  image: string;
  category: string;
  tags: string[];
  slug: string;
  lang?: Language;
}

const {
  title,
  description,
  image,
  category,
  tags,
  slug,
  lang = "en",
} = Astro.props;

const t =
  getKnowledgeTranslations(lang);

const articlePath =
  lang === "km"
    ? `/km/knowledge/${slug}/`
    : `/knowledge/${slug}/`;
---

<a
  href={articlePath}
  class="featured-knowledge-card"
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-category={category.toLowerCase()}
  data-tags={tags.join(" ").toLowerCase()}
>

  <div class="featured-image">

    <img
      src={image}
      alt={title}
      loading="lazy"
    />

  </div>

  <div class="featured-content">

    <span class="category">
      {
        getKnowledgeCategoryLabel(
          category,
          lang
        )
      }
    </span>

    <h2>{title}</h2>

    <p>{description}</p>

    <span class="read-more">
      {t.readArticle} →
    </span>

  </div>

</a>