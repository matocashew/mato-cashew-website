---
interface Props {
  title: string;
  description: string;
  image: string;
  category: string;
  tags: string[];
  slug: string;
}

const {
  title,
  description,
  image,
  category,
  tags,
  slug
} = Astro.props;
---

<a
  href={`/knowledge/${slug}/`}
  class="featured-knowledge-card"
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-category={category.toLowerCase()}
  data-tags={tags.join(" ").toLowerCase()}
>

  <div class="featured-image">

    <img
      src={image}
      alt={title}
      loading="lazy"
    />

  </div>

  <div class="featured-content">

    <span class="category">
      {category}
    </span>

    <h2>{title}</h2>

    <p>{description}</p>

    <span class="read-more">
      Read Article →
    </span>

  </div>

</a>