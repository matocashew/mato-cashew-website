---
import type { Knowledge } from "@models/Knowledge";
import type { Language } from "../../i18n/config";

import {
  getKnowledgeTranslations,
} from "../../i18n/knowledge";

import KnowledgeArticleCard from "./KnowledgeArticleCard.astro";

import "@styles/components/knowledge-grid.css";

interface Props {
  articles: Knowledge[];
  lang?: Language;
}

const {
  articles,
  lang = "en",
} = Astro.props as Props;

const t =
  getKnowledgeTranslations(lang);
---

<section class="knowledge-grid">

  {
    articles.length === 0 ? (

      <p>
        {t.noResultsTitle}
      </p>

    ) : (

      articles.map(article => (

        <KnowledgeArticleCard
          article={article}
          lang={lang}
        />

      ))

    )
  }

  <div
    id="knowledge-no-results"
    class="knowledge-no-results"
    hidden
  >
    <h3>
      {t.noResultsTitle}
    </h3>

    <p id="knowledge-no-results-message">
      {t.noResultsDescription}
    </p>

    <button
      id="knowledge-clear-filters"
      class="knowledge-clear-filters"
      type="button"
    >
      {t.clearFilters}
    </button>
  </div>

  <div class="knowledge-load-more-wrap">

    <button
      id="knowledge-load-more"
      class="knowledge-load-more"
      type="button"
      hidden
    >
      {t.loadMoreArticles}
    </button>

  </div>

</section>