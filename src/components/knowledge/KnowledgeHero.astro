---
import { getKnowledgeImageDimensions } from "@utils/knowledgeImageDimensions";
import type { Language } from "../../i18n/config";

import {
  getKnowledgeDisplayCategoryLabel,
} from "../../i18n/knowledge";
import "@styles/knowledge-hero.css";

interface Props {
  category: string;
  title: string;
  description: string;
  heroImage: string;
  lang?: Language;
}

const {
  category,
  title,
  description,
  heroImage,
  lang = "en",
} = Astro.props;
const imageDimensions =
  getKnowledgeImageDimensions(heroImage);

---

<header class="knowledge-hero">

  <img
    src={heroImage}
    width={imageDimensions?.width}
    height={imageDimensions?.height}
    alt={title}
    class="knowledge-hero-image"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  <p class="knowledge-category">
    {getKnowledgeDisplayCategoryLabel(category, lang)}
  </p>

  <h1>{title}</h1>

  <p class="knowledge-description">
    {description}
  </p>

</header>