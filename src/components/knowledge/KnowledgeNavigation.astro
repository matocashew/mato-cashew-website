---
import type { Language }
  from "../../i18n/config";

import {
  getKnowledgeTranslations,
} from "../../i18n/knowledge";


interface NavigationArticle {
  title: string;
  slug: string;
}


interface Props {
  previous?: NavigationArticle;
  next?: NavigationArticle;
  lang?: Language;
}


const {
  previous,
  next,
  lang = "en",
} = Astro.props;


const t =
  getKnowledgeTranslations(lang);


const ariaLabel =
  lang === "km"
    ? "ការរុករកអត្ថបទ"
    : "Article navigation";


const getArticleUrl = (
  slug: string
): string => {

  return lang === "km"
    ? `/km/knowledge/${slug}/`
    : `/knowledge/${slug}/`;

};
---

{
  (previous || next) && (

    <nav
      class:list={[
        "knowledge-navigation",
        {
          "single-card":
            !(previous && next),
        },
      ]}
      aria-label={ariaLabel}
      lang={lang}
    >

      {
        previous && (

          <a
            href={getArticleUrl(
              previous.slug
            )}
            class="previous"
          >

            <span class="navigation-label">
              &larr; {t.previousArticle}
            </span>

            <strong>
              {previous.title}
            </strong>

          </a>

        )
      }


      {
        next && (

          <a
            href={getArticleUrl(
              next.slug
            )}
            class="next"
          >

            <span class="navigation-label">
              {t.nextArticle} &rarr;
            </span>

            <strong>
              {next.title}
            </strong>

          </a>

        )
      }

    </nav>

  )
}