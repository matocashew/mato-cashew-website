<div class="knowledge-search">

  <input
    id="knowledge-search"
    type="search"
    aria-label="Search knowledge articles"
    placeholder="Search knowledge articles..."
    autocomplete="off"
  />

  <button
    id="knowledge-search-clear"
    class="knowledge-search-clear"
    type="button"
    aria-label="Clear search"
    hidden
  >
    ×
  </button>

</div>

<style>

.knowledge-search{

  margin:2rem 0;

}

.knowledge-search input{

  width:100%;

  padding:1rem 1.25rem;

  border:1px solid #D1D5DB;

  border-radius:12px;

  font-size:1rem;

  transition:border-color .2s;

}

.knowledge-search input:focus{

  outline:none;

  border-color:#2E7D32;

  box-shadow:0 0 0 3px rgba(46,125,50,.12);

}

.knowledge-search{

  position:relative;

  margin:2rem 0;

}

.knowledge-search-clear{

  position:absolute;

  top:50%;

  right:1rem;

  transform:translateY(-50%);

  width:2rem;

  height:2rem;

  border:none;

  border-radius:999px;

  background:transparent;

  color:#6B7280;

  font-size:1.25rem;

  line-height:1;

  cursor:pointer;

  transition:background-color .2s,color .2s;

}

.knowledge-search-clear:hover{

  background:#F3F4F6;

  color:#111827;

}

</style>