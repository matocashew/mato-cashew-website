---
import type { Language } from "../../i18n/config";

import {
  getKnowledgeCategoryLabel,
  getKnowledgeTranslations,
} from "../../i18n/knowledge";

interface Props {
  categories: string[];
  lang?: Language;
}

const {
  categories,
  lang = "en",
} = Astro.props;

const t =
  getKnowledgeTranslations(lang);
---

{
  categories.length > 0 && (

    <section class="knowledge-categories">

      <h2 class="section-title">
        {t.browseByCategory}
      </h2>

      <div class="category-list">

        <button
          type="button"
          class="category-chip active"
          data-category="all"
          aria-pressed="true"
        >
          {t.all}
        </button>

        {
          categories.map(category => (

            <button
              type="button"
              class="category-chip"
              data-category={category.toLowerCase()}
              aria-pressed="false"
            >
              {
                getKnowledgeCategoryLabel(
                  category,
                  lang
                )
              }
            </button>

          ))
        }

      </div>

    </section>

  )
}