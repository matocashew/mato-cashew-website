---
interface Props {
  categories: string[];
}

const { categories } = Astro.props;
---

{
  categories.length > 0 && (

    <section class="knowledge-categories">

      <h2 class="section-title">
        Browse by Category
      </h2>

        <div class="category-list">

          <button
            type="button"
            class="category-chip active"
            data-category="all"
            aria-pressed="true"
          >
            All
          </button>

          {
            categories.map(category => (

              <button
                type="button"
                class="category-chip"
                data-category={category.toLowerCase()}
                aria-pressed="false"
              >
                {category}
              </button>

            ))
          }

        </div>

    </section>

  )
}