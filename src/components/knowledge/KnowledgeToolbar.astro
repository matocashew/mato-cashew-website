---
import type { Language } from "../../i18n/config";

import {
  formatKnowledgeText,
  getKnowledgeTranslations,
} from "../../i18n/knowledge";

import KnowledgeSearch from "./KnowledgeSearch.astro";

interface Props {
  totalArticles: number;
  lang?: Language;
}

const {
  totalArticles,
  lang = "en",
} = Astro.props;

const t =
  getKnowledgeTranslations(lang);
---

<div class="knowledge-toolbar">

  <KnowledgeSearch lang={lang} />

  <p
    id="knowledge-search-result-count"
    class="knowledge-search-result-count"
    aria-live="polite"
  >
    {
      formatKnowledgeText(
        t.showingAll,
        {
          count: totalArticles,
        }
      )
    }
  </p>

</div>