---
import type { Language } from "../../i18n/config";

import {
  getKnowledgeTranslations,
} from "../../i18n/knowledge";

interface Props {
  articles: number;
  categories: number;
  tags: number;
  lang?: Language;
}

const {
  articles,
  categories,
  tags,
  lang = "en",
} = Astro.props;

const t =
  getKnowledgeTranslations(lang);
---

<section class="knowledge-stats">

  <div class="stat">

    <strong>{articles}</strong>

    <span>
      {t.stats.articles}
    </span>

  </div>

  <div class="stat">

    <strong>{categories}</strong>

    <span>
      {t.stats.categories}
    </span>

  </div>

  <div class="stat">

    <strong>{tags}</strong>

    <span>
      {t.stats.tags}
    </span>

  </div>

</section>