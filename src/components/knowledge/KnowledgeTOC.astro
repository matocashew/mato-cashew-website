---
import type { Language } from "../../i18n/config";

import {
  getKnowledgeTranslations,
} from "../../i18n/knowledge";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang?: Language;
}

const {
  headings,
  lang = "en",
} = Astro.props;

const t =
  getKnowledgeTranslations(lang);
---

{
  headings.length > 0 && (

    <details
      class="knowledge-toc"
      open
      lang={lang}
    >

      <summary>
        <span>
          {t.contents}
        </span>
      </summary>

      <ul>

        {
          headings.map((heading) => (

            <li
              class={`toc-item depth-${heading.depth}`}
            >

              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
              >
                {heading.text}
              </a>

            </li>

          ))
        }

      </ul>

    </details>

  )
}

<script>
  let tocScrollHandler: (() => void) | null = null;

  function initKnowledgeTOC() {
    /*
     * Remove old listener before re-initializing
     * after Astro ClientRouter navigation.
     */
    if (tocScrollHandler) {
      window.removeEventListener(
        "scroll",
        tocScrollHandler
      );

      tocScrollHandler = null;
    }

    const toc =
      document.querySelector<HTMLElement>(
        ".knowledge-toc"
      );

    const links =
      Array.from(
        document.querySelectorAll<HTMLAnchorElement>(
          "[data-toc-link]"
        )
      );

    if (!toc || !links.length) return;

    const sections =
      links
        .map((link) => {
          const id =
            link.getAttribute(
              "data-toc-link"
            );

          return id
            ? document.getElementById(id)
            : null;
        })
        .filter(
          (
            section
          ): section is HTMLElement =>
            section !== null
        );

    if (!sections.length) return;

    const keepActiveLinkVisible = (
      activeLink: HTMLAnchorElement
    ) => {
      /*
       * Scroll ONLY the TOC container.
       * Do NOT use scrollIntoView().
       */

      const tocRect =
        toc.getBoundingClientRect();

      const linkRect =
        activeLink.getBoundingClientRect();

      const topBuffer = 20;
      const bottomBuffer = 20;

      const isAbove =
        linkRect.top <
        tocRect.top + topBuffer;

      const isBelow =
        linkRect.bottom >
        tocRect.bottom - bottomBuffer;

      if (!isAbove && !isBelow) {
        return;
      }

      const linkTopInsideToc =
        activeLink.offsetTop;

      const targetScrollTop =
        Math.max(
          0,
          linkTopInsideToc -
          toc.clientHeight / 2 +
          activeLink.offsetHeight / 2
        );

      toc.scrollTo({
        top: targetScrollTop,
        behavior: "smooth",
      });
    };

    const updateTOC = () => {
      let currentId = "";

      const scrollPosition =
        window.scrollY + 140;

      sections.forEach((section) => {
        if (
          section.offsetTop <=
          scrollPosition
        ) {
          currentId = section.id;
        }
      });

      if (
        !currentId &&
        sections.length > 0
      ) {
        currentId =
          sections[0].id;
      }

      let activeLink:
        HTMLAnchorElement | null = null;

      links.forEach((link) => {
        const isActive =
          link.getAttribute(
            "data-toc-link"
          ) === currentId;

        link.classList.toggle(
          "active",
          isActive
        );

        if (isActive) {
          link.setAttribute(
            "aria-current",
            "true"
          );

          activeLink = link;
        } else {
          link.removeAttribute(
            "aria-current"
          );
        }
      });

      if (activeLink) {
        keepActiveLinkVisible(
          activeLink
        );
      }
    };

    tocScrollHandler = updateTOC;

    window.addEventListener(
      "scroll",
      tocScrollHandler,
      {
        passive: true,
      }
    );

    updateTOC();
  }

  document.addEventListener(
    "astro:page-load",
    initKnowledgeTOC
  );
</script>