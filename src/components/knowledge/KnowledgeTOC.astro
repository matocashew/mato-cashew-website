---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

{
  headings.length > 0 && (

    <details
      class="knowledge-toc"
      open
    >

      <summary>

        <span>📑 Contents</span>

      </summary>

      <ul>

        {
          headings.map((heading) => (

            <li class={`toc-item depth-${heading.depth}`}>

              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
              >

                {heading.text}

              </a>

            </li>

          ))
        }

      </ul>

    </details>

  )
}
