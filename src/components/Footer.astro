---
import { getCurrentLanguage } from "../i18n/getCurrentLanguage";
import { SITE } from "../config/site";

const t = getCurrentLanguage(Astro.url.pathname);

const isKhmer = Astro.url.pathname.startsWith("/km");

const brandName = isKhmer
  ? SITE.brand.khmer
  : SITE.brand.english;

const homeUrl =
  isKhmer ? "/km/" : "/";

const aboutUrl =
  isKhmer ? "/km/about/" : "/about/";

const productsUrl =
  isKhmer ? "/km/products/" : "/products/";

const knowledgeUrl = "/knowledge/";

const resourcesUrl =
  isKhmer ? "/km/resources/" : "/resources/";

const galleryUrl =
  isKhmer ? "/km/gallery/" : "/gallery/";

const wholesaleUrl =
  isKhmer ? "/km/wholesale/" : "/wholesale/";

const contactUrl =
  isKhmer ? "/km/contact/" : "/contact/";

const currentYear = new Date().getFullYear();

const copyright = isKhmer
  ? `© ${currentYear} ${SITE.brand.khmer}។ រក្សាសិទ្ធិគ្រប់យ៉ាង។`
  : `© ${currentYear} ${SITE.brand.english}. All rights reserved.`;
---

<footer class="footer">

  <div class="container footer-grid">

    <!-- =====================================================
         BRAND
         ===================================================== -->

    <div class="footer-brand">

      <a
        class="footer-logo"
        href={homeUrl}
        aria-label={`${brandName} Home`}
      >
        <img
          src="/images/logo/footer-logo.png"
          alt="ចន្ទីមាតុភូមិ — Mato Cashew"
          width="190"
          height="100"
          loading="lazy"
          decoding="async"
        />
      </a>

      <p class="footer-description">
        {t.footer.description}
      </p>

    </div>


    <!-- =====================================================
         PRODUCTS
         ===================================================== -->

    <nav
      class="footer-column"
      aria-label={isKhmer ? "ផលិតផល" : "Products"}
    >

      <h4>
        {isKhmer ? "ផលិតផល" : "Products"}
      </h4>

      <ul>

        <li>
          <a href={productsUrl}>
            {isKhmer ? "ផលិតផលទាំងអស់" : "All Products"}
          </a>
        </li>

        <li>
          <a href={productsUrl}>
            {isKhmer ? "គ្រាប់ស្វាយចន្ទី" : "Cashew Products"}
          </a>
        </li>

        <li>
          <a href={wholesaleUrl}>
            {isKhmer ? "លក់ដុំ" : "Wholesale"}
          </a>
        </li>

      </ul>

    </nav>


    <!-- =====================================================
         RESOURCES
         ===================================================== -->

    <nav
      class="footer-column"
      aria-label={isKhmer ? "ធនធាន" : "Resources"}
    >

      <h4>
        {isKhmer ? "ធនធាន" : "Resources"}
      </h4>

      <ul>

        <li>
          <a href={knowledgeUrl}>
            {t.nav.knowledge}
          </a>
        </li>

        <li>
          <a href={resourcesUrl}>
            {isKhmer ? "ធនធាន" : "Resources"}
          </a>
        </li>

        <li>
          <a href={galleryUrl}>
            {isKhmer ? "វិចិត្រសាល" : "Gallery"}
          </a>
        </li>

      </ul>

    </nav>


    <!-- =====================================================
         COMPANY
         ===================================================== -->

    <nav
      class="footer-column"
      aria-label={isKhmer ? "អំពីក្រុមហ៊ុន" : "Company"}
    >

      <h4>
        {isKhmer ? "អំពីក្រុមហ៊ុន" : "Company"}
      </h4>

      <ul>

        <li>
          <a href={aboutUrl}>
            {t.nav.about}
          </a>
        </li>

        <li>
          <a href={contactUrl}>
            {t.nav.contact}
          </a>
        </li>

      </ul>

    </nav>

  </div>


  <!-- =======================================================
       CONTACT STRIP
       ======================================================= -->

  <div class="container footer-contact-strip">

    <div class="footer-contact-item">

      <span class="footer-contact-label">
        {t.footer.email}
      </span>

      <a href={`mailto:${SITE.contact.email}`}>
        {SITE.contact.email}
      </a>

    </div>


    <div class="footer-contact-item">

      <span class="footer-contact-label">
        {t.footer.phone}
      </span>

      <a
        href={`tel:${SITE.contact.phone.replace(/\s+/g, "")}`}
      >
        {SITE.contact.phone}
      </a>

    </div>


    <div class="footer-contact-item">

      <span class="footer-contact-label">
        {isKhmer ? "អាសយដ្ឋាន" : "Address"}
      </span>

      <span>
        {
          isKhmer
            ? SITE.address.khmer
            : SITE.address.full
        }
      </span>

    </div>

  </div>


  <!-- =======================================================
       BOTTOM
       ======================================================= -->

  <div class="footer-bottom">

    <div class="container footer-bottom-inner">

      <p>
        {copyright}
      </p>

    </div>

  </div>

</footer>