---
/**
 * A48 — Global Weather Atmosphere
 *
 * Decorative weather renderer.
 *
 * Current preview:
 * - cloudy
 * - breezy
 * - daytime
 *
 * Live location/weather binding is added in A48-A6.
 */
---

<div
  class="weather-atmosphere"
  data-weather-atmosphere
  data-weather-kind="cloudy"
  data-weather-wind="breezy"
  data-weather-day="true"
  aria-hidden="true"
>
  <div class="weather-atmosphere__sky"></div>

  <!-- ======================================================
       BACK CLOUD
       Large recognizable cloud silhouette
       ====================================================== -->

  <div
    class="
      weather-atmosphere__cloud
      weather-atmosphere__cloud--back
    "
  >
    <svg
      class="weather-atmosphere__cloud-svg"
      viewBox="0 0 720 260"
      role="presentation"
      focusable="false"
      aria-hidden="true"
    >
      <defs>
        <linearGradient
          id="a48-cloud-back-fill"
          x1="0"
          y1="0"
          x2="0"
          y2="1"
        >
          <stop
            offset="0%"
            stop-color="#ffffff"
            stop-opacity="0.96"
          />

          <stop
            offset="58%"
            stop-color="#edf2f3"
            stop-opacity="0.94"
          />

          <stop
            offset="100%"
            stop-color="#aebfc6"
            stop-opacity="0.82"
          />
        </linearGradient>

        <filter
          id="a48-cloud-back-soft"
          x="-15%"
          y="-20%"
          width="130%"
          height="150%"
        >
          <feGaussianBlur
            stdDeviation="2.4"
          />
        </filter>
      </defs>

      <g
        fill="url(#a48-cloud-back-fill)"
        filter="url(#a48-cloud-back-soft)"
      >
        <ellipse
          cx="168"
          cy="174"
          rx="132"
          ry="54"
        />

        <ellipse
          cx="274"
          cy="142"
          rx="116"
          ry="83"
        />

        <ellipse
          cx="382"
          cy="113"
          rx="118"
          ry="103"
        />

        <ellipse
          cx="493"
          cy="145"
          rx="124"
          ry="82"
        />

        <ellipse
          cx="585"
          cy="176"
          rx="112"
          ry="52"
        />

        <rect
          x="145"
          y="163"
          width="458"
          height="61"
          rx="31"
        />
      </g>
    </svg>
  </div>


  <!-- ======================================================
       FRONT CLOUD
       Smaller distant cloud
       ====================================================== -->

  <div
    class="
      weather-atmosphere__cloud
      weather-atmosphere__cloud--front
    "
  >
    <svg
      class="weather-atmosphere__cloud-svg"
      viewBox="0 0 620 230"
      role="presentation"
      focusable="false"
      aria-hidden="true"
    >
      <defs>
        <linearGradient
          id="a48-cloud-front-fill"
          x1="0"
          y1="0"
          x2="0"
          y2="1"
        >
          <stop
            offset="0%"
            stop-color="#ffffff"
            stop-opacity="0.91"
          />

          <stop
            offset="62%"
            stop-color="#e5ecee"
            stop-opacity="0.88"
          />

          <stop
            offset="100%"
            stop-color="#9eb2ba"
            stop-opacity="0.72"
          />
        </linearGradient>

        <filter
          id="a48-cloud-front-soft"
          x="-15%"
          y="-20%"
          width="130%"
          height="150%"
        >
          <feGaussianBlur
            stdDeviation="2"
          />
        </filter>
      </defs>

      <g
        fill="url(#a48-cloud-front-fill)"
        filter="url(#a48-cloud-front-soft)"
      >
        <ellipse
          cx="138"
          cy="159"
          rx="105"
          ry="45"
        />

        <ellipse
          cx="229"
          cy="132"
          rx="94"
          ry="68"
        />

        <ellipse
          cx="315"
          cy="102"
          rx="96"
          ry="88"
        />

        <ellipse
          cx="405"
          cy="132"
          rx="101"
          ry="68"
        />

        <ellipse
          cx="489"
          cy="160"
          rx="98"
          ry="43"
        />

        <rect
          x="120"
          y="151"
          width="390"
          height="55"
          rx="28"
        />
      </g>
    </svg>
  </div>



  <!-- ======================================================
       THIRD CLOUD
       Small distant open-sky cloud
       R71F6Q4C
       ====================================================== -->

  <div
    class="
      weather-atmosphere__cloud
      weather-atmosphere__cloud--third
    "
  >
    <svg
      class="weather-atmosphere__cloud-svg"
      viewBox="0 0 620 230"
      role="presentation"
      focusable="false"
      aria-hidden="true"
    >
      <defs>
        <linearGradient
          id="r71f6q4c-cloud-third-fill"
          x1="0"
          y1="0"
          x2="0"
          y2="1"
        >
          <stop
            offset="0%"
            stop-color="rgba(255,255,255,0.92)"
          />
          <stop
            offset="58%"
            stop-color="rgba(235,241,244,0.78)"
          />
          <stop
            offset="100%"
            stop-color="rgba(203,215,222,0.58)"
          />
        </linearGradient>

        <filter
          id="r71f6q4c-cloud-third-soft"
          x="-15%"
          y="-20%"
          width="130%"
          height="150%"
        >
          <feGaussianBlur
            stdDeviation="2.2"
          />
        </filter>
      </defs>

      <g
        fill="url(#r71f6q4c-cloud-third-fill)"
        filter="url(#r71f6q4c-cloud-third-soft)"
      >
        <ellipse
          cx="138"
          cy="159"
          rx="105"
          ry="45"
        />

        <ellipse
          cx="225"
          cy="132"
          rx="92"
          ry="67"
        />

        <ellipse
          cx="315"
          cy="151"
          rx="126"
          ry="58"
        />

        <ellipse
          cx="422"
          cy="159"
          rx="112"
          ry="47"
        />

        <ellipse
          cx="495"
          cy="169"
          rx="78"
          ry="35"
        />
      </g>
    </svg>
  </div>

  <div class="weather-atmosphere__rain"></div>

  <div class="weather-atmosphere__veil"></div>
</div>

<!-- MATO R71E2 HEADER-AWARE START -->

<script is:inline>
  (() => {

    const ROOT_SELECTOR =
      ".weather-atmosphere";

    const HEADER_SELECTOR =
      ".header";

    let rafId = 0;


    function updateMatoScenicViewport() {

      cancelAnimationFrame(rafId);

      rafId =
        requestAnimationFrame(() => {

          const atmosphere =
            document.querySelector(
              ROOT_SELECTOR
            );

          if (!atmosphere) {
            return;
          }


          /*
           * Desktop only.
           *
           * Mobile keeps the existing
           * 100vh geometry.
           */

          if (
            window.matchMedia(
              "(max-width: 768px)"
            ).matches
          ) {

            atmosphere.style.setProperty(
              "--mato-scenic-top",
              "0px"
            );

            atmosphere.style.setProperty(
              "--mato-scenic-height",
              "100vh"
            );

            return;
          }


          const header =
            document.querySelector(
              HEADER_SELECTOR
            );


          /*
           * We use the actual rendered Header bottom,
           * not a hard-coded 80px value.
           *
           * Example from approved R71C4:
           *
           * viewport     1870 x 919
           * headerBottom 80px
           *
           * scenic       1870 x 839
           */

          const headerBottom =
            header
              ? Math.max(
                  0,
                  Math.round(
                    header
                      .getBoundingClientRect()
                      .bottom
                  )
                )
              : 0;


          const scenicHeight =
            Math.max(
              1,
              window.innerHeight -
              headerBottom
            );


          atmosphere.style.setProperty(
            "--mato-scenic-top",
            `${headerBottom}px`
          );

          atmosphere.style.setProperty(
            "--mato-scenic-height",
            `${scenicHeight}px`
          );
        });
    }


    /*
     * Initial page load
     */

    if (
      document.readyState ===
      "loading"
    ) {

      document.addEventListener(
        "DOMContentLoaded",
        updateMatoScenicViewport,
        {
          once: true
        }
      );

    } else {

      updateMatoScenicViewport();
    }


    /*
     * Astro ClientRouter route changes.
     */

    document.addEventListener(
      "astro:page-load",
      updateMatoScenicViewport
    );


    /*
     * Recalculate when monitor/browser dimensions change.
     */

    window.addEventListener(
      "resize",
      updateMatoScenicViewport,
      {
        passive: true
      }
    );


    /*
     * Header geometry may settle after fonts/layout.
     */

    window.addEventListener(
      "load",
      updateMatoScenicViewport,
      {
        once: true
      }
    );


    /*
     * Expose read-only diagnostic helper.
     */

    window.MatoScenicViewport = {

      update:
        updateMatoScenicViewport,

      status() {

        const atmosphere =
          document.querySelector(
            ROOT_SELECTOR
          );

        const header =
          document.querySelector(
            HEADER_SELECTOR
          );

        const sky =
          document.querySelector(
            ".weather-atmosphere__sky"
          );

        const headerRect =
          header
            ? header.getBoundingClientRect()
            : null;

        const skyStyle =
          sky
            ? getComputedStyle(sky)
            : null;

        const result = {

          viewport:
            `${window.innerWidth} × ${window.innerHeight}`,

          headerBottom:
            headerRect
              ? `${Math.round(headerRect.bottom)}px`
              : "0px",

          scenicTop:
            atmosphere
              ? getComputedStyle(
                  atmosphere
                ).getPropertyValue(
                  "--mato-scenic-top"
                ).trim()
              : null,

          scenicHeight:
            atmosphere
              ? getComputedStyle(
                  atmosphere
                ).getPropertyValue(
                  "--mato-scenic-height"
                ).trim()
              : null,

          backgroundSize:
            skyStyle
              ? skyStyle.backgroundSize
              : null,

          backgroundPosition:
            skyStyle
              ? skyStyle.backgroundPosition
              : null,

          phase:
            atmosphere
              ? atmosphere.dataset.weatherPhase
              : null,

          weather:
            atmosphere
              ? atmosphere.dataset.weatherKind
              : null
        };

        console.table(
          [result]
        );

        return result;
      }
    };

  })();
</script>

<!-- MATO R71E2 HEADER-AWARE END -->


