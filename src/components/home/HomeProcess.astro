---
import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";
import "../../styles/home-process.css";

const t = getCurrentLanguage(
  Astro.url.pathname
);

const content = t.processHome;
---

<section class="home-process">

  <div class="container">

    <!-- ==============================
         SECTION HEADING
         ============================== -->

    <div class="home-process-heading">

      <span class="home-process-tag">
        {content.tag}
      </span>

      <h2>
        {content.title}
      </h2>

    </div>


    <!-- ==============================
         PROCESS FLOW
         ============================== -->

              <div class="home-process-flow">

                    {
                      content.steps.map((step, index) => (

                        <div class="home-process-step">

                          <div class="home-process-icon" aria-hidden="true">

                {index === 0 && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 21V11" />
                    <path d="M12 14C8.5 14 6 11.5 6 8c3.5 0 6 2.5 6 6Z" />
                    <path d="M12 11c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6Z" />
                  </svg>
                )}


                {index === 1 && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 21V8" />
                    <path d="M12 13c-3.5 0-6-2.2-6-5.5 3.5 0 6 2.2 6 5.5Z" />
                    <path d="M12 9c0-3.3 2.5-5.5 6-5.5 0 3.3-2.5 5.5-6 5.5Z" />
                    <path d="M9 18h6" />
                  </svg>
                )}


                {index === 2 && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="3.2" />
                    <path d="M12 2.8v2" />
                    <path d="M12 19.2v2" />
                    <path d="m4.9 4.9 1.4 1.4" />
                    <path d="m17.7 17.7 1.4 1.4" />
                    <path d="M2.8 12h2" />
                    <path d="M19.2 12h2" />
                    <path d="m4.9 19.1 1.4-1.4" />
                    <path d="m17.7 6.3 1.4-1.4" />
                  </svg>
                )}


                {index === 3 && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 12.5 11.2 15 16 9.5" />
                    <circle cx="12" cy="12" r="8.5" />
                  </svg>
                )}


                {index === 4 && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 7.5h14v11H5z" />
                    <path d="M8 7.5V5h8v2.5" />
                    <path d="M9 12h6" />
                    <path d="M9 15h4" />
                  </svg>
                )}


                {index === 5 && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 12h13" />
                    <path d="m13 8 4 4-4 4" />
                    <path d="M4 7h5" />
                    <path d="M4 17h5" />
                  </svg>
                )}

              </div>

            <div class="home-process-step-content">

              <span class="home-process-number">
                {String(index + 1).padStart(2, "0")}
              </span>

              <h3>
                {step.title}
              </h3>

              <p>
                {step.description}
              </p>

            </div>


            {
              index < content.steps.length - 1 && (

                <div
                  class="home-process-arrow"
                  aria-hidden="true"
                >
                  →
                </div>

              )
            }

          </div>

        ))
      }

    </div>

  </div>

</section>