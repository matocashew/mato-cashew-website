---
import SectionTitle from "../SectionTitle.astro";
import KnowledgeArticleCard from "../knowledge/KnowledgeArticleCard.astro";

import { knowledgeService } from "../../services/knowledgeService";
import { getKnowledgeTranslations } from "../../i18n/knowledge";

const lang =
  Astro.url.pathname.startsWith("/km/")
    ? "km"
    : "en";

const t = getKnowledgeTranslations(lang);

const articles =
  (await knowledgeService.getAll(lang))
  .sort(
    (a, b) =>
      b.publishedAt.getTime() -
      a.publishedAt.getTime()
  )
  .slice(0, 3);
---

{
  articles.length > 0 && (
    <section
      class="home-knowledge"
      aria-labelledby="home-knowledge-title"
    >
      <div class="container">

        <div class="home-knowledge-header">
          <SectionTitle
            tag={t.homeTag}
            title={t.homeTitle}
          />

          <p class="home-knowledge-description">
            {t.homeDescription}
          </p>
        </div>

        <div class="home-knowledge-grid">
          {
            articles.map((article) => (
              <KnowledgeArticleCard
                article={article}
                lang={lang}
              />
            ))
          }
        </div>

        <div class="home-knowledge-action">
          <a
            href={
              lang === "km"
                ? "/km/knowledge/"
                : "/knowledge/"
            }
            class="btn btn-primary"
          >
            {t.exploreKnowledgeCenter}
          </a>
        </div>

      </div>
    </section>
  )
}
