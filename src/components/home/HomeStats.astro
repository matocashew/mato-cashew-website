---
import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";
import "../../styles/home-stats.css";

const t = getCurrentLanguage(Astro.url.pathname);
const content = t.statsHome;

---

<section class="home-stats">
  <div class="container">

    <div class="home-stats-bar">

      {
        content.items.map((item, index) => (

          <div class="home-stat-item">

            <div class="home-stat-icon" aria-hidden="true">

              {/* 01 — Local Farmers */}
              {index === 0 && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 21V11" />
                  <path d="M12 14C8.5 14 6 11.5 6 8c3.5 0 6 2.5 6 6Z" />
                  <path d="M12 11c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6Z" />
                  <path d="M8 21h8" />
                </svg>
              )}

              {/* 02 — Cambodian Origin */}
              {index === 1 && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 21c4.5-4 7-7.5 7-11a7 7 0 1 0-14 0c0 3.5 2.5 7 7 11Z" />
                  <path d="M12 14V9" />
                  <path d="M12 11.5c-2.2 0-3.7-1.4-3.7-3.5 2.2 0 3.7 1.4 3.7 3.5Z" />
                  <path d="M12 9.5c0-2.1 1.5-3.5 3.7-3.5 0 2.1-1.5 3.5-3.7 3.5Z" />
                </svg>
              )}

              {/* 03 — Years of Experience */}
              {index === 2 && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="9" r="5" />
                  <path d="m9 13-1 8 4-2 4 2-1-8" />
                  <path d="m12 6 .9 1.8 2 .3-1.45 1.4.35 2-1.8-.95-1.8.95.35-2-1.45-1.4 2-.3L12 6Z" />
                </svg>
              )}

              {/* 04 — Countries Served */}
              {index === 3 && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18" />
                  <path d="M12 3c2.4 2.5 3.7 5.5 3.7 9S14.4 18.5 12 21" />
                  <path d="M12 3C9.6 5.5 8.3 8.5 8.3 12s1.3 6.5 3.7 9" />
                </svg>
              )}

            </div>

            <div class="home-stat-content">

              <strong class="home-stat-value">
                {item.value}
              </strong>

              <div class="home-stat-label">
                <span>{item.title}</span>
                <small>{item.description}</small>
              </div>

            </div>

          </div>

        ))
      }

    </div>

  </div>
</section>