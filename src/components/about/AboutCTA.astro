---
import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";
import { getLocalizedPath } from "../../i18n/getLocalizedPath";
import type { Language } from "../../i18n/config";

const t = getCurrentLanguage(
  Astro.url.pathname
);

const language: Language =
  Astro.url.pathname.startsWith("/km")
    ? "km"
    : "en";

const contactPath =
  getLocalizedPath(language, "/contact/");

const wholesalePath =
  getLocalizedPath(language, "/wholesale/");
---

<section class="about-cta">

  <div class="container">

    <div class="about-cta-grid">

      <!-- =========================
           LEFT — CONTENT
      ========================== -->
      <div class="about-cta-content">

        <span class="about-cta-tag">
          {t.about.cta.tag}
        </span>

        <h2>
          {t.about.cta.title}
        </h2>

        <p>
          {t.about.cta.description}
        </p>

        <div class="about-cta-actions">

          <a
            href={contactPath}
            class="btn btn-primary"
          >
            {t.common.contactUs}
          </a>

          <a
            href={wholesalePath}
            class="btn btn-outline"
          >
            {t.about.cta.wholesaleButton}
          </a>

        </div>

      </div>


      <!-- =========================
           RIGHT — PRODUCT IMAGE
      ========================== -->
      <div class="about-cta-visual">

        <img
          src="/images/about/about-cta-product.png"
          alt="Mato Cashew premium Cambodian cashew products"
          loading="lazy"
          decoding="async"
        />

      </div>

    </div>

  </div>

</section>