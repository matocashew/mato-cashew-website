---
import SectionTitle from "../SectionTitle.astro";
import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";

const t = getCurrentLanguage(
  Astro.url.pathname
);

const items = [
  {
    number: "01",
    icon: "origin",
    title: t.about.whyChooseUs.premiumOrigin.title,
    description:
      t.about.whyChooseUs.premiumOrigin.description,
  },
  {
    number: "02",
    icon: "processing",
    title: t.about.whyChooseUs.modernProcessing.title,
    description:
      t.about.whyChooseUs.modernProcessing.description,
  },
  {
    number: "03",
    icon: "global",
    title: t.about.whyChooseUs.exportReady.title,
    description:
      t.about.whyChooseUs.exportReady.description,
  },
  {
    number: "04",
    icon: "partnership",
    title: t.about.whyChooseUs.partnership.title,
    description:
      t.about.whyChooseUs.partnership.description,
  },
];
---

<section class="why-choose">

  <div class="container">

    <div class="choose-heading">

      <SectionTitle
        tag={t.about.whyChooseUs.tag}
        title={t.about.whyChooseUs.title}
      />

    </div>

    <div class="choose-grid">

      {
        items.map((item) => {

          return (

            <article class="choose-card">

              <div class="choose-card-top">

                <div
                  class="choose-icon"
                  aria-hidden="true"
                >

                  {
                    item.icon === "origin" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M12 21V10" />
                        <path d="M12 14C8 14 5 11 5 7c4 0 7 1 9 4" />
                        <path d="M12 11c1-4 4-6 8-6 0 4-2 7-8 8" />
                        <path d="M5 21h14" />
                      </svg>
                    )
                  }

                  {
                    item.icon === "processing" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M3 21V10l6 3V9l6 4V7l6 4v10" />
                        <path d="M3 21h18" />
                        <path d="M7 17h2" />
                        <path d="M12 17h2" />
                        <path d="M17 17h2" />
                        <path d="M5 10V4h3v7" />
                      </svg>
                    )
                  }

                  {
                    item.icon === "global" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18" />
                        <path d="M12 3c3 3 4 6 4 9s-1 6-4 9" />
                        <path d="M12 3c-3 3-4 6-4 9s1 6 4 9" />
                      </svg>
                    )
                  }

                  {
                    item.icon === "partnership" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M8 12l3 3c1 1 2 1 3 0l4-4" />
                        <path d="M3 8l4-3 5 3" />
                        <path d="M21 8l-4-3-5 3" />
                        <path d="M3 8l5 7c1 1 2 2 4 3" />
                        <path d="M21 8l-4 6" />
                      </svg>
                    )
                  }

                </div>

                <span class="choose-number">
                  {item.number}
                </span>

              </div>

              <div class="choose-content">

                <h3>
                  {item.title}
                </h3>

                <p>
                  {item.description}
                </p>

              </div>

              <div
                class="choose-card-line"
                aria-hidden="true"
              ></div>

            </article>

          );

        })
      }

    </div>

  </div>

</section>