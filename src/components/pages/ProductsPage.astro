---
import type { CollectionEntry } from "astro:content";

import ProductsHero from "../products/ProductsHero.astro";
import TrustBar from "../TrustBar.astro";
import ScenicHeroShell from "../layout/ScenicHeroShell.astro";
import ProductIntro from "../products/ProductIntro.astro";
import ProductGrid from "../products/ProductGrid.astro";
import PackagingOptions from "../products/PackagingOptions.astro";
import ProductSpecifications from "../products/ProductSpecifications.astro";
import ProductFAQ from "../products/ProductFAQ.astro";
import ProductsCTA from "../products/ProductsCTA.astro";

interface Props {
  products: CollectionEntry<"products">[];
  language: "en" | "km";
}

const { products, language }: Props = Astro.props;
---

<ScenicHeroShell variant="products">
  <ProductsHero />
  <TrustBar />
</ScenicHeroShell>

<!-- K86T18-UNIFIED-PRODUCTS-OUTER-CARD -->
<div class="products-unified-outer-card">

  <ProductIntro />

  <section
    id="products"
    class="products-page-grid"
  >
    <div class="container">

      <ProductGrid
        products={products}
        language={language}
      />

    </div>
  </section>

</div>
<!-- K86T18-UNIFIED-PRODUCTS-OUTER-CARD-END -->

<PackagingOptions />

<ProductSpecifications />

<ProductFAQ />

<ProductsCTA />

