---
import ScenicHeroShell from "../layout/ScenicHeroShell.astro";

import AboutHero from "../about/AboutHero.astro";
import TrustBar from "../TrustBar.astro";
import CompanyStory from "../about/CompanyStory.astro";
import MissionVision from "../about/MissionVision.astro";
import CoreValues from "../about/CoreValues.astro";
import OurProcess from "../about/OurProcess.astro";
import QualityStandards from "../about/QualityStandards.astro";
import WhyChooseUs from "../about/WhyChooseUs.astro";
import AboutCTA from "../about/AboutCTA.astro";

import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";

const t = getCurrentLanguage(
  Astro.url.pathname
);
---

<ScenicHeroShell variant="about">

  <AboutHero
    tag={t.about.pageHero.tag}
    title={t.about.pageHero.title}
    description={t.about.pageHero.description}
    primaryCta={t.about.pageHero.primaryCta}
    secondaryCta={t.about.pageHero.secondaryCta}
  />

  <TrustBar />

</ScenicHeroShell>

<CompanyStory />

<MissionVision />

<CoreValues />

<OurProcess />

<QualityStandards />

<WhyChooseUs />

<AboutCTA />
