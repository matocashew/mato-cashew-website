---
import PageHero from "../PageHero.astro";
import ContactInfo from "../contact/ContactInfo.astro";
import ContactForm from "../contact/ContactForm.astro";

import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";

const t = getCurrentLanguage(
  Astro.url.pathname
);
---

<PageHero
  title={t.contact.hero.title}
  description={t.contact.hero.description}
/>

<section class="contact-page">

  <div class="container contact-grid">

    <ContactInfo />

    <div class="contact-form-column">
      <ContactForm />
    </div>

  </div>

</section>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>