---
import Header from "../Header.astro";
import Hero from "../Hero.astro";
import TrustBar from "../TrustBar.astro";
import Products from "../Products.astro";
import HomeKnowledge from "../home/HomeKnowledge.astro";
import HomeWhyChooseUs from "../home/HomeWhyChooseUs.astro";
import HomeProcess from "../home/HomeProcess.astro";
import HomeStats from "../home/HomeStats.astro";
import HomeTestimonials from "../home/HomeTestimonials.astro";
import HomeWholesaleCTA from "../home/HomeWholesaleCTA.astro";
import Footer from "../Footer.astro";

import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";

const t = getCurrentLanguage(Astro.url.pathname);
---

<Header />

<main>

  <div class="home-scenic-canvas">

    <!-- B7.14B ? NEW HERO VISUAL STACK -->
    <div
      class="hero-v2-layer hero-v2-layer--base"
      aria-hidden="true"
    ></div>

    <div
      class="hero-v2-layer hero-v2-layer--branch"
      aria-hidden="true"
    ></div>


    <!-- B7.11E ? Natural Wind foreground layers -->

    <div
      class="hero-wind-layer hero-wind-layer--leaves"
      aria-hidden="true"
    ></div>

    <div
      class="hero-wind-layer hero-wind-layer--flowers"
      aria-hidden="true"
    ></div>

    <div
      class="hero-wind-layer hero-wind-layer--fruits"
      aria-hidden="true"
    ></div>

    <Hero />

  <TrustBar />

  <Products />

  <HomeWhyChooseUs />

  <HomeProcess />

  <HomeStats />
  </div>

  <HomeKnowledge />

  <HomeTestimonials />
  
  <HomeWholesaleCTA content={t.wholesaleHome} />

</main>

<Footer />