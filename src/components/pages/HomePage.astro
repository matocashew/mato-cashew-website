---
import Header from "../Header.astro";
import Hero from "../Hero.astro";
import TrustBar from "../TrustBar.astro";
import Products from "../Products.astro";
import HomeWhyChooseUs from "../home/HomeWhyChooseUs.astro";
import HomeProcess from "../home/HomeProcess.astro";
import HomeStats from "../home/HomeStats.astro";
import HomeTestimonials from "../home/HomeTestimonials.astro";
import HomeWholesaleCTA from "../home/HomeWholesaleCTA.astro";
import Footer from "../Footer.astro";

import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";

const t = getCurrentLanguage(Astro.url.pathname);
---

<Header />

<main>

  <Hero />

  <TrustBar />

  <Products />

  <HomeWhyChooseUs />

  <HomeProcess />

  <HomeStats />

  <HomeTestimonials />
  
  <HomeWholesaleCTA content={t.wholesaleHome} />

</main>

<Footer />