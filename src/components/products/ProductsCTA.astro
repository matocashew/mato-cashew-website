---
import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";
import { getLocalizedPath } from "../../i18n/getLocalizedPath";

import type { Language } from "../../i18n/config";

const t = getCurrentLanguage(Astro.url.pathname);

const language: Language =
  Astro.url.pathname.startsWith("/km")
    ? "km"
    : "en";

const contactPath =
  getLocalizedPath(language, "/contact");

const wholesalePath =
  getLocalizedPath(language, "/wholesale");

const inquiryContactPath =
  `${contactPath}?inquiry=${encodeURIComponent(
    "Wholesale Inquiry"
  )}`;
---

<section class="products-cta">

  <div class="container">

    <div class="products-cta-box">

      <span class="cta-tag">
        {t.products.cta.tag}
      </span>

      <h2>
        {t.products.cta.title}
      </h2>

      <p>
        {t.products.cta.description}
      </p>

      <div class="cta-features">

        {
          t.products.cta.features.map((feature, index) => (
            <span class="k86t13-feature">
              <span class="k86t13-feature-icon" aria-hidden="true">
                {
                  index === 0 ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" />
                      <path d="m4 7.5 8 4.5 8-4.5M12 12v9" />
                    </svg>
                  ) : index === 1 ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="8" r="3" />
                      <circle cx="17" cy="9" r="2" />
                      <path d="M3 20v-2a6 6 0 0 1 12 0v2H3Z" />
                      <path d="M16 15a4 4 0 0 1 5 4v1h-4" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 11 11 3h9v9l-8 8a2 2 0 0 1-3 0l-6-6a2 2 0 0 1 0-3Z" />
                      <circle cx="16" cy="8" r="1" />
                    </svg>
                  )
                }
              </span>
              <span class="k86t13-feature-label">{feature}</span>
            </span>
          ))
        }

      </div>

      <div class="cta-buttons">

        <a
          href={inquiryContactPath}
          class="btn btn-primary"
        >
          {t.products.cta.primaryButton}
          <span class="k86t13-arrow" aria-hidden="true">→</span>
        </a>

        <a
          href={wholesalePath}
          class="btn btn-outline"
        >
          {t.products.cta.secondaryButton}
          <span class="k86t13-arrow" aria-hidden="true">→</span>
        </a>

      </div>

    </div>

  </div>

</section>