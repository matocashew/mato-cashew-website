---
import type { CollectionEntry } from "astro:content";

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;


/* =========================================================
   LANGUAGE
   ========================================================= */

const isKhmer =
  Astro.url.pathname.startsWith("/km/");


/* =========================================================
   LOCALIZED PRODUCT DATA
   Khmer → fallback to English
   ========================================================= */

const productTitle =
  isKhmer
    ? product.data.titleKm ?? product.data.title
    : product.data.title;


const productDescription =
  isKhmer
    ? product.data.descriptionKm ?? product.data.description
    : product.data.description;


const categoryLabel =
  isKhmer
    ? product.data.categoryKm ??
      (
        product.data.category === "Retail"
          ? "លក់រាយ"
          : product.data.category === "Wholesale"
            ? "លក់ដុំ"
            : product.data.category
      )
    : product.data.category;


const packagingLabel =
  isKhmer
    ? product.data.packagingKm ?? product.data.packaging
    : product.data.packaging;


/* =========================================================
   UI LABELS
   ========================================================= */

const labels = isKhmer
  ? {
      sku: "លេខកូដផលិតផល",
      weight: "ទម្ងន់",
      packaging: "ការវេចខ្ចប់",
      category: "ប្រភេទ",
      inquiry:
        "យើងស្វាគមន៍ការសាកសួរព័ត៌មានសម្រាប់ការបញ្ជាទិញ និងអាជីវកម្ម។ ទំហំការបញ្ជាទិញ និងតម្រូវការផ្សេងៗអាចពិភាក្សាបានតាមតម្រូវការរបស់លោកអ្នក។",
      quote: "សាកសួរព័ត៌មាន",
      contact: "ទាក់ទងយើង",
    }
  : {
      sku: "SKU",
      weight: "Weight",
      packaging: "Packaging",
      category: "Category",
      inquiry:
        "Wholesale and business inquiries are welcome. Product availability and order requirements can be discussed based on your needs.",
      quote: "Request a Quote",
      contact: "Contact Us",
    };


/* =========================================================
   CONTACT URL
   ========================================================= */

const contactUrl =
  isKhmer
    ? "/km/contact/"
    : "/contact/";
---

<section class="product-details">

  <div class="container">

    <div class="product-details-shell">

      <div class="product-details-grid">

        <!-- =================================================
             PRODUCT VISUAL
             ================================================= -->

        <div class="product-visual">

          <div class="product-main-image">

            <img
              src={product.data.image}
              alt={productTitle}
              width="700"
              height="700"
              loading="eager"
              decoding="async"
            />

          </div>


          {
            product.data.gallery &&
            product.data.gallery.length > 0 && (

              <div
                class="product-thumbnails"
                aria-label={
                  isKhmer
                    ? "រូបភាពផលិតផល"
                    : "Product images"
                }
              >

                <button
                  class="product-thumbnail active"
                  type="button"
                  aria-label={productTitle}
                >
                  <img
                    src={product.data.image}
                    alt=""
                    width="100"
                    height="100"
                    loading="lazy"
                  />
                </button>


                {
                  product.data.gallery
                    .filter(
                      (image) =>
                        image !== product.data.image
                    )
                    .slice(0, 3)
                    .map((image) => (

                      <button
                        class="product-thumbnail"
                        type="button"
                        aria-label={productTitle}
                      >
                        <img
                          src={image}
                          alt=""
                          width="100"
                          height="100"
                          loading="lazy"
                        />
                      </button>

                    ))
                }

              </div>

            )
          }

        </div>


        <!-- =================================================
             PRODUCT INFORMATION
             ================================================= -->

        <div class="product-info">

          <span class="product-category">
            {categoryLabel}
          </span>


          <h2>
            {productTitle}
          </h2>


          <p class="product-description">
            {productDescription}
          </p>


          <!-- Product Meta -->

          <div class="product-meta">

            <div class="product-meta-card">

              <span class="meta-icon" aria-hidden="true">
                #
              </span>

              <div>
                <strong>{labels.sku}</strong>
                <span>{product.data.sku}</span>
              </div>

            </div>


            <div class="product-meta-card">

              <span class="meta-icon" aria-hidden="true">
                ⚖
              </span>

              <div>
                <strong>{labels.weight}</strong>
                <span>{product.data.weight}</span>
              </div>

            </div>


            <div class="product-meta-card">

              <span class="meta-icon" aria-hidden="true">
                □
              </span>

              <div>
                <strong>{labels.packaging}</strong>
                <span>{packagingLabel}</span>
              </div>

            </div>


            <div class="product-meta-card">

              <span class="meta-icon" aria-hidden="true">
                ◉
              </span>

              <div>
                <strong>{labels.category}</strong>
                <span>{categoryLabel}</span>
              </div>

            </div>

          </div>


          <!-- Inquiry -->

          <div class="product-inquiry">

            <span
              class="product-inquiry-check"
              aria-hidden="true"
            >
              ✓
            </span>

            <p>
              {labels.inquiry}
            </p>

          </div>


          <!-- Actions -->

          <div class="product-actions">

            <a
              href={contactUrl}
              class="btn btn-primary product-primary-action"
            >
              {labels.quote}
            </a>


            <a
              href={contactUrl}
              class="btn product-secondary-action"
            >
              {labels.contact}
            </a>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<script>
  function initProductGallery() {

    const mainImage =
      document.querySelector(
        ".product-main-image img"
      ) as HTMLImageElement | null;

    const thumbnails =
      document.querySelectorAll<HTMLButtonElement>(
        ".product-thumbnail"
      );

    if (!mainImage || thumbnails.length === 0) {
      return;
    }

    thumbnails.forEach((thumbnail) => {

      thumbnail.addEventListener("click", () => {

        const image =
          thumbnail.querySelector(
            "img"
          ) as HTMLImageElement | null;

        if (!image) return;

        mainImage.src = image.src;

        thumbnails.forEach((item) => {
          item.classList.remove("active");
        });

        thumbnail.classList.add("active");

      });

    });

  }

  initProductGallery();

  document.addEventListener(
    "astro:page-load",
    initProductGallery
  );
</script>