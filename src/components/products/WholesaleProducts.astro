---
import SectionTitle from "../SectionTitle.astro";

const isKhmer = Astro.url.pathname.startsWith("/km");

const content = isKhmer
  ? {
      tag: "សម្រាប់អាជីវកម្ម",
      title: "ការសាកសួរទិញដុំ",
      description:
        "ប្រសិនបើអ្នកកំពុងស្វែងរកផលិតផលគ្រាប់ស្វាយចន្ទីសម្រាប់អាជីវកម្ម សូមទាក់ទងមក Mato Cashew ដើម្បីពិភាក្សាអំពីផលិតផល បរិមាណ និងតម្រូវការវេចខ្ចប់របស់អ្នក។",
      button: "ទាក់ទង Mato Cashew",
    }
  : {
      tag: "For Business",
      title: "Wholesale Inquiries",
      description:
        "Looking for Cambodian cashew products for your business? Contact Mato Cashew to discuss product, quantity, and packaging requirements based on your needs.",
      button: "Contact Mato Cashew",
    };
---

<section class="wholesale-products">
  <div class="container">

    <SectionTitle
      tag={content.tag}
      title={content.title}
    />

    <div class="wholesale-products-grid">

      <article class="bulk-card">

        <p>
          {content.description}
        </p>

        <a
          href={isKhmer ? "/km/contact" : "/contact"}
          class="btn btn-primary"
        >
          {content.button}
        </a>

      </article>

    </div>

  </div>
</section>