---
import SectionTitle from "../SectionTitle.astro";

interface Props {
  applications: string[];
}

const {
  applications = []
} = Astro.props;

const isKhmer =
  Astro.url.pathname.startsWith("/km/");

const tag = isKhmer
  ? "ការប្រើប្រាស់"
  : "Applications";

const title = isKhmer
  ? "ការប្រើប្រាស់ដែលបានណែនាំ"
  : "Recommended Uses";
---

{
  applications.length > 0 && (

    <section class="product-applications">

      <div class="container">

        <SectionTitle
          tag={tag}
          title={title}
        />

        <div class="applications-grid">

          {
            applications.map((item) => (

              <div class="application-card">

                <span
                  class="application-icon"
                  aria-hidden="true"
                >
                  ✓
                </span>

                <h3>
                  {item}
                </h3>

              </div>

            ))
          }

        </div>

      </div>

    </section>

  )
}