---
import SectionTitle from "../SectionTitle.astro";

interface Props {
  specifications: string[];
}

const {
  specifications = []
} = Astro.props;

const isKhmer =
  Astro.url.pathname.startsWith("/km/");

const tag = isKhmer
  ? "ព័ត៌មានផលិតផល"
  : "Product Details";

const title = isKhmer
  ? "ចំណុចសំខាន់ៗនៃផលិតផល"
  : "Product Highlights";
---

{
  specifications.length > 0 && (

    <section class="product-specifications">

      <div class="container">

        <SectionTitle
          tag={tag}
          title={title}
        />

        <ul class="specifications-list">

          {
            specifications.map((item) => (

              <li>
                <span
                  class="specification-check"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M5 12.5L9.2 16.5L19 7"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>

                <span>
                  {item}
                </span>
              </li>

            ))
          }

        </ul>

      </div>

    </section>

  )
}