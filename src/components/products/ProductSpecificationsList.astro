---
import SectionTitle from "../SectionTitle.astro";

interface Props {
  specifications: string[];
}

const {
  specifications = []
} = Astro.props;

const isKhmer =
  Astro.url.pathname.startsWith("/km/");

const tag = isKhmer
  ? "ព័ត៌មានផលិតផល"
  : "Product Details";

const title = isKhmer
  ? "ចំណុចសំខាន់ៗនៃផលិតផល"
  : "Product Highlights";
---

{
  specifications.length > 0 && (

    <section class="product-specifications">

      <div class="container">

        <SectionTitle
          tag={tag}
          title={title}
        />

        <ul class="specifications-list">

          {
            specifications.map((item) => (

              <li>
                <span
                  class="specification-check"
                  aria-hidden="true"
                >
                  ✓
                </span>

                <span>
                  {item}
                </span>
              </li>

            ))
          }

        </ul>

      </div>

    </section>

  )
}