---
import type { CollectionEntry } from "astro:content";

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;


/* =========================================================
   LANGUAGE
   ========================================================= */

const isKhmer =
  Astro.url.pathname.startsWith("/km/");


/* =========================================================
   PRODUCT URL
   trailingSlash: "always"
   ========================================================= */

const productUrl = isKhmer
  ? `/km/products/${product.data.slug}/`
  : `/products/${product.data.slug}/`;


/* =========================================================
   LOCALIZED PRODUCT DATA
   Khmer → fallback to English
   ========================================================= */

const productTitle =
  isKhmer
    ? product.data.titleKm ?? product.data.title
    : product.data.title;


const productDescription =
  isKhmer
    ? product.data.descriptionKm ?? product.data.description
    : product.data.description;


const categoryLabel =
  isKhmer
    ? product.data.categoryKm ??
      (
        product.data.category === "Retail"
          ? "លក់រាយ"
          : product.data.category === "Wholesale"
            ? "លក់ដុំ"
            : product.data.category
      )
    : product.data.category;


/* =========================================================
   UI LABELS
   ========================================================= */

const viewDetailsLabel =
  isKhmer
    ? "មើលព័ត៌មានលម្អិត"
    : "View Details";
---

<article class="product-card">

  <!-- Product Image -->

  <a
    href={productUrl}
    class="product-image"
    aria-label={productTitle}
  >
    <img
      src={product.data.image}
      alt={productTitle}
      width="600"
      height="600"
      loading="lazy"
      decoding="async"
    />
  </a>


  <!-- Product Content -->

  <div class="product-content">

    <span class="product-category">
      {categoryLabel}
    </span>


    <h3>
      <a href={productUrl}>
        {productTitle}
      </a>
    </h3>


    <p>
      {productDescription}
    </p>


    <div class="product-footer">

      <span class="product-weight">
        {product.data.weight}
      </span>


      <a
        href={productUrl}
        class="product-link"
        aria-label={`${viewDetailsLabel}: ${productTitle}`}
      >
        {viewDetailsLabel}
      </a>

    </div>

  </div>

</article>