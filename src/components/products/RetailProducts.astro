---
import SectionTitle from "../SectionTitle.astro";
import ProductCard from "../ProductCard.astro";

import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";
import { getProductsByCategory } from "../../services/productService";

const t = getCurrentLanguage(Astro.url.pathname);

const products = await getProductsByCategory("Retail");

const isKhmer = Astro.url.pathname.startsWith("/km");

const basePath = isKhmer
  ? "/km/products"
  : "/products";

const viewLabel = isKhmer
  ? "មើលព័ត៌មានលម្អិត"
  : "View Details";
---

<section class="retail-products">

  <div class="container">

    <SectionTitle
      tag={t.products.retail.tag}
      title={t.products.retail.title}
    />

    <div class="products-grid">

      {
        products.map((product) => (

          <ProductCard
            image={product.data.image}
            title={product.data.title}
            description={product.data.description}
            weight={product.data.weight}
            badge={product.data.category}
            href={`${basePath}/${product.data.slug}`}
            linkLabel={viewLabel}
          />

        ))
      }

    </div>

  </div>

</section>