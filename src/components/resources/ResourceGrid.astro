---
import type { CollectionEntry } from "astro:content";
import type { Language } from "../../i18n/config";
import ResourceCard from "./ResourceCard.astro";

interface Props {
  resources?: CollectionEntry<"resources">[];
  language?: Language;
}

const {
  resources = [],
  language = "en"
} = Astro.props;
---

{
  resources.length > 0 && (

    <section class="resources-grid-section">

      <div class="resources-grid">

        {
          resources.map((resource) => (

            <ResourceCard
              resource={resource}
              language={language}
            />

          ))
        }

      </div>

    </section>

  )
}