---
import type { CollectionEntry } from "astro:content";
import type { Language } from "../../i18n/config";
import { getLocalizedPath } from "../../i18n/getLocalizedPath";

interface Props {
  resource: CollectionEntry<"resources">;
  language?: Language;
}

const {
  resource,
  language = "en"
} = Astro.props;

const resourcePath =
  getLocalizedPath(
    language,
    `/resources/${resource.data.slug}`
  );
---

<article class="resource-card">

  <a
    href={resourcePath}
    class="resource-card__link"
  >

    <img
      src={resource.data.image}
      alt={resource.data.title}
      loading="lazy"
    />

    <div class="resource-card__content">

      <span class="resource-card__category">
        {resource.data.category}
      </span>

      <h3>
        {resource.data.title}
      </h3>

      <p>
        {resource.data.description}
      </p>

    </div>

    <div class="resource-card__footer">

      <small>
        {resource.data.publishDate.toLocaleDateString(
          language === "km" ? "km-KH" : "en-US"
        )}
      </small>

    </div>

  </a>

</article>