---
import type { Language } from "../../i18n/config";

interface Props {
  category: string;
  author: string;
  publishDate: Date;
  readingTime?: number;
  tags?: string[];
  lang?: Language;
}

const {
  category,
  author,
  publishDate,
  readingTime,
  tags = [],
  lang = "en"
} = Astro.props;

const locale = lang === "km" ? "km-KH" : "en-US";

const labels = lang === "km"
  ? {
      category: "ប្រភេទ",
      author: "អ្នកនិពន្ធ",
      published: "ចេញផ្សាយ",
      readingTime: "រយៈពេលអាន",
      minute: "នាទី"
    }
  : {
      category: "Category",
      author: "Author",
      published: "Published",
      readingTime: "Reading Time",
      minute: "min"
    };

const formattedDate =
  publishDate.toLocaleDateString(locale);
---

<div class="resource-meta">

  <div class="resource-meta__info">

    <span>
      <strong>{labels.category}:</strong>
      {category}
    </span>

    <span>
      <strong>{labels.author}:</strong>
      {author}
    </span>

    <span>
      <strong>{labels.published}:</strong>
      {formattedDate}
    </span>

    {
      readingTime && (
        <span>
          <strong>{labels.readingTime}:</strong>
          {readingTime} {labels.minute}
        </span>
      )
    }

  </div>

  {
    tags.length > 0 && (

      <div class="resource-meta__tags">

        {
          tags.map(tag => (

            <span class="tag">

              {tag}

            </span>

          ))
        }

      </div>

    )
  }

</div>