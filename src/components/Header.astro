---
import { getCurrentLanguage } from "../i18n/getCurrentLanguage";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const currentPath = Astro.url.pathname;

const isKhmer = currentPath.startsWith("/km");

const t = getCurrentLanguage(currentPath);

const homePath = isKhmer ? "/km/" : "/";
const aboutPath = isKhmer ? "/km/about" : "/about";
const productsPath = isKhmer ? "/km/products" : "/products";
const resourcesPath = isKhmer ? "/km/resources" : "/resources";
const galleryPath = isKhmer ? "/km/gallery" : "/gallery";
const wholesalePath = isKhmer ? "/km/wholesale" : "/wholesale";
const contactPath = isKhmer ? "/km/contact" : "/contact";

const brandName = isKhmer
  ? "ចន្ទីមាតុភូមិ"
  : "Mato Cashew";
---

<header class="header">

  <div class="container header-wrapper">

    <a
      href={homePath}
      class="logo"
      aria-label={`${brandName} Home`}
    >

      <img
        src="/images/logo/logo.png"
        alt={`${brandName} Logo`}
      />

    </a>

    <nav aria-label={isKhmer ? "ម៉ឺនុយមេ" : "Main navigation"}>

      <button
        type="button"
        aria-controls="main-menu"
        class="menu-toggle"
        aria-label={isKhmer ? "បើក ឬបិទម៉ឺនុយ" : "Toggle Menu"}
        aria-expanded="false"
      >
        ☰
      </button>

      <ul id="main-menu" class="nav-menu">

        <li>
          <a
            href={homePath}
            class={
              currentPath === "/" ||
              currentPath === "/km" ||
              currentPath === "/km/"
                ? "active"
                : ""
            }
          >
            {t.nav.home}
          </a>
        </li>

        <li>
          <a
            href={aboutPath}
            class={currentPath === aboutPath ? "active" : ""}
          >
            {t.nav.about}
          </a>
        </li>

        <li>
          <a
            href={productsPath}
            class={
              currentPath === productsPath ||
              currentPath.startsWith(`${productsPath}/`)
                ? "active"
                : ""
            }
          >
            {t.nav.products}
          </a>
        </li>

        <li>
          <a
            href={resourcesPath}
            class={
              currentPath === resourcesPath ||
              currentPath.startsWith(`${resourcesPath}/`)
                ? "active"
                : ""
            }
          >
            {t.nav.resources}
          </a>
        </li>

        <li>
          <a
            href={galleryPath}
            class={currentPath === galleryPath ? "active" : ""}
          >
            {t.nav.gallery}
          </a>
        </li>

        <li>
          <a
            href={wholesalePath}
            class={currentPath === wholesalePath ? "active" : ""}
          >
            {t.nav.wholesale}
          </a>
        </li>

        <li>
          <a
            href={contactPath}
            class={currentPath === contactPath ? "active" : ""}
          >
            {t.nav.contact}
          </a>
        </li>

      </ul>

    </nav>

    <LanguageSwitcher />

  </div>

</header>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const header = document.querySelector(".header");

  if (header) {

    window.addEventListener("scroll", () => {

      if (window.scrollY > 40) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }

    });

  }

  const menuToggle = document.querySelector(".menu-toggle");
  const navMenu = document.querySelector(".nav-menu");

  if (menuToggle && navMenu) {

    menuToggle.addEventListener("click", () => {

      navMenu.classList.toggle("open");

      const expanded =
        menuToggle.getAttribute("aria-expanded") === "true";

      menuToggle.setAttribute(
        "aria-expanded",
        (!expanded).toString()
      );

      menuToggle.textContent = expanded ? "☰" : "✕";

    });

  }

  const navLinks = document.querySelectorAll(".nav-menu a");

  navLinks.forEach((link) => {

    link.addEventListener("click", () => {

      if (navMenu) {
        navMenu.classList.remove("open");
      }

      if (menuToggle) {
        menuToggle.textContent = "☰";
        menuToggle.setAttribute("aria-expanded", "false");
      }

    });

  });

});
</script>

<script type="module">
  import { initLanguageSwitcher }
    from "../scripts/language-switcher.ts";

  document.addEventListener(
    "DOMContentLoaded",
    initLanguageSwitcher
  );
</script>