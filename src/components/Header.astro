---
import { getCurrentLanguage }
  from "../i18n/getCurrentLanguage";

import LanguageSwitcher
  from "./LanguageSwitcher.astro";

import MegaMenuIcon
  from "./navigation/MegaMenuIcon.astro";

import { navigationService }
  from "@services/navigationService";

import type { NavigationLanguage }
  from "@models/navigation";


const currentPath =
  Astro.url.pathname;

const isKhmer =
  currentPath === "/km" ||
  currentPath.startsWith("/km/");

const language: NavigationLanguage =
  isKhmer
    ? "km"
    : "en";

const t =
  getCurrentLanguage(currentPath);


/*
 * Navigation V2
 *
 * Resolve the complete navigation tree
 * before rendering the Header.
 */
const menuItems =
  navigationService.getLocalizedMenu(
    language,
    t.nav
  );


/*
 * Home route is also used by
 * the Mato Cashew brand lockup.
 */
const homeItem =
  menuItems.find(
    item => item.id === "home"
  );

const homePath =
  homeItem?.href ??
  (isKhmer ? "/km/" : "/");


const brandName =
  "ចន្ទីមាតុភូមិ — Mato Cashew";
---

<header class="header">

  <div class="container header-wrapper">

    <a
    href={homePath}
    class="logo brand-lockup"
    aria-label={`${brandName} Home`}
  >
    <img
      class="brand-symbol"
      src="/images/logo/logo.png"
      alt=""
      aria-hidden="true"
    />

    <span class="brand-signature" aria-hidden="true">

      <span class="brand-khmer">
        ចន្ទីមាតុភូមិ
      </span>

      <span class="brand-divider"></span>

      <span class="brand-english">
        MATO CASHEW
      </span>

    </span>
  </a>

    <nav aria-label={isKhmer ? "ម៉ឺនុយមេ" : "Main navigation"}>

      <button
        type="button"
        aria-controls="main-menu"
        class="menu-toggle"
        aria-label={isKhmer ? "បើក ឬបិទម៉ឺនុយ" : "Toggle Menu"}
        aria-expanded="false"
      >
        ☰
      </button>

      <ul id="main-menu" class="nav-menu">
        {
          menuItems.map((item) => {
            const hasChildren =
              Boolean(item.children?.length);

            const isActive =
              navigationService.isParentActive(
                item,
                currentPath
              );

            return (
              <li
                class:list={[
                  "nav-item",
                  hasChildren && "has-submenu",
                  item.variant &&
                    `nav-${item.variant}`,
                ]}
              >
              <div class="nav-link-row">
                <a
                  href={item.href}
                  class:list={[
                    "nav-link",
                    isActive && "active",
                  ]}
                  aria-current={
                    navigationService.isActive(
                      item,
                      currentPath
                    )
                      ? "page"
                      : undefined
                  }
                >
                  <span class="nav-label">
                    {item.label}
                  </span>
                </a>

                {
                  hasChildren && (
                    <button
                      type="button"
                      class="submenu-toggle"
                      aria-expanded="false"
                      aria-label={
                        isKhmer
                          ? `បើកម៉ឺនុយរង ${item.label}`
                          : `Open ${item.label} submenu`
                      }
                    >
                      <span
                        class="nav-chevron"
                        aria-hidden="true"
                      >
                        ▾
                      </span>
                    </button>
                  )
                }
              </div>

                {
                  hasChildren &&
                  item.children && (
                    <div class="submenu-panel mega-menu">
                     <div class="mega-menu-inner">

                        <div class="mega-menu-intro">
                          <span class="mega-menu-eyebrow">
                            {item.label}
                          </span>

                          {
                            item.description && (
                              <p class="mega-menu-description">
                                {item.description}
                              </p>
                            )
                          }
                        </div>

                        <div class="mega-menu-grid">
                          {
                            item.children.map(
                              (child) => (
                                <a
                                  href={child.href}
                                  class:list={[
                                    "mega-menu-link",
                                    child.featured &&
                                      "featured",
                                    navigationService
                                      .isActive(
                                        child,
                                        currentPath
                                      ) &&
                                      "active",
                                  ]}
                                >
                                  <MegaMenuIcon
                                    name={child.icon}
                                  />

                                  <span class="mega-menu-link-content">
                                    <span class="mega-menu-link-title">
                                      {child.label}
                                    </span>

                                  {
                                    child.description && (
                                      <span class="mega-menu-link-description">
                                        {child.description}
                                      </span>
                                    )
                                  }
                                  </span>
                                </a>
                              )
                            )
                          }
                        </div>

                      </div>
                    </div>
                  )
                }
              </li>
            );
          })
        }
      </ul>

    </nav>

    <LanguageSwitcher />

  </div>

</header>

<script>
  /**
   * Global scroll handler.
   *
   * Astro bundled scripts execute once, so this listener
   * does not need a custom window flag.
   */
  const updateHeaderScrollState = () => {
    const header =
      document.querySelector<HTMLElement>(".header");

    if (!header) return;

    header.classList.toggle(
      "scrolled",
      window.scrollY > 40
    );
  };

  window.addEventListener(
    "scroll",
    updateHeaderScrollState,
    { passive: true }
  );


  /**
   * Initialize DOM-specific header interactions.
   *
   * astro:page-load runs on the first page
   * and after every ClientRouter navigation.
   */
  function initHeader() {
    const menuToggle =
      document.querySelector<HTMLButtonElement>(
        ".menu-toggle"
      );

    const navMenu =
      document.querySelector<HTMLElement>(
        ".nav-menu"
      );

    /*
     * Apply correct header state immediately.
     */
    updateHeaderScrollState();


    /*
     * Mobile menu
     */
    if (menuToggle && navMenu) {
      menuToggle.addEventListener(
        "click",
        () => {
          const isOpen =
            navMenu.classList.toggle("open");

          menuToggle.setAttribute(
            "aria-expanded",
            String(isOpen)
          );

          menuToggle.textContent =
            isOpen ? "✕" : "☰";
        }
      );
    }

    /*
     * Mobile submenu accordion.
     *
     * Parent navigation links remain normal links.
     * The dedicated submenu button controls only
     * the nested dropdown / mega-menu panel.
     */
    const submenuToggles =
      document.querySelectorAll<HTMLButtonElement>(
        ".submenu-toggle"
      );

    const closeSubmenu = (
      button: HTMLButtonElement
    ) => {
      const navItem =
        button.closest<HTMLElement>(
          ".nav-item"
        );

      if (!navItem) return;

      navItem.classList.remove(
        "submenu-open"
      );

      button.setAttribute(
        "aria-expanded",
        "false"
      );
      clearMegaMenuOcclusion();
    };

    const closeAllSubmenus = (
      except?: HTMLButtonElement
    ) => {
      submenuToggles.forEach(
        (button) => {
          if (button !== except) {
            closeSubmenu(button);
          }
        }
      );
    };

    submenuToggles.forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const navItem =
              button.closest<HTMLElement>(
                ".nav-item"
              );

            if (!navItem) return;

            const willOpen =
              !navItem.classList.contains(
                "submenu-open"
              );

            closeAllSubmenus(button);

            navItem.classList.toggle(
              "submenu-open",
              willOpen
            );

            button.setAttribute(
              "aria-expanded",
              String(willOpen)
            );
            const panel =
              navItem.querySelector<HTMLElement>(
                ":scope > .submenu-panel"
              );

            if (
              willOpen &&
              panel
            ) {
              requestAnimationFrame(() => {
                applyMegaMenuOcclusion(
                  panel
                );
              });
            } else {
              clearMegaMenuOcclusion();
            }
          }
        );
      }
    );
    /* =========================================
       B7.6L2 ? DESKTOP SUBMENU OCCLUSION STATE SYNC

       CSS can keep a submenu visible through:
       - :hover
       - :focus-within
       - .submenu-open

       Occlusion must follow the same states.
       ========================================= */

    const submenuItems =
      document.querySelectorAll<HTMLElement>(
        ".has-submenu"
      );


    const submenuShouldRemainOpen = (
      navItem: HTMLElement
    ): boolean => {

      return (
        navItem.matches(":hover") ||
        navItem.matches(":focus-within") ||
        navItem.classList.contains(
          "submenu-open"
        )
      );
    };


    const applySubmenuOcclusion = (
      navItem: HTMLElement
    ) => {

      if (
        window.innerWidth <= 768
      ) {
        return;
      }

      const panel =
        navItem.querySelector<HTMLElement>(
          ":scope > .submenu-panel"
        );

      if (!panel) return;

      requestAnimationFrame(() => {

        if (
          submenuShouldRemainOpen(
            navItem
          )
        ) {
          applyMegaMenuOcclusion(
            panel
          );
        }
      });
    };


    const releaseSubmenuOcclusion = (
      navItem: HTMLElement
    ) => {

      if (
        window.innerWidth <= 768
      ) {
        return;
      }

      /*
       * Wait until browser hover/focus state
       * has settled before deciding whether
       * the visible submenu has actually closed.
       */
      requestAnimationFrame(() => {

        if (
          submenuShouldRemainOpen(
            navItem
          )
        ) {
          applySubmenuOcclusion(
            navItem
          );

          return;
        }

        clearMegaMenuOcclusion();
      });
    };


    submenuItems.forEach((navItem) => {

      navItem.addEventListener(
        "mouseenter",
        () => {
          applySubmenuOcclusion(
            navItem
          );
        }
      );


      navItem.addEventListener(
        "mouseleave",
        () => {
          releaseSubmenuOcclusion(
            navItem
          );
        }
      );


      navItem.addEventListener(
        "focusin",
        () => {
          applySubmenuOcclusion(
            navItem
          );
        }
      );


      navItem.addEventListener(
        "focusout",
        () => {
          releaseSubmenuOcclusion(
            navItem
          );
        }
      );
    });
    /*
     * Close mobile menu after clicking
     * any navigation link.
     */
    const navLinks =
      document.querySelectorAll<HTMLAnchorElement>(
        ".nav-menu a"
      );

    navLinks.forEach((link) => {
      link.addEventListener(
        "click",
        () => {
          navMenu?.classList.remove("open");
          clearMegaMenuOcclusion();
          if (menuToggle) {
            menuToggle.textContent = "☰";

            menuToggle.setAttribute(
              "aria-expanded",
              "false"
            );
          }
        }
      );
    });
    /*
     * -------------------------------------------------------
     * Local Mega Menu glass occlusion
     *
     * Hide Hero foreground only where
     * the visible submenu overlaps it.
     * -------------------------------------------------------
     */

    const heroForeground =
      document.querySelector<HTMLElement>(
        ".hero-content, .about-hero__content"
      );

    const heroTrust =
      document.querySelector<HTMLElement>(
        ".hero-trust"
      );

    /*
     * Home Stats foreground uses the same
     * local Mega Menu occlusion rectangle.
     */
    const getHomeStatContent = () =>
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".home-stat-content"
        )
      );

    /*
     * Trust Bar foreground participates in the
     * same per-element Mega Menu occlusion system.
     */
    const getTrustItemContent = () =>
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".trust-item__content"
        )
      );

    /*
     * Trust Bar icons participate in the
     * same per-element Mega Menu geometry.
     */
    const getTrustItemIcons = () =>
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".trust-item__icon"
        )
      );

    /*
     * Dedicated Trust Bar surface participates
     * in the same Mega Menu geometry.
     */
    const getTrustBarSurface = () =>
      document.querySelector<HTMLElement>(
        ".trust-bar__surface"
      );


    const clearMegaMenuOcclusion = () => {
      /* PHASE-5M-GLOBAL-OCCLUSION-CLEAR-START */

      document
        .querySelectorAll<HTMLElement>(
          ".mega-menu-global-occluded"
        )
        .forEach((element) => {

          element.classList.remove(
            "mega-menu-global-occluded"
          );

          element.style.removeProperty(
            "--menu-hole-left"
          );

          element.style.removeProperty(
            "--menu-hole-right"
          );

          element.style.removeProperty(
            "--menu-hole-top"
          );

          element.style.removeProperty(
            "--menu-hole-bottom"
          );

        });

      /* PHASE-5M-GLOBAL-OCCLUSION-CLEAR-END */
      /* PHASE-5L-GLOBAL-BLUR-CLEAR-START */

      document.body.classList.remove(
        "mega-menu-page-blur-active"
      );

      document.body.style.removeProperty(
        "--mega-menu-blur-left"
      );

      document.body.style.removeProperty(
        "--mega-menu-blur-top"
      );

      document.body.style.removeProperty(
        "--mega-menu-blur-width"
      );

      document.body.style.removeProperty(
        "--mega-menu-blur-height"
      );

      /* PHASE-5L-GLOBAL-BLUR-CLEAR-END */



      document.body.classList.remove(
        "mega-menu-occlusion-active"
      );

      for (
        const element
        of [heroForeground, heroTrust, ...getHomeStatContent(), ...getTrustItemContent(), ...getTrustItemIcons(), getTrustBarSurface()]
      ) {
        if (!element) continue;

        element.style.removeProperty(
          "--menu-hole-left"
        );

        element.style.removeProperty(
          "--menu-hole-right"
        );

        element.style.removeProperty(
          "--menu-hole-top"
        );

        element.style.removeProperty(
          "--menu-hole-bottom"
        );

        element.classList.remove(
          "mega-menu-local-occluded"
        );
      }

    };


    const applyMegaMenuOcclusion = (
      panel: HTMLElement
    ) => {

      const panelRect =
        panel.getBoundingClientRect();
      /* PHASE-5M-GLOBAL-OCCLUSION-APPLY-START */

      /*
       * Clear previous global occlusion first.
       */
      document
        .querySelectorAll<HTMLElement>(
          ".mega-menu-global-occluded"
        )
        .forEach((element) => {

          element.classList.remove(
            "mega-menu-global-occluded"
          );

          element.style.removeProperty(
            "--menu-hole-left"
          );

          element.style.removeProperty(
            "--menu-hole-right"
          );

          element.style.removeProperty(
            "--menu-hole-top"
          );

          element.style.removeProperty(
            "--menu-hole-bottom"
          );

        });


      /*
       * Global foreground candidates.
       *
       * Header is intentionally excluded because
       * this query starts inside <main>.
       *
       * We target semantic foreground elements rather
       * than whole sections, so page backgrounds remain
       * visible through the Mega Menu glass.
       */
      const globalOcclusionCandidates =
        document.querySelectorAll<HTMLElement>(
          [
            "main h1",
            "main h2",
            "main h3",
            "main h4",
            "main h5",
            "main h6",
            "main p",
            "main a",
            "main button",
            "main li",
            "main dt",
            "main dd",
            "main figcaption",
            "main small",
            "main .trust-bar__item"
          ].join(", ")
        );


      globalOcclusionCandidates.forEach(
        (element) => {

          /*
           * Ignore hidden / zero-size elements.
           */
          const rect =
            element.getBoundingClientRect();

          if (
            rect.width <= 0 ||
            rect.height <= 0
          ) {
            return;
          }


          /*
           * Intersection with active Mega Menu.
           */
          const overlapLeft =
            Math.max(
              rect.left,
              panelRect.left
            );

          const overlapTop =
            Math.max(
              rect.top,
              panelRect.top
            );

          const overlapRight =
            Math.min(
              rect.right,
              panelRect.right
            );

          const overlapBottom =
            Math.min(
              rect.bottom,
              panelRect.bottom
            );


          if (
            overlapRight <= overlapLeft ||
            overlapBottom <= overlapTop
          ) {
            return;
          }


          /*
           * Convert intersection into coordinates
           * local to this individual element.
           */
          const holeLeft =
            Math.max(
              overlapLeft - rect.left,
              0
            );

          const holeRight =
            Math.max(
              rect.right - overlapRight,
              0
            );

          const holeTop =
            Math.max(
              overlapTop - rect.top,
              0
            );

          const holeBottom =
            Math.max(
              rect.bottom - overlapBottom,
              0
            );


          element.style.setProperty(
            "--menu-hole-left",
            `${holeLeft}px`
          );

          element.style.setProperty(
            "--menu-hole-right",
            `${holeRight}px`
          );

          element.style.setProperty(
            "--menu-hole-top",
            `${holeTop}px`
          );

          element.style.setProperty(
            "--menu-hole-bottom",
            `${holeBottom}px`
          );

          element.classList.add(
            "mega-menu-global-occluded"
          );

        });

      /* PHASE-5M-GLOBAL-OCCLUSION-APPLY-END */
      /* PHASE-5L-GLOBAL-BLUR-APPLY-START */

      /*
       * Global Mega Menu page blur.
       *
       * This uses viewport coordinates from panelRect,
       * therefore it works regardless of which page or
       * section is physically underneath the Mega Menu.
       *
       * Compact dropdowns are intentionally excluded.
       */

      const globalBlurBody =
        document.body;

      const isMegaMenuPanel =
        panel.classList.contains(
          "mega-menu"
        ) ||
        panel.querySelector(
          ".mega-menu-inner"
        ) !== null;


      /*
       * Always clear previous rectangle first.
       * Important when moving directly between nav items.
       */

      globalBlurBody.classList.remove(
        "mega-menu-page-blur-active"
      );

      globalBlurBody.style.removeProperty(
        "--mega-menu-blur-left"
      );

      globalBlurBody.style.removeProperty(
        "--mega-menu-blur-top"
      );

      globalBlurBody.style.removeProperty(
        "--mega-menu-blur-width"
      );

      globalBlurBody.style.removeProperty(
        "--mega-menu-blur-height"
      );


      if (isMegaMenuPanel) {

        globalBlurBody.style.setProperty(
          "--mega-menu-blur-left",
          `${panelRect.left}px`
        );

        globalBlurBody.style.setProperty(
          "--mega-menu-blur-top",
          `${panelRect.top}px`
        );

        globalBlurBody.style.setProperty(
          "--mega-menu-blur-width",
          `${panelRect.width}px`
        );

        globalBlurBody.style.setProperty(
          "--mega-menu-blur-height",
          `${panelRect.height}px`
        );

        globalBlurBody.classList.add(
          "mega-menu-page-blur-active"
        );

      }

      /* PHASE-5L-GLOBAL-BLUR-APPLY-END */



      for (
        const element
        of [heroForeground, heroTrust, ...getHomeStatContent(), ...getTrustItemContent(), ...getTrustItemIcons(), getTrustBarSurface()]
      ) {

        if (!element) continue;

        const rect =
          element.getBoundingClientRect();

        /*
         * Convert the Mega Menu viewport
         * rectangle into coordinates local
         * to this Hero foreground element.
         */
        const left =
          panelRect.left -
          rect.left;

        const right =
          panelRect.right -
          rect.left;

        const top =
          panelRect.top -
          rect.top;

        const bottom =
          panelRect.bottom -
          rect.top;


        /*
         * Clamp values to the element.
         */
        const clampedLeft =
          Math.max(
            0,
            Math.min(
              rect.width,
              left
            )
          );

        const clampedRight =
          Math.max(
            0,
            Math.min(
              rect.width,
              right
            )
          );

        const clampedTop =
          Math.max(
            0,
            Math.min(
              rect.height,
              top
            )
          );

        const clampedBottom =
          Math.max(
            0,
            Math.min(
              rect.height,
              bottom
            )
          );


        /*
         * No overlap = leave this element
         * completely visible.
         */
        if (
          clampedRight <=
            clampedLeft ||
          clampedBottom <=
            clampedTop
        ) {

          element.style.removeProperty(
            "--menu-hole-left"
          );

          element.style.removeProperty(
            "--menu-hole-right"
          );

          element.style.removeProperty(
            "--menu-hole-top"
          );

          element.style.removeProperty(
            "--menu-hole-bottom"
          );

          element.classList.remove(
            "mega-menu-local-occluded"
          );

          continue;
        }


        element.style.setProperty(
          "--menu-hole-left",
          `${clampedLeft}px`
        );

        element.style.setProperty(
          "--menu-hole-right",
          `${clampedRight}px`
        );

        element.style.setProperty(
          "--menu-hole-top",
          `${clampedTop}px`
        );

        element.style.setProperty(
          "--menu-hole-bottom",
          `${clampedBottom}px`
        );

        element.classList.add(
          "mega-menu-local-occluded"
        );
      }


document.body.classList.add(
        "mega-menu-occlusion-active"
      );
    };
  }


  document.addEventListener(
    "astro:page-load",
    initHeader
  );
</script>


<script>
  import { initLanguageSwitcher }
    from "../scripts/language-switcher.ts";

  document.addEventListener(
    "astro:page-load",
    initLanguageSwitcher
  );
</script>
