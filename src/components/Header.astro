---
import { getCurrentLanguage }
  from "../i18n/getCurrentLanguage";

import LanguageSwitcher
  from "./LanguageSwitcher.astro";

import MegaMenuIcon
  from "./navigation/MegaMenuIcon.astro";

import { navigationService }
  from "@services/navigationService";

import type { NavigationLanguage }
  from "@models/navigation";


const currentPath =
  Astro.url.pathname;

const isKhmer =
  currentPath === "/km" ||
  currentPath.startsWith("/km/");

const language: NavigationLanguage =
  isKhmer
    ? "km"
    : "en";

const t =
  getCurrentLanguage(currentPath);


/*
 * Navigation V2
 *
 * Resolve the complete navigation tree
 * before rendering the Header.
 */
const menuItems =
  navigationService.getLocalizedMenu(
    language,
    t.nav
  );


/*
 * Home route is also used by
 * the Mato Cashew brand lockup.
 */
const homeItem =
  menuItems.find(
    item => item.id === "home"
  );

const homePath =
  homeItem?.href ??
  (isKhmer ? "/km/" : "/");


const brandName =
  "ចន្ទីមាតុភូមិ — Mato Cashew";
---

<header class="header">

  <div class="container header-wrapper">

    <a
    href={homePath}
    class="logo brand-lockup"
    aria-label={`${brandName} Home`}
  >
    <img
      class="brand-symbol"
      src="/images/logo/logo.png"
      alt=""
      aria-hidden="true"
    />

    <span class="brand-signature" aria-hidden="true">

      <span class="brand-khmer">
        ចន្ទីមាតុភូមិ
      </span>

      <span class="brand-divider"></span>

      <span class="brand-english">
        MATO CASHEW
      </span>

    </span>
  </a>

    <nav aria-label={isKhmer ? "ម៉ឺនុយមេ" : "Main navigation"}>

      <button
        type="button"
        aria-controls="main-menu"
        class="menu-toggle"
        aria-label={isKhmer ? "បើក ឬបិទម៉ឺនុយ" : "Toggle Menu"}
        aria-expanded="false"
      >
        ☰
      </button>

      <ul id="main-menu" class="nav-menu">
        {
          menuItems.map((item) => {
            const hasChildren =
              Boolean(item.children?.length);

            const isActive =
              navigationService.isParentActive(
                item,
                currentPath
              );

            return (
              <li
                class:list={[
                  "nav-item",
                  hasChildren && "has-submenu",
                  item.variant &&
                    `nav-${item.variant}`,
                ]}
              >
              <div class="nav-link-row">
                <a
                  href={item.href}
                  class:list={[
                    "nav-link",
                    isActive && "active",
                  ]}
                  aria-current={
                    navigationService.isActive(
                      item,
                      currentPath
                    )
                      ? "page"
                      : undefined
                  }
                >
                  <span class="nav-label">
                    {item.label}
                  </span>
                </a>

                {
                  hasChildren && (
                    <button
                      type="button"
                      class="submenu-toggle"
                      aria-expanded="false"
                      aria-label={
                        isKhmer
                          ? `បើកម៉ឺនុយរង ${item.label}`
                          : `Open ${item.label} submenu`
                      }
                    >
                      <span
                        class="nav-chevron"
                        aria-hidden="true"
                      >
                        ▾
                      </span>
                    </button>
                  )
                }
              </div>

                {
                  hasChildren &&
                  item.children && (
                    <div class="submenu-panel mega-menu">
                     <div class="mega-menu-inner">

                        <div class="mega-menu-intro">
                          <span class="mega-menu-eyebrow">
                            {item.label}
                          </span>

                          {
                            item.description && (
                              <p class="mega-menu-description">
                                {item.description}
                              </p>
                            )
                          }
                        </div>

                        <div class="mega-menu-grid">
                          {
                            item.children.map(
                              (child) => (
                                <a
                                  href={child.href}
                                  class:list={[
                                    "mega-menu-link",
                                    child.featured &&
                                      "featured",
                                    navigationService
                                      .isActive(
                                        child,
                                        currentPath
                                      ) &&
                                      "active",
                                  ]}
                                >
                                  <MegaMenuIcon
                                    name={child.icon}
                                  />

                                  <span class="mega-menu-link-content">
                                    <span class="mega-menu-link-title">
                                      {child.label}
                                    </span>

                                  {
                                    child.description && (
                                      <span class="mega-menu-link-description">
                                        {child.description}
                                      </span>
                                    )
                                  }
                                  </span>
                                </a>
                              )
                            )
                          }
                        </div>

                      </div>
                    </div>
                  )
                }
              </li>
            );
          })
        }
      </ul>

    </nav>

    <LanguageSwitcher />

  </div>

</header>

<script>
  /**
   * Global scroll handler.
   *
   * Astro bundled scripts execute once, so this listener
   * does not need a custom window flag.
   */
  const updateHeaderScrollState = () => {
    const header =
      document.querySelector<HTMLElement>(".header");

    if (!header) return;

    header.classList.toggle(
      "scrolled",
      window.scrollY > 40
    );
  };

  window.addEventListener(
    "scroll",
    updateHeaderScrollState,
    { passive: true }
  );


  /**
   * Initialize DOM-specific header interactions.
   *
   * astro:page-load runs on the first page
   * and after every ClientRouter navigation.
   */
  function initHeader() {
    const menuToggle =
      document.querySelector<HTMLButtonElement>(
        ".menu-toggle"
      );

    const navMenu =
      document.querySelector<HTMLElement>(
        ".nav-menu"
      );

    /*
     * Apply correct header state immediately.
     */
    updateHeaderScrollState();


    /*
     * Mobile menu
     */
    if (menuToggle && navMenu) {
      menuToggle.addEventListener(
        "click",
        () => {
          const isOpen =
            navMenu.classList.toggle("open");

          menuToggle.setAttribute(
            "aria-expanded",
            String(isOpen)
          );

          menuToggle.textContent =
            isOpen ? "✕" : "☰";
        }
      );
    }

    /*
     * Mobile submenu accordion.
     *
     * Parent navigation links remain normal links.
     * The dedicated submenu button controls only
     * the nested dropdown / mega-menu panel.
     */
    const submenuToggles =
      document.querySelectorAll<HTMLButtonElement>(
        ".submenu-toggle"
      );

    const closeSubmenu = (
      button: HTMLButtonElement
    ) => {
      const navItem =
        button.closest<HTMLElement>(
          ".nav-item"
        );

      if (!navItem) return;

      navItem.classList.remove(
        "submenu-open"
      );

      button.setAttribute(
        "aria-expanded",
        "false"
      );
      clearMegaMenuOcclusion();
    };

    const closeAllSubmenus = (
      except?: HTMLButtonElement
    ) => {
      submenuToggles.forEach(
        (button) => {
          if (button !== except) {
            closeSubmenu(button);
          }
        }
      );
    };

    submenuToggles.forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const navItem =
              button.closest<HTMLElement>(
                ".nav-item"
              );

            if (!navItem) return;

            const willOpen =
              !navItem.classList.contains(
                "submenu-open"
              );

            closeAllSubmenus(button);

            navItem.classList.toggle(
              "submenu-open",
              willOpen
            );

            button.setAttribute(
              "aria-expanded",
              String(willOpen)
            );
            const panel =
              navItem.querySelector<HTMLElement>(
                ":scope > .submenu-panel"
              );

            if (
              willOpen &&
              panel
            ) {
              requestAnimationFrame(() => {
                applyMegaMenuOcclusion(
                  panel
                );
              });
            } else {
              clearMegaMenuOcclusion();
            }
          }
        );
      }
    );
    /* =========================================
       B7.6L2 ? DESKTOP SUBMENU OCCLUSION STATE SYNC

       CSS can keep a submenu visible through:
       - :hover
       - :focus-within
       - .submenu-open

       Occlusion must follow the same states.
       ========================================= */

    const submenuItems =
      document.querySelectorAll<HTMLElement>(
        ".has-submenu"
      );


    const submenuShouldRemainOpen = (
      navItem: HTMLElement
    ): boolean => {

      return (
        navItem.matches(":hover") ||
        navItem.matches(":focus-within") ||
        navItem.classList.contains(
          "submenu-open"
        )
      );
    };


    const applySubmenuOcclusion = (
      navItem: HTMLElement
    ) => {

      if (
        window.innerWidth <= 768
      ) {
        return;
      }

      const panel =
        navItem.querySelector<HTMLElement>(
          ":scope > .submenu-panel"
        );

      if (!panel) return;

      requestAnimationFrame(() => {

        if (
          submenuShouldRemainOpen(
            navItem
          ) ||
          navItem.classList.contains(
            "mega-menu-handoff-owner"
          )
        ) {

          setPersistentMegaMenuOwner(
            navItem
          );

          applyMegaMenuOcclusion(
            panel
          );
        }
      });
    };


    /* PHASE-5N23A-TRUE-HANDOFF-START */

let megaMenuHandoffTimer:
  number | null =
    null;


const cancelMegaMenuHandoff = () => {

  if (
    megaMenuHandoffTimer === null
  ) {
    return;
  }

  window.clearTimeout(
    megaMenuHandoffTimer
  );

  megaMenuHandoffTimer =
    null;
};


const getActiveDesktopSubmenu = () =>
  Array.from(
    submenuItems
  ).find(
    (item) =>
      submenuShouldRemainOpen(
        item
      )
  ) ?? null;


let persistentMegaMenuOwner:
  HTMLElement | null =
    null;


const clearPersistentMegaMenuOwner = () => {

  submenuItems.forEach(
    (item) => {

      item.classList.remove(
        "mega-menu-handoff-owner"
      );

    }
  );

  persistentMegaMenuOwner =
    null;
};


const setPersistentMegaMenuOwner = (
  navItem: HTMLElement
) => {

  submenuItems.forEach(
    (item) => {

      if (item !== navItem) {

        item.classList.remove(
          "mega-menu-handoff-owner"
        );

      }
    }
  );

  navItem.classList.add(
    "mega-menu-handoff-owner"
  );

  persistentMegaMenuOwner =
    navItem;
};


const transferMegaMenuOwner = (
  navItem: HTMLElement
) => {

  cancelMegaMenuHandoff();

  setPersistentMegaMenuOwner(
    navItem
  );
};


const activateMegaMenuOwner = (
  navItem: HTMLElement
) => {

  if (
    window.innerWidth <= 768
  ) {
    return;
  }

  transferMegaMenuOwner(
    navItem
  );

  applySubmenuOcclusion(
    navItem
  );
};


/*
 * Leaving an individual item does NOT close the menu.
 * Final release is nav-level only.
 */
const releaseSubmenuOcclusion = (
  _navItem: HTMLElement
) => {

  if (
    window.innerWidth <= 768
  ) {
    return;
  }
};


const pointerInsideMegaMenuSystem = (
  clientX: number,
  clientY: number
) => {

  const nav =
    document.querySelector<HTMLElement>(
      ".nav-menu"
    );

  const header =
    document.querySelector<HTMLElement>(
      ".header"
    );


  const pointInsideRect = (
    rect: DOMRect,
    padding = 0
  ) => {

    return (
      clientX >= rect.left - padding &&
      clientX <= rect.right + padding &&
      clientY >= rect.top - padding &&
      clientY <= rect.bottom + padding
    );
  };


  /*
   * ======================================================
   * 1. REAL TOP-LEVEL NAV ITEMS
   * ======================================================
   *
   * Do NOT treat the entire .nav-menu bounding box as an
   * active Mega Menu region.
   *
   * Blank space after About or elsewhere in Header must
   * be allowed to close the Mega Menu.
   */
  const topLevelItems =
    nav
      ? Array.from(
          nav.querySelectorAll<HTMLElement>(
            ":scope > .nav-item"
          )
        )
      : [];


  for (
    const item of topLevelItems
  ) {

    if (
      pointInsideRect(
        item.getBoundingClientRect(),
        1
      )
    ) {
      return true;
    }
  }


  /*
   * ======================================================
   * 2. SMALL HORIZONTAL BRIDGES BETWEEN ADJACENT ITEMS
   * ======================================================
   *
   * Preserve the already-working:
   *
   *   Mega A -> tiny physical gap -> Mega B
   *
   * but ONLY for the actual small gap between two adjacent
   * top-level nav items.
   *
   * We do not extend this bridge beyond the first/last item.
   */
  for (
    let index = 0;
    index < topLevelItems.length - 1;
    index++
  ) {

    const currentRect =
      topLevelItems[
        index
      ].getBoundingClientRect();

    const nextRect =
      topLevelItems[
        index + 1
      ].getBoundingClientRect();


    /*
     * Only bridge realistic small menu gaps.
     *
     * This prevents a large blank Header area from being
     * treated as part of the Mega Menu system.
     */
    const gapWidth =
      nextRect.left -
      currentRect.right;


    if (
      gapWidth < 0 ||
      gapWidth > 28
    ) {
      continue;
    }


    const bridgeTop =
      Math.min(
        currentRect.top,
        nextRect.top
      );

    const bridgeBottom =
      Math.max(
        currentRect.bottom,
        nextRect.bottom
      );


    if (
      clientX >= currentRect.right &&
      clientX <= nextRect.left &&
      clientY >= bridgeTop &&
      clientY <= bridgeBottom
    ) {
      return true;
    }
  }


  /*
   * ======================================================
   * 3. VERTICAL CORRIDOR ABOVE CURRENT OWNER TAB ONLY
   * ======================================================
   *
   * Phase 5N24 fixed upward movement, but its original
   * corridor was too broad.
   *
   * Keep the owner alive only directly above the ACTIVE
   * owner Tab — not across the full navigation width.
   */
  if (
    persistentMegaMenuOwner &&
    header
  ) {

    const ownerTab =
      persistentMegaMenuOwner
        .querySelector<HTMLElement>(
          ":scope > .nav-link-row"
        );


    if (ownerTab) {

      const tabRect =
        ownerTab.getBoundingClientRect();

      const headerRect =
        header.getBoundingClientRect();


      const corridorPaddingX =
        8;


      const insideOwnerVerticalCorridor =
        clientX >=
          tabRect.left -
          corridorPaddingX &&
        clientX <=
          tabRect.right +
          corridorPaddingX &&
        clientY >=
          headerRect.top &&
        clientY <=
          tabRect.bottom;


      if (
        insideOwnerVerticalCorridor
      ) {
        return true;
      }
    }
  }


  /*
   * ======================================================
   * 4. CURRENT OWNER'S REAL MEGA MENU PANEL
   * ======================================================
   */
  if (
    persistentMegaMenuOwner
  ) {

    const ownerPanel =
      persistentMegaMenuOwner
        .querySelector<HTMLElement>(
          ":scope > .submenu-panel"
        );


    if (ownerPanel) {

      const panelRect =
        ownerPanel.getBoundingClientRect();


      if (
        pointInsideRect(
          panelRect,
          1
        )
      ) {
        return true;
      }
    }
  }


  /*
   * Anything else is a TRUE exit.
   */
  return false;
};


/* PHASE-5N28-PRECISE-NAV-GEOMETRY */

/* PHASE-5N30A-STRICT-HEADER-EXIT-START */

/*
 * Immediate Header exit authority.
 *
 * This handler exists only for pointer movement INSIDE
 * the Header while a Mega Menu owner is active.
 *
 * Important behavior:
 *
 * - Mega A -> Mega B remains handled by normal nav handoff.
 * - Moving upward over the active Tab remains protected.
 * - Moving into the Mega panel remains protected.
 * - Moving beyond the OUTER edge of the final nav item
 *   closes immediately with no corridor padding.
 */

const atomicExitHeader =
  document.querySelector<HTMLElement>(
    ".header"
  );


const atomicExitNav =
  document.querySelector<HTMLElement>(
    ".nav-menu"
  );


atomicExitHeader?.addEventListener(
  "pointermove",
  (event) => {

    if (
      window.innerWidth <= 768 ||
      !persistentMegaMenuOwner
    ) {
      return;
    }


    const headerRect =
      atomicExitHeader
        .getBoundingClientRect();


    const pointerInsideHeader =
      event.clientX >= headerRect.left &&
      event.clientX <= headerRect.right &&
      event.clientY >= headerRect.top &&
      event.clientY <= headerRect.bottom;


    if (
      !pointerInsideHeader
    ) {
      return;
    }


    /*
     * -----------------------------------------------------
     * STRICT OUTER EDGE OF FINAL NAV ITEM
     * -----------------------------------------------------
     *
     * This specifically fixes:
     *
     *   About -> blank Header area on the right
     *
     * The general vertical corridor may include a few pixels
     * beyond the active Tab. That padding must NOT apply on
     * the OUTER side of the final top-level nav item.
     */
    if (
      atomicExitNav
    ) {

      const topLevelNavItems =
        Array.from(
          atomicExitNav.querySelectorAll<HTMLElement>(
            ":scope > .nav-item"
          )
        );


      const lastTopLevelNavItem =
        topLevelNavItems.length > 0
          ? topLevelNavItems[
              topLevelNavItems.length - 1
            ]
          : null;


      if (
        lastTopLevelNavItem &&
        persistentMegaMenuOwner ===
          lastTopLevelNavItem
      ) {

        const lastItemRect =
          lastTopLevelNavItem
            .getBoundingClientRect();


        /*
         * No padding.
         *
         * The first physical pixel beyond About's right edge
         * is a definite exit because there is no next Menu
         * item to hand ownership to.
         */
        if (
          event.clientX >
            lastItemRect.right
        ) {

          cancelMegaMenuHandoff();

          clearMegaMenuOcclusion();

          return;
        }
      }
    }


    /*
     * Existing precise interaction geometry still protects:
     *
     * - a real top-level nav item
     * - small gaps between adjacent items
     * - the vertical corridor over the active owner
     * - the active Mega Menu panel
     */
    if (
      pointerInsideMegaMenuSystem(
        event.clientX,
        event.clientY
      )
    ) {
      return;
    }


    /*
     * Pointer is inside Header but belongs to no valid
     * Mega interaction region.
     *
     * Clear synchronously. No 90ms delay here.
     */
    cancelMegaMenuHandoff();

    clearMegaMenuOcclusion();

  },
  {
    passive: true,
    capture: true
  }
);

/* PHASE-5N30A-STRICT-HEADER-EXIT-END */

/* PHASE-5N27-DEFINITIVE-PHYSICAL-EXIT-START */

/*
 * Desktop Mega Menu physical-pointer lifecycle.
 *
 * IMPORTANT:
 *
 * Opening / transferring ownership is still handled by the
 * existing nav-item lifecycle.
 *
 * This listener owns only the final EXIT decision.
 *
 * A -> physical gap -> B:
 *   pointer remains inside the Mega interaction system,
 *   therefore the current owner is preserved.
 *
 * Tab -> upper Header corridor:
 *   pointer remains inside the protected geometry,
 *   therefore the current owner is preserved.
 *
 * True exit:
 *   after the short guard, the pointer coordinates are tested
 *   again against REAL geometry.
 *
 * We intentionally DO NOT call getActiveDesktopSubmenu()
 * here because CSS :hover / :focus-within can briefly remain
 * stale after the pointer has physically left the system.
 */

let lastMegaPointerX =
  0;

let lastMegaPointerY =
  0;


document.addEventListener(
  "pointermove",
  (event) => {

    if (
      window.innerWidth <= 768
    ) {
      return;
    }


    lastMegaPointerX =
      event.clientX;

    lastMegaPointerY =
      event.clientY;


    if (
      !persistentMegaMenuOwner
    ) {
      return;
    }


    /*
     * Pointer is physically inside the protected Mega system.
     *
     * Keep the current owner and cancel any pending exit.
     */
    if (
      pointerInsideMegaMenuSystem(
        lastMegaPointerX,
        lastMegaPointerY
      )
    ) {

      cancelMegaMenuHandoff();

      return;
    }


    /*
     * Pointer is currently outside.
     *
     * One pending exit timer is enough.
     */
    if (
      megaMenuHandoffTimer !== null
    ) {
      return;
    }


    megaMenuHandoffTimer =
      window.setTimeout(
        () => {

          megaMenuHandoffTimer =
            null;


          /*
           * Re-test PHYSICAL pointer geometry after the guard.
           *
           * If the pointer crossed a legitimate corridor and
           * returned to the Mega system, preserve the owner.
           */
          if (
            pointerInsideMegaMenuSystem(
              lastMegaPointerX,
              lastMegaPointerY
            )
          ) {

            return;
          }


          /*
           * Definitive physical exit.
           *
           * Do not resurrect an owner from stale CSS :hover.
           *
           * clearMegaMenuOcclusion() already clears:
           * - persistent owner
           * - unified glass
           * - Header cutout
           * - page blur
           * - local occlusion state
           */
          clearMegaMenuOcclusion();

        },
        90
      );

  },
  {
    passive: true
  }
);

/* PHASE-5N27-DEFINITIVE-PHYSICAL-EXIT-END */

const desktopNavForHandoff =
  document.querySelector<HTMLElement>(
    ".nav-menu"
  );


/* PHASE-5N25C-DIRECT-NAV-EXIT-START */

desktopNavForHandoff?.addEventListener(
  "pointerover",
  (event) => {

    if (
      window.innerWidth <= 768
    ) {
      return;
    }


    const target =
      event.target;


    if (
      !(target instanceof Element)
    ) {
      return;
    }


    /*
     * Resolve the REAL top-level navigation item first.
     *
     * This is intentionally .nav-item, not .has-submenu.
     *
     * Examples:
     *
     * Home                -> .nav-item only
     * Cambodian Cashew    -> .nav-item.has-submenu
     * Knowledge           -> .nav-item.has-submenu
     */
    const physicalNavItem =
      target.closest<HTMLElement>(
        ".nav-item"
      );


    /*
     * Pointer may be in the physical gap between items.
     *
     * That gap belongs to nav-menu but not to any nav-item.
     * Preserve the current Mega owner in that case.
     */
    if (!physicalNavItem) {

      cancelMegaMenuHandoff();

      return;
    }


    if (
      !desktopNavForHandoff.contains(
        physicalNavItem
      )
    ) {
      return;
    }


    /*
     * DIRECT NAV ITEM
     * =====================================================
     *
     * Home and any other top-level nav item without a
     * submenu must terminate the currently-open Mega Menu.
     *
     * This is the missing lifecycle case:
     *
     * Cambodian Cashew -> Home
     * Knowledge        -> Home
     * Mega Menu        -> any direct nav item
     */
    if (
      !physicalNavItem.classList.contains(
        "has-submenu"
      )
    ) {

      cancelMegaMenuHandoff();


      if (
        persistentMegaMenuOwner
      ) {

        clearMegaMenuOcclusion();

      }


      return;
    }


    /*
     * From here onward we know this item owns a submenu.
     */
    const navItem =
      physicalNavItem;


    /*
     * Same Mega Menu owner.
     *
     * Do not rebuild glass geometry unnecessarily.
     */
    if (
      persistentMegaMenuOwner ===
      navItem
    ) {

      cancelMegaMenuHandoff();

      return;
    }


    /*
     * Different Mega Menu.
     *
     * Existing 5N23A ownership model handles:
     *
     * A -> gap -> B
     *
     * without clearing Header / Glass between them.
     */
    activateMegaMenuOwner(
      navItem
    );

  },
  {
    capture: true
  }
);

/* PHASE-5N25C-DIRECT-NAV-EXIT-END */

submenuItems.forEach(
  (handoffItem) => {

    handoffItem.addEventListener(
      "focusin",
      () => {

        activateMegaMenuOwner(
          handoffItem
        );

      }
    );

  }
);

/* PHASE-5N23A-TRUE-HANDOFF-END */

submenuItems.forEach((navItem) => {

      navItem.addEventListener(
        "mouseenter",
        () => {
          transferMegaMenuOwner(navItem);

          applySubmenuOcclusion(
