                    0 !important;

                  border-top-right-radius:
                    0 !important;


                  /*
                   * Premium lower card shape.
                   */
                  border-bottom-left-radius:
                    18px !important;

                  border-bottom-right-radius:
                    18px !important;


                  /*
                   * Restore depth without a top seam.
                   */
                  box-shadow:
                    0 22px 52px
                    rgba(18, 50, 35, 0.12),

                    inset 1px 0 0
                    rgba(255, 255, 255, 0.06),

                    inset -1px 0 0
                    rgba(255, 255, 255, 0.06),

                    inset 0 -1px 0
                    rgba(255, 255, 255, 0.07)
                    !important;
                }


                /*
                 * =========================================
                 * 5. NO JOIN PSEUDOS
                 * =========================================
                 */

                html body.mega-menu-tab-glass-active
                .header
                .has-submenu:has(> .mega-menu)
                > .nav-link-row::before,

                html body.mega-menu-tab-glass-active
                .header
                .has-submenu:has(> .mega-menu)
                > .nav-link-row::after,

                html body.mega-menu-tab-glass-active
                .header
                .has-submenu:has(> .mega-menu)
                > .mega-menu::before,

                html body.mega-menu-tab-glass-active
                .header
                .has-submenu:has(> .mega-menu)
                > .mega-menu::after {

                  content:
                    none !important;

                  display:
                    none !important;

                  border:
                    0 !important;

                  background:
                    none !important;

                  box-shadow:
                    none !important;
                }


                /*
                 * =========================================
                 * 6. KEEP TEXT SHARP
                 * =========================================
                 */

                html body.mega-menu-tab-glass-active
                .header
                .has-submenu:has(> .mega-menu)
                > .nav-link-row
                > .nav-link,

                html body.mega-menu-tab-glass-active
                .header
                .has-submenu:has(> .mega-menu)
                > .nav-link-row
                > .submenu-toggle {

                  position:
                    relative !important;

                  z-index:
                    3 !important;

                  opacity:
                    1 !important;

                  filter:
                    none !important;

                  -webkit-filter:
                    none !important;
                }

              }
            `;


            /*
             * Append AFTER the previous runtime authority.
             */
            document.head.appendChild(
              premiumEdgeAuthority
            );
          }

          /* PHASE-5N13-PREMIUM-CONTINUOUS-EDGE-END */
          /* PHASE-5N8-FULL-CUTOUT-APPLY-START */

          /*
           * FINAL HEADER CUTOUT SILHOUETTE
           *
           * Cut out:
           *
           * 1. the complete Mega Menu overlap inside Header
           * 2. the active Tab rising above that panel
           *
           * The resulting Header edge therefore follows:
           *
           * Header
           * -----------╮      ╭----------------
           *            │ TAB  │
           *       ╭────╯      ╰────╮
           *       │   MEGA MENU    │
           *
           * This matches the intended connected shape.
           */


          const connectedSurfaceWidth =
            headerRect.width;

          const connectedSurfaceHeight =
            headerRect.height;


          /*
           * Mega Menu coordinates local to Header.
           *
           * Expand 1px to remove anti-aliasing seams.
           */
          const panelCutLeft =
            Math.max(
              panelRect.left -
              headerRect.left -
              1,
              0
            );

          const panelCutRight =
            Math.min(
              panelRect.right -
              headerRect.left +
              1,
              connectedSurfaceWidth
            );

          const panelCutTop =
            Math.max(
              panelRect.top -
              headerRect.top -
              1,
              0
            );


          /*
           * Active Tab coordinates local to Header.
           */
          const tabCutLeft =
            Math.max(
              tabRect.left -
              headerRect.left -
              1,
              panelCutLeft
            );

          const tabCutRight =
            Math.min(
              tabRect.right -
              headerRect.left +
              1,
              panelCutRight
            );

          const tabCutTop =
            Math.max(
              tabRect.top -
              headerRect.top -
              1,
              0
            );


          /*
           * Corner radii.
           */
          const panelShoulderRadius =
            Math.min(
              18,
              Math.max(
                8,
                (panelCutRight - panelCutLeft) / 12
              )
            );

          const tabRadius =
            Math.min(
              18,
              Math.max(
                8,
                (tabCutRight - tabCutLeft) / 3
              )
            );


          /*
           * Approximation points for smooth corners.
           */
          const panelP1 =
            panelShoulderRadius * 0.076;

          const panelP2 =
            panelShoulderRadius * 0.293;

          const panelP3 =
            panelShoulderRadius * 0.617;


          const tabP1 =
            tabRadius * 0.076;

          const tabP2 =
            tabRadius * 0.293;

          const tabP3 =
            tabRadius * 0.617;


          /*
           * Remaining Header surface.
           *
           * The polygon walks around the OUTSIDE Header,
           * then travels through the connected concave
           * Mega Menu + Tab opening.
           */
          const connectedHeaderClip =
            [
              "polygon(",

              /*
               * Outer Header:
               * top-left -> top-right -> bottom-right
               */
              "0px 0px,",

              `${connectedSurfaceWidth}px 0px,`,

              `${connectedSurfaceWidth}px ${connectedSurfaceHeight}px,`,


              /*
               * Right side of Mega Menu opening.
               */
              `${panelCutRight}px ${connectedSurfaceHeight}px,`,

              `${panelCutRight}px ${panelCutTop + panelShoulderRadius}px,`,

              `${panelCutRight - panelP1}px ${panelCutTop + panelP3}px,`,

              `${panelCutRight - panelP2}px ${panelCutTop + panelP2}px,`,

              `${panelCutRight - panelP3}px ${panelCutTop + panelP1}px,`,

              `${panelCutRight - panelShoulderRadius}px ${panelCutTop}px,`,


              /*
               * Mega Menu top edge ->
               * right side of active Tab.
               */
              `${tabCutRight + tabRadius}px ${panelCutTop}px,`,

              `${tabCutRight + tabP3}px ${panelCutTop - tabP1}px,`,

              `${tabCutRight + tabP2}px ${panelCutTop - tabP2}px,`,

              `${tabCutRight + tabP1}px ${panelCutTop - tabP3}px,`,

              `${tabCutRight}px ${panelCutTop - tabRadius}px,`,


              /*
               * Right wall of Tab.
               */
              `${tabCutRight}px ${tabCutTop + tabRadius}px,`,

              `${tabCutRight - tabP1}px ${tabCutTop + tabP3}px,`,

              `${tabCutRight - tabP2}px ${tabCutTop + tabP2}px,`,

              `${tabCutRight - tabP3}px ${tabCutTop + tabP1}px,`,

              `${tabCutRight - tabRadius}px ${tabCutTop}px,`,


              /*
               * Tab top edge.
               */
              `${tabCutLeft + tabRadius}px ${tabCutTop}px,`,


              /*
               * Left upper Tab corner.
               */
              `${tabCutLeft + tabP3}px ${tabCutTop + tabP1}px,`,

              `${tabCutLeft + tabP2}px ${tabCutTop + tabP2}px,`,

              `${tabCutLeft + tabP1}px ${tabCutTop + tabP3}px,`,

              `${tabCutLeft}px ${tabCutTop + tabRadius}px,`,


              /*
               * Left wall of Tab down toward panel.
               */
              `${tabCutLeft}px ${panelCutTop - tabRadius}px,`,

              `${tabCutLeft - tabP1}px ${panelCutTop - tabP3}px,`,

              `${tabCutLeft - tabP2}px ${panelCutTop - tabP2}px,`,

              `${tabCutLeft - tabP3}px ${panelCutTop - tabP1}px,`,

              `${tabCutLeft - tabRadius}px ${panelCutTop}px,`,


              /*
               * Mega Menu top edge to left shoulder.
               */
              `${panelCutLeft + panelShoulderRadius}px ${panelCutTop}px,`,

              `${panelCutLeft + panelP3}px ${panelCutTop + panelP1}px,`,

              `${panelCutLeft + panelP2}px ${panelCutTop + panelP2}px,`,

              `${panelCutLeft + panelP1}px ${panelCutTop + panelP3}px,`,

              `${panelCutLeft}px ${panelCutTop + panelShoulderRadius}px,`,


              /*
               * Left side of opening -> Header bottom.
               */
              `${panelCutLeft}px ${connectedSurfaceHeight}px,`,

              `0px ${connectedSurfaceHeight}px`,

              ")"
            ].join(" ");


          /*
           * Override 5N6's smaller Tab-only notch.
           */
          headerElement.style.setProperty(
            "--mato-header-surface-clip",
            connectedHeaderClip
          );

          /* PHASE-5N8-FULL-CUTOUT-APPLY-END */
          /* PHASE-5N10-BEZIER-CUTOUT-START */

          /*
           * PREMIUM CURVE ENGINE
           *
           * 5N8 established the correct connected geometry,
           * but polygon() approximates curves with small
           * straight facets.
           *
           * Here we reuse the SAME coordinates and override
           * only the final Header clipping shape using
           * true quadratic Bezier curves.
           */


          /*
           * Shoulder radius:
           * transition between Mega Menu top and Tab wall.
           */
          const bezierShoulderRadius =
            Math.min(
              18,
              Math.max(
                12,
                panelShoulderRadius
              )
            );


          /*
           * Tab upper corner radius.
           */
          const bezierTabRadius =
            Math.min(
              18,
              Math.max(
                12,
                tabRadius
              )
            );


          /*
           * Small safety expansion.
           *
           * This moves the glass opening slightly under
           * the panel so anti-aliasing from the Header
           * surface cannot create a pale 1px wedge.
           */
          const seamSafety =
            2;


          const smoothPanelLeft =
            Math.max(
              panelCutLeft - seamSafety,
              0
            );

          const smoothPanelRight =
            Math.min(
              panelCutRight + seamSafety,
              connectedSurfaceWidth
            );

          const smoothPanelTop =
            Math.max(
              panelCutTop - seamSafety,
              0
            );


          const smoothTabLeft =
            Math.max(
              tabCutLeft - 1,
              smoothPanelLeft
            );

          const smoothTabRight =
            Math.min(
              tabCutRight + 1,
              smoothPanelRight
            );

          const smoothTabTop =
            Math.max(
              tabCutTop - 1,
              0
            );


          /*
           * SVG/CSS path.
           *
           * Q = true quadratic curve.
           *
           * No polygon facets remain at:
           * - panel → tab left shoulder
           * - tab top-left
           * - tab top-right
           * - tab → panel right shoulder
           */
          const smoothConnectedPath =
            [
              'path("',

              /*
               * Header outer boundary.
               */
              `M 0 0 `,
              `L ${connectedSurfaceWidth} 0 `,
              `L ${connectedSurfaceWidth} ${connectedSurfaceHeight} `,


              /*
               * Bottom-right toward Mega Menu opening.
               */
              `L ${smoothPanelRight} ${connectedSurfaceHeight} `,

              `L ${smoothPanelRight} ${
                smoothPanelTop + bezierShoulderRadius
              } `,


              /*
               * RIGHT OUTER SHOULDER
               */
              `Q ${smoothPanelRight} ${smoothPanelTop} ${
                smoothPanelRight - bezierShoulderRadius
              } ${smoothPanelTop} `,


              /*
               * Panel top → right side of Tab.
               */
              `L ${
                smoothTabRight + bezierShoulderRadius
              } ${smoothPanelTop} `,


              /*
               * Smooth rise from panel into Tab right wall.
               */
              `Q ${smoothTabRight} ${smoothPanelTop} ${
                smoothTabRight
              } ${
                smoothPanelTop - bezierShoulderRadius
              } `,


              /*
               * Tab right wall.
               */
              `L ${smoothTabRight} ${
                smoothTabTop + bezierTabRadius
              } `,


              /*
               * TAB TOP-RIGHT CURVE
               */
              `Q ${smoothTabRight} ${smoothTabTop} ${
                smoothTabRight - bezierTabRadius
              } ${smoothTabTop} `,


              /*
               * Tab top.
               */
              `L ${
                smoothTabLeft + bezierTabRadius
              } ${smoothTabTop} `,


              /*
               * TAB TOP-LEFT CURVE
               */
              `Q ${smoothTabLeft} ${smoothTabTop} ${
                smoothTabLeft
              } ${
                smoothTabTop + bezierTabRadius
              } `,


              /*
               * Tab left wall.
               */
              `L ${smoothTabLeft} ${
                smoothPanelTop - bezierShoulderRadius
              } `,


              /*
               * Smooth fall from Tab left wall to panel top.
               */
              `Q ${smoothTabLeft} ${smoothPanelTop} ${
                smoothTabLeft - bezierShoulderRadius
              } ${smoothPanelTop} `,


              /*
               * Panel top toward left outer shoulder.
               */
              `L ${
                smoothPanelLeft + bezierShoulderRadius
              } ${smoothPanelTop} `,


              /*
               * LEFT OUTER SHOULDER
               */
              `Q ${smoothPanelLeft} ${smoothPanelTop} ${
                smoothPanelLeft
              } ${
                smoothPanelTop + bezierShoulderRadius
              } `,


              /*
               * Return around Header outer boundary.
               */
              `L ${smoothPanelLeft} ${connectedSurfaceHeight} `,
              `L 0 ${connectedSurfaceHeight} `,
              `Z`,

              '")'
            ].join("");


          /*
           * Override polygon generated by 5N8.
           */
          headerElement.style.setProperty(
            "--mato-header-surface-clip",
            smoothConnectedPath
          );

          /* PHASE-5N10-BEZIER-CUTOUT-END */
          /* PHASE-5N10C-EXACT-TAB-SYNC-START */

          /*
           * EXACT CURVE SYNCHRONIZATION
           *
           * The Header Bezier opening and the body-level
           * Tab glass must use the EXACT SAME geometry.
           *
           * Previously:
           * Header cutout and Tab glass differed by
           * approximately 1–2px because each system
           * performed its own safety expansion.
           *
           * That produced the apparent double curve.
           */

          const syncedTabGlass =
            document.querySelector<HTMLElement>(
              "#mega-menu-tab-glass-layer"
            );


          if (syncedTabGlass) {

            /*
             * Convert Bezier-local Header coordinates
             * back into viewport coordinates.
             */

            const syncedLeft =
              headerRect.left +
              smoothTabLeft;

            const syncedTop =
              headerRect.top +
              smoothTabTop;

            const syncedWidth =
              Math.max(
                smoothTabRight -
                smoothTabLeft,
                0
              );


            /*
             * Continue the Tab glass exactly down to the
             * Mega Menu shoulder plane plus a tiny 2px
             * physical overlap.
             */

            const syncedPanelTop =
              headerRect.top +
              smoothPanelTop;

            const syncedHeight =
              Math.max(
                syncedPanelTop -
                syncedTop +
                3,
                tabRect.height
              );


            syncedTabGlass.style.setProperty(
              "--tab-glass-left",
              `${syncedLeft}px`
            );

            syncedTabGlass.style.setProperty(
              "--tab-glass-top",
              `${syncedTop}px`
            );

            syncedTabGlass.style.setProperty(
              "--tab-glass-width",
              `${syncedWidth}px`
            );

            syncedTabGlass.style.setProperty(
              "--tab-glass-height",
              `${syncedHeight}px`
            );


            /*
             * Same radius used by the Header Bezier.
             */
            syncedTabGlass.style.setProperty(
              "--tab-glass-radius",
              `${bezierTabRadius}px`
            );


            /*
             * Explicitly mark synchronized state so CSS
             * can override all historical approximations.
             */
            syncedTabGlass.classList.add(
              "mega-menu-tab-glass-synced"
            );
          }

          /* PHASE-5N10C-EXACT-TAB-SYNC-END */
        }

        /* PHASE-5N3-HEADER-CUTOUT-APPLY-END */

        globalBlurBody.style.setProperty(
          "--mega-menu-blur-left",
          `${panelRect.left}px`
        );

        globalBlurBody.style.setProperty(
          "--mega-menu-blur-top",
          `${panelRect.top}px`
        );

        globalBlurBody.style.setProperty(
          "--mega-menu-blur-width",
          `${panelRect.width}px`
        );

        globalBlurBody.style.setProperty(
          "--mega-menu-blur-height",
          `${panelRect.height}px`
        );

        globalBlurBody.classList.add(
          "mega-menu-page-blur-active"
        );

      }

      /* PHASE-5L-GLOBAL-BLUR-APPLY-END */



      for (
        const element
        of [heroForeground, heroTrust, ...getHomeStatContent(), ...getTrustItemContent(), ...getTrustItemIcons(), getTrustBarSurface()]
      ) {

        if (!element) continue;

        const rect =
          element.getBoundingClientRect();

        /*
         * Convert the Mega Menu viewport
         * rectangle into coordinates local
         * to this Hero foreground element.
         */
        const left =
          panelRect.left -
          rect.left;

        const right =
          panelRect.right -
          rect.left;

        const top =
          panelRect.top -
          rect.top;

        const bottom =
          panelRect.bottom -
          rect.top;


        /*
         * Clamp values to the element.
         */
        const clampedLeft =
          Math.max(
            0,
            Math.min(
              rect.width,
              left
            )
          );

        const clampedRight =
          Math.max(
            0,
            Math.min(
              rect.width,
              right
            )
          );

        const clampedTop =
          Math.max(
            0,
            Math.min(
              rect.height,
              top
            )
          );

        const clampedBottom =
          Math.max(
            0,
            Math.min(
              rect.height,
              bottom
            )
          );


        /*
         * No overlap = leave this element
         * completely visible.
         */
        if (
          clampedRight <=
            clampedLeft ||
          clampedBottom <=
            clampedTop
        ) {

          element.style.removeProperty(
            "--menu-hole-left"
          );

          element.style.removeProperty(
            "--menu-hole-right"
          );

          element.style.removeProperty(
            "--menu-hole-top"
          );

          element.style.removeProperty(
            "--menu-hole-bottom"
          );

          element.classList.remove(
            "mega-menu-local-occluded"
          );

          continue;
        }


        element.style.setProperty(
          "--menu-hole-left",
          `${clampedLeft}px`
        );

        element.style.setProperty(
          "--menu-hole-right",
          `${clampedRight}px`
        );

        element.style.setProperty(
          "--menu-hole-top",
          `${clampedTop}px`
        );

        element.style.setProperty(
          "--menu-hole-bottom",
          `${clampedBottom}px`
        );

        element.classList.add(
          "mega-menu-local-occluded"
        );
      }


document.body.classList.add(
        "mega-menu-occlusion-active"
      );
    };
  }


  document.addEventListener(
    "astro:page-load",
    initHeader
  );
</script>


<script>
  import { initLanguageSwitcher }
    from "../scripts/language-switcher.ts";

  document.addEventListener(
    "astro:page-load",
    initLanguageSwitcher
  );

  /*
   * PHASE-5N34-ATOMIC-HEADER-RESTORE-AUTHORITY
   *
   * Normal Header must always be opaque.
   *
   * Only the explicit active cutout state may expose the
   * connected Mega Glass through the Header.
   */
  const atomicHeaderRestoreAuthority =
    document.createElement(
      "style"
    );

  atomicHeaderRestoreAuthority.id =
    "mato-atomic-header-restore-authority";

  atomicHeaderRestoreAuthority.textContent = `
    @media (min-width: 769px) {

      html body
      .header:not(.mega-menu-header-cutout-active) {
        background: #fffdf8 !important;
        -webkit-backdrop-filter: none !important;
        backdrop-filter: none !important;
        filter: none !important;
      }

      html body
      .header:not(.mega-menu-header-cutout-active)::before {
        background: #fffdf8 !important;
        -webkit-backdrop-filter: none !important;
        backdrop-filter: none !important;
        filter: none !important;
      }
    }
  `;

  document.head.appendChild(
    atomicHeaderRestoreAuthority
  );
</script>
