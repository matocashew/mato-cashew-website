---
import { getCurrentLanguage } from "../i18n/getCurrentLanguage";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const currentPath = Astro.url.pathname;

const isKhmer = currentPath.startsWith("/km");

const t = getCurrentLanguage(currentPath);

const homePath = isKhmer ? "/km/" : "/";
const aboutPath = isKhmer ? "/km/about/" : "/about/";
const productsPath = isKhmer ? "/km/products/" : "/products/";
const knowledgePath = "/knowledge/";
const resourcesPath = isKhmer ? "/km/resources/" : "/resources/";
const galleryPath = isKhmer ? "/km/gallery/" : "/gallery/";
const wholesalePath = isKhmer ? "/km/wholesale/" : "/wholesale/";
const contactPath = isKhmer ? "/km/contact/" : "/contact/";

const brandName = "ចន្ទីមាតុភូមិ — Mato Cashew";
---

<header class="header">

  <div class="container header-wrapper">

    <a
    href={homePath}
    class="logo brand-lockup"
    aria-label={`${brandName} Home`}
  >
    <img
      class="brand-symbol"
      src="/images/logo/logo.png"
      alt=""
      aria-hidden="true"
    />

    <span class="brand-signature" aria-hidden="true">

      <span class="brand-khmer">
        ចន្ទីមាតុភូមិ
      </span>

      <span class="brand-divider"></span>

      <span class="brand-english">
        MATO CASHEW
      </span>

    </span>
  </a>

    <nav aria-label={isKhmer ? "ម៉ឺនុយមេ" : "Main navigation"}>

      <button
        type="button"
        aria-controls="main-menu"
        class="menu-toggle"
        aria-label={isKhmer ? "បើក ឬបិទម៉ឺនុយ" : "Toggle Menu"}
        aria-expanded="false"
      >
        ☰
      </button>

      <ul id="main-menu" class="nav-menu">

        <li>
          <a
            href={homePath}
            class={
              currentPath === "/" ||
              currentPath === "/km" ||
              currentPath === "/km/"
                ? "active"
                : ""
            }
          >
            {t.nav.home}
          </a>
        </li>

        <li>
          <a
            href={aboutPath}
            class={currentPath === aboutPath ? "active" : ""}
          >
            {t.nav.about}
          </a>
        </li>

        <li>
          <a
            href={productsPath}
            class={
              currentPath === productsPath ||
              currentPath.startsWith(`${productsPath}/`)
                ? "active"
                : ""
            }
          >
            {t.nav.products}
          </a>
        </li>

        <li>
          <a
            href={knowledgePath}
            class={
              currentPath === "/knowledge" ||
              currentPath === "/knowledge/" ||
              currentPath.startsWith("/knowledge/")
                ? "active"
                : ""
            }
          >
            {t.nav.knowledge}
          </a>
        </li>

        <li>
          <a
            href={resourcesPath}
            class={
              currentPath === resourcesPath ||
              currentPath.startsWith(`${resourcesPath}/`)
                ? "active"
                : ""
            }
          >
            {t.nav.resources}
          </a>
        </li>

        <li>
          <a
            href={galleryPath}
            class={currentPath === galleryPath ? "active" : ""}
          >
            {t.nav.gallery}
          </a>
        </li>

        <li>
          <a
            href={wholesalePath}
            class={currentPath === wholesalePath ? "active" : ""}
          >
            {t.nav.wholesale}
          </a>
        </li>

        <li>
          <a
            href={contactPath}
            class={currentPath === contactPath ? "active" : ""}
          >
            {t.nav.contact}
          </a>
        </li>

      </ul>

    </nav>

    <LanguageSwitcher />

  </div>

</header>

<script>
  /**
   * Global scroll handler.
   *
   * Astro bundled scripts execute once, so this listener
   * does not need a custom window flag.
   */
  const updateHeaderScrollState = () => {
    const header =
      document.querySelector<HTMLElement>(".header");

    if (!header) return;

    header.classList.toggle(
      "scrolled",
      window.scrollY > 40
    );
  };

  window.addEventListener(
    "scroll",
    updateHeaderScrollState,
    { passive: true }
  );


  /**
   * Initialize DOM-specific header interactions.
   *
   * astro:page-load runs on the first page
   * and after every ClientRouter navigation.
   */
  function initHeader() {
    const menuToggle =
      document.querySelector<HTMLButtonElement>(
        ".menu-toggle"
      );

    const navMenu =
      document.querySelector<HTMLElement>(
        ".nav-menu"
      );

    /*
     * Apply correct header state immediately.
     */
    updateHeaderScrollState();


    /*
     * Mobile menu
     */
    if (menuToggle && navMenu) {
      menuToggle.addEventListener(
        "click",
        () => {
          const isOpen =
            navMenu.classList.toggle("open");

          menuToggle.setAttribute(
            "aria-expanded",
            String(isOpen)
          );

          menuToggle.textContent =
            isOpen ? "✕" : "☰";
        }
      );
    }


    /*
     * Close mobile menu after clicking
     * any navigation link.
     */
    const navLinks =
      document.querySelectorAll<HTMLAnchorElement>(
        ".nav-menu a"
      );

    navLinks.forEach((link) => {
      link.addEventListener(
        "click",
        () => {
          navMenu?.classList.remove("open");

          if (menuToggle) {
            menuToggle.textContent = "☰";

            menuToggle.setAttribute(
              "aria-expanded",
              "false"
            );
          }
        }
      );
    });
  }


  document.addEventListener(
    "astro:page-load",
    initHeader
  );
</script>


<script>
  import { initLanguageSwitcher }
    from "../scripts/language-switcher.ts";

  document.addEventListener(
    "astro:page-load",
    initLanguageSwitcher
  );
</script>