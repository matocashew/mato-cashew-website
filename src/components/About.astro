---
import SectionTitle from "./SectionTitle.astro";

import { getCurrentLanguage } from "../i18n/getCurrentLanguage";
import { getLocalizedPath } from "../i18n/getLocalizedPath";

import type { Language } from "../i18n/config";

const t = getCurrentLanguage(
  Astro.url.pathname
);

const language: Language =
  Astro.url.pathname.startsWith("/km")
    ? "km"
    : "en";

const productsPath =
  getLocalizedPath(language, "/products");
---

<section id="about" class="about">

  <div class="container about-grid">

    <div class="about-image">

      <img
        src="/images/about/about-orchard.jpg"
        alt={t.aboutHome.imageAlt}
        width="700"
        height="500"
        loading="lazy"
        decoding="async"
      />

    </div>

    <div class="about-content">

      <SectionTitle
        tag={t.aboutHome.tag}
        title={t.aboutHome.title}
      />

      <p>
        {t.aboutHome.description}
      </p>

      <ul class="about-list">

        <li>🌿 {t.aboutHome.features.quality}</li>

        <li>🤝 {t.aboutHome.features.farmers}</li>

        <li>🌍 {t.aboutHome.features.export}</li>

        <li>♻️ {t.aboutHome.features.sustainability}</li>

      </ul>

      <a
        href={productsPath}
        class="btn btn-primary"
      >
        {t.aboutHome.cta}
      </a>

    </div>

  </div>

</section>