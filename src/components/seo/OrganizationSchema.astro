---
import { site } from "../../config/site";

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",

  name: site.brand.english,

  alternateName: site.brand.khmer,

  url: site.website.url,

  logo: `${site.website.url}${site.website.logo}`,

  image: `${site.website.url}${site.website.logo}`,

  description: site.website.description,

  email: site.contact.email,

  telephone: site.contact.phone,

  address: {
    "@type": "PostalAddress",

    streetAddress:
      `${site.address.village}, ${site.address.commune}`,

    addressLocality:
      site.address.district,

    addressRegion:
      site.address.province,

    addressCountry: "KH",
  },

  contactPoint: {
    "@type": "ContactPoint",

    contactType: "customer service",

    email: site.contact.email,

    telephone: site.contact.phone,

    availableLanguage: [
      "English",
      "Khmer",
    ],
  },
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(organization)}
/>