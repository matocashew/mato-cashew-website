---
import { SITE } from "../../config/site";

interface Props {
  canonical: string;
  lang?: "en" | "km";
  hasKhmerAlternate?: boolean;
}

const {
  canonical,
  lang = "en",
  hasKhmerAlternate = true,
} = Astro.props;

const siteUrl =
  SITE.website.url.replace(/\/$/, "");

const enUrl =
  lang === "km"
    ? canonical.replace(
        `${siteUrl}/km`,
        siteUrl
      )
    : canonical;

const kmUrl =
  lang === "km"
    ? canonical
    : canonical.replace(
        siteUrl,
        `${siteUrl}/km`
      );
---

<link
  rel="alternate"
  hreflang="en"
  href={enUrl}
/>

{
  hasKhmerAlternate && (
    <link
      rel="alternate"
      hreflang="km"
      href={kmUrl}
    />
  )
}

<link
  rel="alternate"
  hreflang="x-default"
  href={enUrl}
/>