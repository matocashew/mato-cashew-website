---
import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";

const t = getCurrentLanguage(
  Astro.url.pathname
);
---

<section class="contact-info-card">

  <span class="section-tag">
    {t.contact.info.tag}
  </span>

  <h2>
    {t.contact.info.title}
  </h2>

  <p>
    {t.contact.info.description}
  </p>

  <div class="contact-list">

    <div class="contact-item">

      <h4>
        <span class="contact-item-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
            <path d="m5 7 7 5 7-5" />
          </svg>
        </span>
        {t.contact.info.email}
      </h4>

      <p>
        <!--email_off-->
        <a href="mailto:info@matocashew.com">
          info@matocashew.com
        </a>
        <!--/email_off-->
      </p>

    </div>

    <div class="contact-item">

      <h4>
        <span class="contact-item-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M7.2 3.8 10 8.1 8.2 10c1.2 2.5 3.3 4.6 5.8 5.8l1.9-1.8 4.3 2.8c.3.2.4.6.3.9-.5 1.7-2.1 2.8-3.9 2.7C9.4 20 4 14.6 3.6 7.4c-.1-1.8 1-3.4 2.7-3.9.3-.1.7 0 .9.3Z" />
          </svg>
        </span>
        {t.contact.info.phone}
      </h4>

      <p>
        <a href="tel:+85512646988">
          +855 12 646 988
        </a>
      </p>

    </div>

    <div class="contact-item">

      <h4>
        <span class="contact-item-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M19 10c0 5-7 10-7 10S5 15 5 10a7 7 0 1 1 14 0Z" />
            <circle cx="12" cy="10" r="2.3" />
          </svg>
        </span>
        {t.contact.info.location}
      </h4>

      <p>
        {t.contact.info.locationValue}
      </p>

    </div>

  </div>

</section>
