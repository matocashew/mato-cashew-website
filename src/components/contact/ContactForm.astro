---
import FormField from "./FormField.astro";
import FormSelect from "./FormSelect.astro";
import FormTextarea from "./FormTextarea.astro";

import { getCurrentLanguage } from "../../i18n/getCurrentLanguage";

const t = getCurrentLanguage(
  Astro.url.pathname
);

const inquiryOptions = [
  {
    value: "Wholesale Inquiry",
    label: t.contact.options.wholesale,
  },
  {
    value: "Retail Inquiry",
    label: t.contact.options.retail,
  },
  {
    value: "Distribution Inquiry",
    label: t.contact.options.distributor,
  },
  {
    value: "Business Partnership",
    label: t.contact.options.export,
  },
  {
    value: "Packaging / Private Label Inquiry",
    label: t.contact.options.oem,
  },
  {
    value: "General Inquiry",
    label: t.contact.options.general,
  },
];

const volumeOptions = [
  {
    value: "Less than 100 kg",
    label: t.contact.volumeOptions.less100,
  },
  {
    value: "100–500 kg",
    label: t.contact.volumeOptions.kg100500,
  },
  {
    value: "500 kg–1 ton",
    label: t.contact.volumeOptions.kg5001ton,
  },
  {
    value: "More than 1 ton",
    label: t.contact.volumeOptions.more1ton,
  },
];
---

<div
  id="successMessage"
  class="success-message"
  hidden
>
  ✅ {t.contact.messages.success}
</div>

<div
  id="formError"
  class="form-error"
  hidden
>
  ❌ {t.contact.messages.error}
</div>

<form
  id="contact-form"
  class="contact-form"
  novalidate
  data-required-message={t.contact.messages.required}
  data-security-message={t.contact.messages.security}
  data-sending-label={t.contact.messages.sending}
  data-send-label={t.contact.send}
  data-submission-failed={t.contact.messages.submissionFailed}
  data-connection-error={t.contact.messages.connectionError}
>
  <div class="contact-form-intro">
    <span class="contact-form-intro__tag">
      {t.contact.formIntro.tag}
    </span>

    <h2 class="contact-form-intro__title">
      {t.contact.formIntro.title}
    </h2>

    <p class="contact-form-intro__description">
      {t.contact.formIntro.description}
    </p>
  </div>

  <div class="contact-form-fields">

    <div class="contact-form-cell">
      <FormField
        id="name"
        name="name"
        label={t.contact.name}
        placeholder={t.contact.placeholders.name}
        autocomplete="name"
        required
      />
    </div>

    <div class="contact-form-cell">
      <FormField
        id="company"
        name="company"
        label={t.contact.company}
        placeholder={t.contact.placeholders.company}
        autocomplete="organization"
      />
    </div>

    <div class="contact-form-cell">
      <FormField
        id="country"
        name="country"
        label={t.contact.country}
        placeholder={t.contact.placeholders.country}
        required
      />
    </div>

    <div class="contact-form-cell">
      <FormField
        id="email"
        name="email"
        type="email"
        label={t.contact.email}
        placeholder={t.contact.placeholders.email}
        autocomplete="email"
        required
      />
    </div>

    <div class="contact-form-cell">
      <FormField
        id="phone"
        name="phone"
        type="tel"
        label={t.contact.phone}
        placeholder={t.contact.placeholders.phone}
        autocomplete="tel"
      />
    </div>

    <div class="contact-form-cell">
      <FormSelect
        id="inquiry"
        name="inquiry"
        label={t.contact.inquiry}
        placeholder={t.common.selectOption}
        required
        options={inquiryOptions}
      />
    </div>

    <div class="contact-form-cell contact-form-cell--wide">
      <FormSelect
        id="volume"
        name="volume"
        label={t.contact.volume}
        placeholder={t.common.selectVolume}
        options={volumeOptions}
      />
    </div>

    <div class="contact-form-cell contact-form-cell--wide">
      <FormTextarea
        id="message"
        name="message"
        label={t.contact.message}
        placeholder={t.contact.placeholders.message}
        rows={6}
        required
      />
    </div>

  </div>

  <div
    class="cf-turnstile"
    data-sitekey="0x4AAAAAADzApl_-GPhwXu0j"
  ></div>

  <div class="contact-form-actions">

    <button
      id="submitBtn"
      type="submit"
      class="btn btn-primary"
    >
      <span class="contact-submit-label">
        {t.contact.send}
      </span>
    </button>

    <p class="privacy-note">
      {t.contact.privacy}
    </p>

  </div>

</form>

<script type="module">
  import "../../scripts/contact";
</script>
