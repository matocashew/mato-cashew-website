---
interface FAQItem {
  question: string;
  answer: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  questions?: FAQItem[];
}

const { questions = [] } = Astro.props as Props;
---

<section class="faq">
  {
    questions.map((item) => (
      <details class="faq-item">
        <summary>{item.question}</summary>

        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</section>