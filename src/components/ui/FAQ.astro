---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<section class="faq">

  {
    items.map((item) => (

      <details class="faq-item">

        <summary>

          {item.question}

        </summary>

        <div class="faq-answer">

          <p>{item.answer}</p>

        </div>

      </details>

    ))
  }

</section>