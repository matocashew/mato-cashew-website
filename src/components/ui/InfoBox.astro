---
interface Props {

  title: string;

  variant?:
    | "info"
    | "tip"
    | "insight"
    | "warning";

}

const {

  title,

  variant = "info"

} = Astro.props;
---

<div
  class={`info-box ${variant}`}
>

  <h4>{title}</h4>

  <div class="info-box-content">

    <slot />

  </div>

</div>