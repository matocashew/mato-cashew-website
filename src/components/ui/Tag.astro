---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="tag">
  {label}
</span>

<style>
.tag {

  display: inline-flex;

  align-items: center;

  padding: .35rem .75rem;

  border-radius: 999px;

  background: #F3F4F6;

  color: #374151;

  font-size: .875rem;

  font-weight: 500;

  line-height: 1;

  transition:
    background .2s ease,
    color .2s ease,
    transform .2s ease;

}

.tag:hover {

  background: #2E7D32;

  color: white;

  transform: translateY(-2px);

}
</style>