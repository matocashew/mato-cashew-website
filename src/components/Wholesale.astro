---
import SectionTitle from "./SectionTitle.astro";

import { getCurrentLanguage } from "../i18n/getCurrentLanguage";
import { getLocalizedPath } from "../i18n/getLocalizedPath";

import type { Language } from "../i18n/config";

const t = getCurrentLanguage(
  Astro.url.pathname
);

const language: Language =
  Astro.url.pathname.startsWith("/km")
    ? "km"
    : "en";

const contactPath =
  getLocalizedPath(language, "/contact");
---

<section id="wholesale" class="wholesale">

  <div class="container">

    <div class="wholesale-card">

      <div class="wholesale-content">

        <SectionTitle
          tag={t.wholesaleHome.tag}
          title={t.wholesaleHome.title}
        />

        <p class="wholesale-description">
          {t.wholesaleHome.description}
        </p>

        <ul class="wholesale-list">

          <li>
            <span class="wholesale-icon">🌍</span>
            <span>{t.wholesaleHome.features.export}</span>
          </li>

          <li>
            <span class="wholesale-icon">📦</span>
            <span>{t.wholesaleHome.features.packaging}</span>
          </li>

          <li>
            <span class="wholesale-icon">🏆</span>
            <span>{t.wholesaleHome.features.quality}</span>
          </li>

          <li>
            <span class="wholesale-icon">🤝</span>
            <span>{t.wholesaleHome.features.privateLabel}</span>
          </li>

        </ul>

        <a
          href={contactPath}
          class="btn btn-primary wholesale-cta"
        >
          {t.wholesaleHome.cta}
          <span aria-hidden="true">→</span>
        </a>

      </div>

      <div class="wholesale-image">

        <img
          src="/images/wholesale/export.jpg"
          alt={t.wholesaleHome.imageAlt}
          loading="lazy"
          decoding="async"
        />

        <div class="wholesale-image-badge">
          <span>Premium</span>
          <strong>Cambodian Cashew</strong>
        </div>

      </div>

    </div>

  </div>

</section>