---
import OrganizationSchema from "../components/seo/OrganizationSchema.astro";
import WebsiteSchema from "../components/seo/WebsiteSchema.astro";
import WebPageSchema from "../components/seo/WebPageSchema.astro";
import BreadcrumbSchema from "../components/seo/BreadcrumbSchema.astro";
import HreflangLinks from "../components/seo/HreflangLinks.astro";

import { SITE } from "../config/site";

import "../styles/global.css";
import "../styles/header.css";
import "../styles/footer.css";
import "../styles/section-title.css";
import "../styles/featured-resources.css";
import "../styles/product-specifications.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;

  lang?: "en" | "km";

  ogImage?: string;
  ogType?: "website" | "article" | "product";

  breadcrumbs?: {
    name: string;
    url: string;
  }[];
}

const siteUrl = SITE.website.url;

const {
  title = `${SITE.brand.english} | ${SITE.website.tagline}`,
  description = SITE.website.description,

  canonical = siteUrl,

  robots = "index,follow",

  lang = "en",

  ogImage = `${siteUrl}/images/seo/og-image.jpg`,

  ogType = "website",

  breadcrumbs = [],
} = Astro.props;

const localizedBrand =
  lang === "km"
    ? SITE.brand.khmer
    : SITE.brand.english;

const localizedOgImageAlt =
  lang === "km"
    ? `${SITE.brand.khmer} - ផលិតផលគ្រាប់ស្វាយចន្ទីកម្ពុជា`
    : `${SITE.brand.english} - Cambodian Cashew Products`;

const localizedKeywords =
  lang === "km"
    ? "គ្រាប់ស្វាយចន្ទីកម្ពុជា, ផលិតផលគ្រាប់ស្វាយចន្ទី, លក់រាយគ្រាប់ស្វាយចន្ទី, លក់ដុំគ្រាប់ស្វាយចន្ទី, ចន្ទីមាតុភូមិ, Mato Cashew"
    : "Cambodian Cashew, Cashew Kernels, Cashew Products, Retail Cashew, Wholesale Cashew, Mato Cashew";
---

<!DOCTYPE html>

<html lang={lang}>

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content={robots}
  />

  <meta
    name="author"
    content={localizedBrand}
  />

  <meta
    name="keywords"
    content={localizedKeywords}
  />

  <!-- Canonical -->

  <link
    rel="canonical"
    href={canonical}
  />

  <!-- Hreflang -->

  <HreflangLinks
    canonical={canonical}
    lang={lang}
  />

  <!-- Fonts -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Noto+Sans+Khmer:wght@100..900&display=swap"
  />

  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Noto+Sans+Khmer:wght@100..900&display=swap"
  />

  <!-- Icons -->

  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href="/favicon-32x32.png"
  />

  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href="/favicon-16x16.png"
  />

  <link
    rel="shortcut icon"
    href="/favicon.ico"
  />

  <link
    rel="apple-touch-icon"
    href="/apple-touch-icon.png"
  />

  <link
    rel="manifest"
    href="/site.webmanifest"
  />

  <meta
    name="theme-color"
    content="#0D5C3A"
  />

  <!-- Open Graph -->

  <meta
    property="og:type"
    content={ogType}
  />

  <meta
    property="og:site_name"
    content={localizedBrand}
  />

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:url"
    content={canonical}
  />

  <meta
    property="og:image"
    content={ogImage}
  />

  <meta
    property="og:image:width"
    content="1200"
  />

  <meta
    property="og:image:height"
    content="630"
  />

  <meta
    property="og:image:alt"
    content={localizedOgImageAlt}
  />

  <meta
    property="og:locale"
    content={
      lang === "km"
        ? "km_KH"
        : "en_US"
    }
  />

  <!-- Twitter -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  <meta
    name="twitter:image"
    content={ogImage}
  />

  <!-- Structured Data -->

  <OrganizationSchema />

  <WebsiteSchema />

  <WebPageSchema
    title={title}
    description={description}
    canonical={canonical}
    lang={lang}
  />

  {
    breadcrumbs.length > 0 && (
      <BreadcrumbSchema
        items={breadcrumbs}
      />
    )
  }

  <!-- Google Analytics -->

  <script
    async
    src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.googleAnalytics}`}
  ></script>

  <script
    define:vars={{
      gaId: SITE.analytics.googleAnalytics
    }}
  >
    window.dataLayer =
      window.dataLayer || [];

    function gtag() {
      dataLayer.push(arguments);
    }

    gtag(
      "js",
      new Date()
    );

    gtag(
      "config",
      gaId
    );
  </script>

</head>

<body>

  <slot />

</body>

</html>