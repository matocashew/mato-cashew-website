---
import { ClientRouter } from "astro:transitions";

import WeatherAtmosphere from "../components/weather/WeatherAtmosphere.astro";

import OrganizationSchema from "../components/seo/OrganizationSchema.astro";
import WebsiteSchema from "../components/seo/WebsiteSchema.astro";
import WebPageSchema from "../components/seo/WebPageSchema.astro";
import BreadcrumbSchema from "../components/seo/BreadcrumbSchema.astro";
import HreflangLinks from "../components/seo/HreflangLinks.astro";

import { SITE } from "../config/site";

import "../styles/global.css";
import "../styles/weather-atmosphere.css";

/*
 * R50
 * Global Scenic Hero design-system owner.
 *
 * Home / About / Products must receive the same
 * Scenic Hero contract on:
 * - initial page load
 * - Ctrl + F5
 * - Astro ClientRouter navigation
 */
import "../styles/scenic-hero-system.css";
import "../styles/header.css";
import "../styles/footer.css";
import "../styles/section-title.css";
import "../styles/featured-resources.css";
import "../styles/product-specifications.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;

  lang?: "en" | "km";

  ogImage?: string;
  ogType?: "website" | "article" | "product";

  breadcrumbs?: {
    name: string;
    url: string;
  }[];

  hasKhmerAlternate?: boolean;
  englishAlternateUrl?: string;
  khmerAlternateUrl?: string;
}

const siteUrl = SITE.website.url;

const {
  title = `${SITE.brand.english} | ${SITE.website.tagline}`,
  description = SITE.website.description,

  canonical = siteUrl,

  robots = "index,follow",

  lang = "en",

  ogImage = `${siteUrl}/images/seo/og-image.jpg`,

  ogType = "website",

  breadcrumbs = [],

  hasKhmerAlternate = true,
  englishAlternateUrl,
  khmerAlternateUrl,
} = Astro.props;

const localizedBrand =
  lang === "km"
    ? SITE.brand.khmer
    : SITE.brand.english;

const localizedOgImageAlt =
  lang === "km"
    ? `${SITE.brand.khmer} - ផលិតផលគ្រាប់ស្វាយចន្ទីកម្ពុជា`
    : `${SITE.brand.english} - Cambodian Cashew Products`;

const localizedKeywords =
  lang === "km"
    ? "គ្រាប់ស្វាយចន្ទីកម្ពុជា, ផលិតផលគ្រាប់ស្វាយចន្ទី, លក់រាយគ្រាប់ស្វាយចន្ទី, លក់ដុំគ្រាប់ស្វាយចន្ទី, ចន្ទីមាតុភូមិ, Mato Cashew"
    : "Cambodian Cashew, Cashew Kernels, Cashew Products, Retail Cashew, Wholesale Cashew, Mato Cashew";

---

<!DOCTYPE html>

<html lang={lang}>

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content={robots}
  />

  <meta
    name="author"
    content={localizedBrand}
  />

  <meta
    name="keywords"
    content={localizedKeywords}
  />

  <!-- Canonical -->

  <link
    rel="canonical"
    href={canonical}
  />

  <!-- Hreflang -->

  <HreflangLinks
    canonical={canonical}
    lang={lang}
    hasKhmerAlternate={hasKhmerAlternate}
    englishAlternateUrl={englishAlternateUrl}
    khmerAlternateUrl={khmerAlternateUrl}
  />

  <!-- Fonts -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Noto+Sans+Khmer:wght@100..900&display=swap"
  />

  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Noto+Sans+Khmer:wght@100..900&display=swap"
  />

  <!-- Icons -->

  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href="/favicon-32x32.png"
  />

  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href="/favicon-16x16.png"
  />

  <link
    rel="shortcut icon"
    href="/favicon.ico"
  />

  <link
    rel="apple-touch-icon"
    href="/apple-touch-icon.png"
  />

  <link
    rel="manifest"
    href="/site.webmanifest"
  />

  <meta
    name="theme-color"
    content="#0D5C3A"
  />

  <!-- Open Graph -->

  <meta
    property="og:type"
    content={ogType}
  />

  <meta
    property="og:site_name"
    content={localizedBrand}
  />

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:url"
    content={canonical}
  />

  <meta
    property="og:image"
    content={ogImage}
  />

  <meta
    property="og:image:width"
    content="1200"
  />

  <meta
    property="og:image:height"
    content="630"
  />

  <meta
    property="og:image:alt"
    content={localizedOgImageAlt}
  />

  <meta
    property="og:locale"
    content={
      lang === "km"
        ? "km_KH"
        : "en_US"
    }
  />

  <!-- Twitter -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  <meta
    name="twitter:image"
    content={ogImage}
  />

  <!-- Structured Data -->

  <OrganizationSchema />

  <WebsiteSchema />

  <WebPageSchema
    title={title}
    description={description}
    canonical={canonical}
    lang={lang}
  />

  {
    breadcrumbs.length > 0 && (
      <BreadcrumbSchema
        items={breadcrumbs}
      />
    )
  }

  <!-- Google Analytics -->

  <script
    is:inline
    async
    src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.googleAnalytics}`}
  ></script>

  <script
    is:inline
    define:vars={{
      gaId: SITE.analytics.googleAnalytics
    }}
  >
    window.dataLayer =
      window.dataLayer || [];

    function gtag() {
      dataLayer.push(arguments);
    }

    gtag(
      "js",
      new Date()
    );

    gtag(
      "config",
      gaId
    );
  </script>

    <!-- Astro Client-side Navigation -->
    <ClientRouter />


  <!-- =====================================================
       A48-R22 - CLIENTROUTER WEATHER OWNERSHIP

       Permanent global geometry authority for the
       decorative WeatherAtmosphere layer.

       Client-side navigation must not collapse the
       atmosphere element back into normal document flow.

       No Home Hero / Trust / Scenic geometry changes.
       ===================================================== -->

  <style is:global>
    .weather-atmosphere {
      position: fixed;
      inset: 0;

      width: 100vw;
      height: 100vh;

      z-index: 0;

      overflow: hidden;
      pointer-events: none;

      opacity: 1;
      isolation: isolate;
    }
  </style>
</head>

<body>

  <WeatherAtmosphere />

  <slot />

  <!-- R71F6Q3K - Global visitor weather client controller -->
  <script>
    import "../scripts/global-weather";
  </script>
</body>

</html>

